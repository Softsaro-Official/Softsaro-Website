.tm-page{--bg:#F5F4EF;--ch:#111310;--fg:#123D2A;--lm:#B7F34A;--mu:#85877F;--e:cubic-bezier(.16,1,.3,1);position:relative;background:var(--bg);color:var(--ch);overflow-x:clip;font-family:Inter,sans-serif}
.tm-page *,.tm-ov *{box-sizing:border-box}
.tm-page h1,.tm-page h2,.tm-page p,.tm-page ul,.tm-ov h3,.tm-ov p{margin:0}
.tm-page ul{padding:0;list-style:none}
.tm-page button,.tm-ov button{font-family:inherit}
.tm-in{max-width:1440px;margin:0 auto;padding:0 clamp(20px,6vw,100px)}
.tm-eyebrow{display:inline-flex;align-items:center;gap:12px;font:600 12px/1 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase}
.tm-eyebrow:before{content:"";width:36px;height:1px;background:currentColor}
.tm-eyebrow.lt{color:var(--lm)}
.tm-h2{margin-top:16px!important;font:700 clamp(30px,4.2vw,64px)/1.02 'Inter Tight',Inter,sans-serif;letter-spacing:-.045em;max-width:16ch}
.tm-h2.dk{color:var(--ch)}
.tm-pic{position:absolute;inset:0;display:block;overflow:hidden;container-type:inline-size;background:linear-gradient(160deg,var(--a),var(--b))}
.tm-t-violet{--a:#2f7a55;--b:#123D2A;--f:#fff}
.tm-t-ink{--a:#3a3d38;--b:#111310;--f:#fff}
.tm-t-lime{--a:#d4f98d;--b:#9bd62a;--f:#111310}
.tm-t-coral{--a:#e6e3d6;--b:#b3b09f;--f:#111310}
.tm-img{object-fit:cover;object-position:50% 18%;transition:transform 1.3s var(--e)}
.tm-ini{position:absolute;inset:0;display:grid;place-items:center;font:700 40cqw/1 'Inter Tight',Inter,sans-serif;letter-spacing:-.06em;color:var(--f)}
.tm-orb{position:absolute;right:-10%;top:-8%;width:40%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.16)}

/* hero */
.tm-hero{position:relative;padding:clamp(120px,15vh,180px) 0 clamp(70px,8vw,120px);overflow:hidden}
.tm-ghost{position:absolute;left:0;right:0;top:8%;text-align:center;font:800 clamp(140px,28vw,440px)/.8 'Inter Tight',Inter,sans-serif;letter-spacing:-.06em;color:transparent;-webkit-text-stroke:1px rgba(17,19,16,.08);pointer-events:none;user-select:none;white-space:nowrap}
.tm-glow{position:absolute;border-radius:50%;pointer-events:none}
.tm-glow.a{width:560px;height:560px;left:-160px;bottom:-200px;background:radial-gradient(circle,rgba(183,243,74,.38),transparent 65%)}
.tm-glow.b{width:520px;height:520px;right:-120px;top:-160px;background:radial-gradient(circle,rgba(18,61,42,.22),transparent 65%)}
.tm-hero-g{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(28px,4vw,64px);align-items:center}
.tm-hero-c .tm-eyebrow{color:var(--fg)}
.tm-h1{margin-top:22px!important;font:700 clamp(40px,6.4vw,100px)/.98 'Inter Tight',Inter,sans-serif;letter-spacing:-.05em}
.tm-ln{display:block;overflow:hidden;padding:.04em 0 .14em;margin-bottom:-.1em}
.tm-ln>span{display:inline-block}
.tm-em{font-style:italic;color:var(--fg);background:linear-gradient(transparent 64%,var(--lm) 64% 90%,transparent 90%);padding:0 .06em}
.tm-hp{margin-top:26px!important;max-width:50ch;color:#4d4f48;font:400 clamp(16px,1.3vw,19px)/1.7 Inter,sans-serif}
.tm-hb{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
.tm-btn{display:inline-flex;align-items:center;height:52px;padding:0 26px;border-radius:99px;border:1px solid var(--ch);font:600 15px/1 'Inter Tight',Inter,sans-serif;text-decoration:none;transition:background .3s,color .3s,transform .4s var(--e)}
.tm-btn.p{background:var(--fg);border-color:var(--fg);color:#fff}
.tm-btn.p:hover{background:var(--lm);border-color:var(--lm);color:var(--ch);transform:translateY(-2px)}
.tm-btn.o{background:transparent;color:var(--ch)}
.tm-btn.o:hover{background:var(--ch);color:#fff;transform:translateY(-2px)}
.tm-col{position:relative;width:100%;max-width:600px;aspect-ratio:1/1.04;margin-left:auto}
.tm-tile{position:absolute}
.tm-fl{position:absolute;inset:0;overflow:hidden;box-shadow:0 36px 70px -26px rgba(17,19,16,.45);animation:tmFloat 7s ease-in-out infinite}
.tm-fl:hover .tm-img{transform:scale(1.07)}
.tm-fl.d1{animation-delay:-1.6s}.tm-fl.d2{animation-delay:-3.1s}.tm-fl.d3{animation-delay:-4.4s}.tm-fl.d4{animation-delay:-5.6s}
@keyframes tmFloat{50%{transform:translateY(-10px)}}
.tm-tile.s0{left:22%;top:0;width:42%;aspect-ratio:4/5.2}.tm-tile.s0 .tm-fl{border-radius:50% 50% 6% 6%/34% 34% 5% 5%}
.tm-tile.s1{right:0;top:7%;width:29%;aspect-ratio:1}.tm-tile.s1 .tm-fl{border-radius:50%}
.tm-tile.s2{left:0;top:38%;width:34%;aspect-ratio:1}.tm-tile.s2 .tm-fl{border-radius:46%/30%}
.tm-tile.s3{right:4%;top:42%;width:37%;aspect-ratio:1/1.1}.tm-tile.s3 .tm-fl{border-radius:50% 6% 50% 6%}
.tm-tile.s4{left:34%;bottom:0;width:27%;aspect-ratio:1}.tm-tile.s4 .tm-fl{border-radius:62% 38% 54% 46%/48% 58% 42% 52%}
.tm-badge{position:absolute;left:47%;top:44%;display:grid;place-items:center;align-content:center;width:clamp(86px,9vw,118px);aspect-ratio:1;border-radius:50%;background:var(--lm);color:var(--ch);box-shadow:0 18px 40px rgba(17,19,16,.25)}
.tm-badge b{font:800 clamp(28px,3vw,42px)/1 'Inter Tight',Inter,sans-serif;letter-spacing:-.04em}
.tm-badge small{font:700 10px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase}

/* marquee */
.tm-marq{overflow:hidden;background:var(--lm);color:var(--ch);padding:20px 0;border-block:1px solid var(--ch)}
.tm-marq-t{display:flex;width:max-content;animation:tmMarq 60s linear infinite}
.tm-marq:hover .tm-marq-t{animation-play-state:paused}
.tm-marq-g{display:flex;flex:none}
.tm-marq-g span{display:flex;align-items:center;gap:30px;padding-right:30px;white-space:nowrap;font:700 clamp(22px,3vw,40px)/1 'Inter Tight',Inter,sans-serif;letter-spacing:-.035em}
.tm-marq-g i{width:12px;height:12px;background:var(--fg);transform:rotate(45deg)}
@keyframes tmMarq{to{transform:translateX(-50%)}}

/* leadership */
.tm-lead{position:relative;background:radial-gradient(60% 45% at 8% 0%,rgba(18,61,42,.95),transparent 70%),radial-gradient(40% 35% at 100% 100%,rgba(183,243,74,.12),transparent 70%),var(--ch);color:#fff;padding:clamp(80px,10vw,150px) 0}
.tm-lh{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:clamp(40px,6vw,90px)}
.tm-lh>p{max-width:30ch;color:#b8bab2;font:400 16px/1.65 Inter,sans-serif}
.tm-lg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(48px,6vw,90px) clamp(28px,6vw,100px);max-width:1080px;margin:0 auto}
.tm-l{position:relative;display:block;padding:0;border:0;background:none;color:inherit;text-align:left;cursor:pointer}
.tm-l.l1{margin-top:clamp(40px,9vw,140px)}
.tm-l.l2{margin-top:calc(-1 * clamp(0px,5vw,80px))}
.tm-lf{position:relative;display:block;overflow:hidden;background:#1b1e1a;box-shadow:0 40px 80px -30px rgba(0,0,0,.7)}
.tm-lf.f0{aspect-ratio:4/5;border-radius:50% 50% 6% 6%/34% 34% 5% 5%}
.tm-lf.f1{aspect-ratio:1;border-radius:50%}
.tm-lf.f2{aspect-ratio:4/5;border-radius:46%/30%}
.tm-lf.f3{aspect-ratio:1/1.08;border-radius:50% 6% 50% 6%}
.tm-l:hover .tm-img,.tm-l:focus-visible .tm-img{transform:scale(1.07)}
.tm-gh{position:absolute;left:-4%;top:-8%;font:800 clamp(90px,14vw,210px)/.8 'Inter Tight',Inter,sans-serif;letter-spacing:-.06em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.14);pointer-events:none;transition:transform .8s var(--e),-webkit-text-stroke-color .5s;z-index:2}
.tm-l:hover .tm-gh{transform:translate(10px,-8px);-webkit-text-stroke-color:rgba(183,243,74,.55)}
.tm-lm{display:block;margin-top:22px}
.tm-lm b{display:block;font:700 clamp(24px,2.6vw,38px)/1.05 'Inter Tight',Inter,sans-serif;letter-spacing:-.035em}
.tm-lm small{display:flex;align-items:center;gap:10px;margin-top:10px;color:#b8bab2;font:500 14px/1.3 Inter,sans-serif}
.tm-lm small:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--lm)}
.tm-open{position:absolute;right:14px;top:14px;z-index:3;padding:10px 16px;border-radius:99px;background:var(--lm);color:var(--ch);font:700 12px/1 Inter,sans-serif;opacity:0;transform:translateY(-8px);transition:opacity .4s,transform .5s var(--e)}
.tm-l:hover .tm-open,.tm-l:focus-visible .tm-open{opacity:1;transform:none}

/* wider team */
.tm-wide{background:#ECEBE3;padding:clamp(80px,10vw,150px) 0}
.tm-wg{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:clamp(32px,6vw,96px);align-items:start}
.tm-wl{position:sticky;top:110px}
.tm-wl .tm-eyebrow{color:var(--fg)}
.tm-wp{margin-top:18px!important;max-width:34ch;color:#4d4f48;font:400 16px/1.65 Inter,sans-serif}
.tm-pv{position:relative;width:min(100%,290px);aspect-ratio:4/4.3;margin-top:30px}
.tm-pvc{position:absolute;inset:0;overflow:hidden;border-radius:50% 50% 8% 8%/30% 30% 5% 5%;box-shadow:0 36px 60px -26px rgba(17,19,16,.5);background:var(--fg)}
.tm-pvm{position:absolute;left:12px;right:12px;bottom:12px;z-index:3;display:grid;gap:2px;padding:10px 14px;border-radius:16px;background:rgba(17,19,16,.82);backdrop-filter:blur(8px);color:#fff}
.tm-pvm b{font:700 14px/1.2 'Inter Tight',Inter,sans-serif}
.tm-pvm small{color:var(--lm);font:500 11.5px/1.3 Inter,sans-serif}
.tm-rows{border-top:1px solid var(--ch)}
.tm-row{display:grid;grid-template-columns:34px 52px minmax(0,1fr) minmax(0,.9fr);gap:16px;align-items:center;width:100%;padding:14px 10px;border:0;border-bottom:1px solid rgba(17,19,16,.16);background:none;color:inherit;text-align:left;font:inherit;cursor:pointer;transition:background .35s,color .35s,padding .45s var(--e)}
.tm-rn{color:var(--mu);font:600 12px/1 Inter,sans-serif}
.tm-th{position:relative;width:52px;height:52px;border-radius:50%;overflow:hidden}
.tm-rname{font:700 clamp(18px,1.9vw,28px)/1.1 'Inter Tight',Inter,sans-serif;letter-spacing:-.035em}
.tm-rrole{color:#5d5f58;font:500 13px/1.4 Inter,sans-serif;transition:color .35s}
.tm-row.on{background:var(--ch);color:#fff;padding-left:22px}
.tm-row.on .tm-rrole{color:var(--lm)}
.tm-row.on .tm-rn{color:var(--lm)}
.tm-row:focus-visible{outline:2px solid var(--fg);outline-offset:-2px}
.tm-rx{overflow:hidden;background:#f6f5ef}
.tm-rxi{display:flex;gap:16px;align-items:center;padding:16px 10px}
.tm-rxp{position:relative;flex:none;width:104px;aspect-ratio:4/5;border-radius:50% 50% 8% 8%/34% 34% 5% 5%;overflow:hidden}
.tm-rxi b{font:700 18px/1.2 'Inter Tight',Inter,sans-serif}
.tm-rxi p{margin-top:4px;color:#5d5f58;font:500 13px/1.4 Inter,sans-serif}
.tm-rxb{margin-top:12px;padding:10px 16px;border:0;border-radius:99px;background:var(--fg);color:#fff;font:600 13px/1 Inter,sans-serif;cursor:pointer}

/* stats */
.tm-stats{background:var(--bg);padding:clamp(60px,8vw,110px) 0}
.tm-sg{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--ch)}
.tm-sg li{padding:26px 20px 10px 0;border-right:1px solid rgba(17,19,16,.14)}
.tm-sg li+li{padding-left:24px}
.tm-sg li:last-child{border-right:0}
.tm-sg b{display:block;color:var(--fg);font:800 clamp(56px,9vw,140px)/.9 'Inter Tight',Inter,sans-serif;letter-spacing:-.06em}
.tm-sg span{display:block;margin-top:12px;color:#5d5f58;font:600 13px/1.3 Inter,sans-serif;letter-spacing:.06em;text-transform:uppercase}

/* cta */
.tm-cta{position:relative;overflow:hidden;background:var(--fg);color:#fff;padding:clamp(90px,11vw,170px) 0 clamp(120px,14vw,200px)}
.tm-g1,.tm-g2{position:absolute;border-radius:50%;pointer-events:none}
.tm-g1{width:60vw;height:60vw;left:-15vw;top:-25vw;background:radial-gradient(circle,rgba(183,243,74,.28),transparent 65%)}
.tm-g2{width:50vw;height:50vw;right:-12vw;bottom:-22vw;background:radial-gradient(circle,rgba(183,243,74,.18),transparent 65%)}
.tm-cta-in{position:relative;display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap}
.tm-cta-h{margin-top:18px!important;font:700 clamp(40px,7.2vw,116px)/.96 'Inter Tight',Inter,sans-serif;letter-spacing:-.05em;max-width:12ch}
.tm-cta-h em{font-style:italic;color:var(--lm)}
.tm-cta-b{display:grid;place-items:center;align-content:center;gap:8px;width:clamp(130px,13vw,180px);aspect-ratio:1;border-radius:50%;background:var(--lm);color:var(--ch);text-decoration:none;font:700 16px/1 'Inter Tight',Inter,sans-serif;transition:transform .5s var(--e),background .3s,color .3s}
.tm-cta-b svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .5s var(--e)}
.tm-cta-b:hover{transform:scale(1.08) rotate(-4deg);background:#fff}
.tm-cta-b:hover svg{transform:translate(4px,-4px)}
.tm-cta-ghost{position:absolute;left:0;bottom:-.1em;white-space:nowrap;font:800 clamp(70px,13vw,200px)/1 'Inter Tight',Inter,sans-serif;letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1px rgba(183,243,74,.22);pointer-events:none}

/* overlay (rendered in body) */
.tm-ov{position:fixed;inset:0;z-index:9999;background:rgba(10,12,10,.82);backdrop-filter:blur(8px);font-family:Inter,sans-serif}
.tm-ovc{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);height:100%;background:#111310;color:#fff}
.tm-ovp{position:relative;background:#123D2A}
.tm-ovt{display:flex;flex-direction:column;justify-content:center;gap:20px;padding:clamp(28px,6vw,96px)}
.tm-ovt h3{font:700 clamp(38px,5.4vw,88px)/.98 'Inter Tight',Inter,sans-serif;letter-spacing:-.05em}
.tm-ov .tm-eyebrow{display:inline-flex;align-items:center;gap:12px;font:600 12px/1 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#B7F34A}
.tm-ov .tm-eyebrow:before{content:"";width:36px;height:1px;background:currentColor}
.tm-chips{display:flex;flex-wrap:wrap;gap:8px}
.tm-chips span{padding:10px 16px;border-radius:99px;border:1px solid rgba(255,255,255,.28);font:600 14px/1 Inter,sans-serif}
.tm-chips span:first-child{background:#B7F34A;border-color:#B7F34A;color:#111310}
.tm-ovlink{display:inline-flex;align-items:center;height:50px;padding:0 26px;border-radius:99px;background:#fff;color:#111310;font:600 15px/1 'Inter Tight',Inter,sans-serif;text-decoration:none;transition:background .3s}
.tm-ovlink:hover{background:#B7F34A}
.tm-x{position:absolute;top:20px;right:20px;z-index:5;width:52px;height:52px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:rgba(17,19,16,.6);color:#fff;font-size:28px;line-height:1;cursor:pointer;transition:background .3s,color .3s}
.tm-x:hover{background:#B7F34A;color:#111310}

@media(max-width:1000px){.tm-row{grid-template-columns:30px 48px minmax(0,1fr)}.tm-rrole{grid-column:3}}
@media(max-width:900px){
  .tm-hero-g,.tm-wg,.tm-ovc{grid-template-columns:minmax(0,1fr)}
  .tm-col{margin:20px auto 0;max-width:460px}
  .tm-lh{flex-direction:column;align-items:flex-start}
  .tm-wl{position:static}
  .tm-pv{display:none}
  .tm-ovc{grid-template-rows:44% 1fr;overflow-y:auto}
  .tm-sg{grid-template-columns:repeat(2,minmax(0,1fr))}
  .tm-sg li:nth-child(2){border-right:0}
  .tm-sg li:nth-child(n+3){border-top:1px solid rgba(17,19,16,.14)}
  .tm-sg li:nth-child(3){padding-left:0}
}
@media(max-width:640px){
  .tm-lg{grid-template-columns:minmax(0,1fr)}
  .tm-l.l1,.tm-l.l2{margin-top:0}
  .tm-hb .tm-btn{flex:1;justify-content:center}
}
@media(prefers-reduced-motion:reduce){
  .tm-marq-t,.tm-fl{animation:none}
  .tm-img,.tm-row,.tm-open,.tm-gh{transition:none}
}