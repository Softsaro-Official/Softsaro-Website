"use client";
import { useEffect, useMemo, useRef, useState } from "react";
import { useGSAP } from "@gsap/react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import Lenis from "lenis";
import { motion } from "framer-motion";
import { CATS, CAT_LABEL, FEATURED, PROJECTS, type Cat, type Project } from "./data";

gsap.registerPlugin(ScrollTrigger, useGSAP);
const reducedMotion = () => typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
const PAGE = 12;

function Arrow() { return <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>; }

function Cover({ name, cat, src, className = "", blur = false }: { name: string; cat: Cat; src?: string; className?: string; blur?: boolean }) {
  const [bad, setBad] = useState(false);
  if (src && !bad) return <>{blur && <span className="pf-bgblur" aria-hidden="true" style={{ backgroundImage: `url("${src}")` }} />}<img className={`pf-img ${className}`} src={src} alt={`${name} project`} loading="lazy" decoding="async" onError={() => setBad(true)} /></>;
  const initials = name.split(/\s+/).map((w) => w[0]).join("").slice(0, 2).toUpperCase();
  return (
    <div className={`pf-cover c-${cat} ${className}`} role="img" aria-label={`${name} project cover`}>
      <b>{initials}</b><span>{name}</span><i>{CAT_LABEL[cat]}</i>
    </div>
  );
}

function splitWords(el: HTMLElement): HTMLElement[] {
  const html = el.innerHTML; // keeps the accent <em>
  const out: HTMLElement[] = [];
  const walk = (n: Node) => Array.from(n.childNodes).forEach((c) => {
    if (c.nodeType === 3) {
      const f = document.createDocumentFragment();
      (c.textContent ?? "").split(/(\s+)/).forEach((w) => {
        if (!w.trim()) { f.append(w); return; }
        const wrap = document.createElement("span"); wrap.className = "pf-w";
        const i = document.createElement("span"); i.className = "pf-i"; i.textContent = w; wrap.append(i); f.append(wrap); out.push(i);
      });
      c.replaceWith(f);
    } else if (c.nodeType === 1) walk(c);
  });
  walk(el);
  el.setAttribute("aria-label", el.textContent ?? html);
  return out;
}

export default function PortfolioClient({ images }: { images: Record<string, string> }) {
  const root = useRef<HTMLDivElement>(null);
  const grid = useRef<HTMLDivElement>(null);
  const bar = useRef<HTMLDivElement>(null);
  const ind = useRef<HTMLSpanElement>(null);
  const prev = useRef(PAGE);
  const [cat, setCat] = useState<"all" | Cat>("all");
  const [shown, setShown] = useState<"all" | Cat>("all");
  const [limit, setLimit] = useState(PAGE);
  const list = useMemo(() => PROJECTS.filter((p) => shown === "all" || p.cat === shown), [shown]);
  const visible = list.slice(0, limit);
  const counts = useMemo(() => { const c: Record<string, number> = { all: PROJECTS.length }; PROJECTS.forEach((p) => { c[p.cat] = (c[p.cat] ?? 0) + 1; }); return c; }, []);

  /* filter: cards leave, content swaps, new cards enter */
  const pick = (c: "all" | Cat) => {
    if (c === cat) return;
    setCat(c);
    const cards = grid.current?.querySelectorAll(".pf-card");
    if (reducedMotion() || !cards?.length) { setShown(c); setLimit(PAGE); return; }
    gsap.to(cards, { autoAlpha: 0, y: -14, scale: 0.97, duration: 0.28, stagger: { amount: 0.25 }, ease: "power2.in", overwrite: true, onComplete: () => { setShown(c); setLimit(PAGE); } });
  };
  const firstShow = useRef(true);
  useEffect(() => {
    prev.current = PAGE;
    const cards = Array.from(grid.current?.querySelectorAll<HTMLElement>(".pf-card") ?? []);
    if (!cards.length || reducedMotion()) { gsap.set(cards, { clearProps: "all" }); return; }
    const covers = (els: HTMLElement[]) => els.flatMap((c) => Array.from(c.querySelectorAll<HTMLElement>(".pf-img, .pf-cover")));
    if (firstShow.current) {
      /* first paint: reveal cards as the grid scrolls into view instead of while it is still off-screen */
      firstShow.current = false;
      gsap.set(cards, { autoAlpha: 0, y: 44 });
      gsap.set(covers(cards), { clipPath: "inset(100% 0% 0% 0%)", scale: 1.22 });
      const triggers = ScrollTrigger.batch(cards, {
        start: "top 92%", end: "max", once: true, interval: 0.1, batchMax: 4,
        onEnter: (batch) => {
          const els = batch as HTMLElement[];
          gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.9, ease: "expo.out", stagger: 0.08, clearProps: "transform" });
          gsap.to(covers(els), { clipPath: "inset(0% 0% 0% 0%)", scale: 1, duration: 1.3, ease: "expo.out", stagger: 0.08, clearProps: "transform,clipPath" });
        },
      });
      return () => { triggers.forEach((t) => t.kill()); };
    }
    const t = gsap.fromTo(cards, { autoAlpha: 0, y: 40, scale: 0.96 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.8, ease: "expo.out", stagger: { amount: 0.5 }, clearProps: "transform" });
    const im = gsap.fromTo(covers(cards), { clipPath: "inset(100% 0% 0% 0%)", scale: 1.22 }, { clipPath: "inset(0% 0% 0% 0%)", scale: 1, duration: 1.3, ease: "expo.out", stagger: { amount: 0.6 }, delay: 0.1, clearProps: "transform,clipPath" });
    return () => { t.kill(); im.kill(); };
  }, [shown]);
  useEffect(() => {
    if (limit <= prev.current) return;
    const cards = Array.from(grid.current?.querySelectorAll(".pf-card") ?? []).slice(prev.current);
    prev.current = limit;
    if (!cards.length) return;
    if (reducedMotion()) { gsap.set(cards, { clearProps: "all" }); return; }
    gsap.fromTo(cards, { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.8, ease: "expo.out", stagger: 0.06, clearProps: "transform" });
    const ims = cards.flatMap((c) => Array.from(c.querySelectorAll(".pf-img, .pf-cover")));
    gsap.fromTo(ims, { clipPath: "inset(100% 0% 0% 0%)", scale: 1.22 }, { clipPath: "inset(0% 0% 0% 0%)", scale: 1, duration: 1.2, ease: "expo.out", stagger: 0.06, clearProps: "transform,clipPath" });
  }, [limit]);

  /* sliding indicator behind the active filter */
  useEffect(() => {
    const place = (animate: boolean) => {
      const b = bar.current?.querySelector<HTMLElement>(`[data-k="${cat}"]`);
      if (!b || !ind.current) return;
      const vars = { x: b.offsetLeft, y: b.offsetTop, width: b.offsetWidth, height: b.offsetHeight };
      if (animate && !reducedMotion()) gsap.to(ind.current, { ...vars, duration: 0.6, ease: "expo.out" }); else gsap.set(ind.current, vars);
    };
    place(true);
    const ro = new ResizeObserver(() => place(false));
    if (bar.current) ro.observe(bar.current);
    return () => ro.disconnect();
  }, [cat]);

  /* hero, featured, scroll reveals, floating shapes, magnetic buttons */
  useGSAP(() => {
    const scope = root.current;
    if (!scope || reducedMotion()) return;
    const q = (s: string) => gsap.utils.toArray<HTMLElement>(s, scope);
    const one = (s: string) => scope.querySelector<HTMLElement>(s);
    const mm = gsap.matchMedia();
    mm.add({ fine: "(hover: hover) and (pointer: fine)" }, (ctx) => {
      const fine = (ctx.conditions as unknown as { fine: boolean }).fine;
      const offs: Array<() => void> = [];
      const on = (t: EventTarget, e: string, f: (ev: any) => void) => { t.addEventListener(e, f); offs.push(() => t.removeEventListener(e, f)); };
      const lenis = new Lenis({ duration: 1.15, anchors: true });
      lenis.on("scroll", ScrollTrigger.update);
      const tick = (t: number) => lenis.raf(t * 1000);
      gsap.ticker.add(tick); gsap.ticker.lagSmoothing(0);

      /* hero: blur-to-focus word rise */
      const h1 = one(".pf-h1");
      const words = h1 ? splitWords(h1) : [];
      gsap.fromTo(scope, { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.6, ease: "power2.out" });
      gsap.timeline({ defaults: { ease: "expo.out" }, delay: 0.1 })
        .from(one(".pf-pill"), { y: 20, autoAlpha: 0, duration: 0.8 })
        .from(words, { yPercent: 115, rotate: 4, filter: "blur(10px)", duration: 1.3, stagger: 0.07 }, 0.15)
        .from(q(".pf-sub, .pf-stats > *"), { y: 26, autoAlpha: 0, duration: 1, stagger: 0.1 }, 0.9);
      const floats = q(".pf-shape").map((s, i) => gsap.to(s, { y: i % 2 ? 40 : -40, x: i % 2 ? -30 : 30, rotation: i % 2 ? -12 : 12, duration: 7 + i * 1.5, ease: "sine.inOut", yoyo: true, repeat: -1 }));
      ScrollTrigger.create({ trigger: one(".pf-hero"), start: "top bottom", end: "bottom top", onToggle: (self) => floats.forEach((f) => { if (self.isActive) f.resume(); else f.pause(); }) });
      const heroST = { trigger: one(".pf-hero"), start: "top top", end: "bottom top", scrub: true };
      gsap.to(q(".pf-bg"), { yPercent: 16, ease: "none", scrollTrigger: heroST });
      gsap.to(q(".pf-hero-in"), { yPercent: -8, autoAlpha: 0.35, ease: "none", scrollTrigger: heroST });

      /* pf-fx1: stat counters + headline word reveals */
      q(".pf-stats b").forEach((b) => {
        const end = parseInt(b.textContent || "0", 10), o = { v: 0 };
        b.textContent = "0";
        gsap.to(o, { v: end, duration: 1.8, delay: 1, ease: "power3.out", onUpdate: () => { b.textContent = String(Math.round(o.v)); }, onComplete: () => { b.textContent = String(end); } });
      });
      q(".pf-head h2, .pf-cta h2").forEach((h) => {
        const w = splitWords(h);
        gsap.from(w, { yPercent: 115, rotate: 3, duration: 1.1, ease: "expo.out", stagger: 0.06, scrollTrigger: { trigger: h, start: "top 88%", once: true } });
      });

      /* section heads + featured cards */
      q("[data-pf]").forEach((el) => gsap.from(el, { y: 40, autoAlpha: 0, duration: 1.1, ease: "expo.out", scrollTrigger: { trigger: el, start: "top 88%", once: true } }));
      q(".pf-feat").forEach((card, i) => {
        const wrap = card.querySelector(".pf-fimg"), img = card.querySelector(".pf-fimg > *");
        gsap.from(wrap, { clipPath: "inset(14% 8% 14% 8% round 28px)", scale: 0.94, duration: 1.4, ease: "expo.out", scrollTrigger: { trigger: card, start: "top 82%", once: true } });
        gsap.from(card.querySelectorAll(".pf-ft > *"), { y: 26, autoAlpha: 0, stagger: 0.08, duration: 0.9, ease: "expo.out", scrollTrigger: { trigger: card, start: "top 75%", once: true } });
        gsap.fromTo(img, { yPercent: -7 }, { yPercent: 7, ease: "none", scrollTrigger: { trigger: card, start: "top bottom", end: "bottom top", scrub: true } });
        if (fine) {
          const rx = gsap.quickTo(card, "rotationX", { duration: 0.8, ease: "power3" }), ry = gsap.quickTo(card, "rotationY", { duration: 0.8, ease: "power3" });
          gsap.set(card, { transformPerspective: 1100 });
          on(card, "pointermove", (e: PointerEvent) => { const b = card.getBoundingClientRect(); ry(((e.clientX - b.left) / b.width - 0.5) * (i % 2 ? -5 : 5)); rx(-((e.clientY - b.top) / b.height - 0.5) * 4); });
          on(card, "pointerleave", () => { rx(0); ry(0); });
        }
      });
      gsap.from(q(".pf-cta > *"), { y: 40, autoAlpha: 0, stagger: 0.12, duration: 1.1, ease: "expo.out", scrollTrigger: { trigger: one(".pf-cta"), start: "top 75%", once: true } });

      if (fine) {
        q(".pf-mag").forEach((b) => {
          const x = gsap.quickTo(b, "x", { duration: 0.6, ease: "elastic.out(1,.5)" }), y = gsap.quickTo(b, "y", { duration: 0.6, ease: "elastic.out(1,.5)" });
          on(b, "pointermove", (e: PointerEvent) => { const r = b.getBoundingClientRect(); x((e.clientX - (r.left + r.width / 2)) * 0.3); y((e.clientY - (r.top + r.height / 2)) * 0.35); });
          on(b, "pointerleave", () => { x(0); y(0); });
        });
        const hero = one(".pf-hero")!;
        const lx = gsap.quickTo(one(".pf-glow"), "x", { duration: 1.2, ease: "power3" }), ly = gsap.quickTo(one(".pf-glow"), "y", { duration: 1.2, ease: "power3" });
        on(hero, "pointermove", (e: PointerEvent) => { const b = hero.getBoundingClientRect(); lx(e.clientX - b.left - 260); ly(e.clientY - b.top - 260); });
        const g = grid.current;
        if (g) on(g, "pointermove", (e: PointerEvent) => {
          const c = (e.target as Element).closest<HTMLElement>(".pf-card");
          if (!c) return;
          const b = c.getBoundingClientRect();
          c.style.setProperty("--mx", (e.clientX - b.left) + "px");
          c.style.setProperty("--my", (e.clientY - b.top) + "px");
        });
      }
      ScrollTrigger.refresh();
      return () => { offs.forEach((f) => f()); gsap.ticker.remove(tick); lenis.destroy(); };
    });
    return () => mm.revert();
  }, { scope: root });

  const size = (i: number) => (i % 9 === 0 ? "wide" : i % 9 === 4 ? "tall" : "");

  return (
    <div className="pf" ref={root}>
      {/* HERO */}
      <header className="pf-hero">
        <div className="pf-bg" aria-hidden="true"><i className="pf-glow" /><i className="pf-shape s1" /><i className="pf-shape s2" /><i className="pf-shape s3" /><span className="pf-layer" /></div>
        <div className="pf-wrap pf-hero-in">
          <p className="pf-pill"><i />Our portfolio</p>
          <h1 className="pf-h1">Some of our <em>recent works.</em></h1>
          <p className="pf-sub">We have worked across multiple industry verticals and helped businesses in diverse domains.</p>
          <ul className="pf-stats">
            <li><b>{PROJECTS.length}</b><span>Projects listed</span></li>
            <li><b>{counts.web}</b><span>Websites</span></li>
            <li><b>{counts.app}</b><span>Apps</span></li>
            <li><b>{counts.graphics}</b><span>Graphics</span></li>
          </ul>
        </div>
      </header>

      {/* FEATURED */}
      <section className="pf-sec pf-featured" id="featured">
        <div className="pf-wrap">
          <div className="pf-head" data-pf><p className="pf-eye">Selected work</p><h2>Featured case studies</h2><p>Detailed walk-throughs of architecture, UX design and engineering solutions.</p></div>
          <div className="pf-fgrid">
            {FEATURED.map((f, i) => (
              <a className={`pf-feat f${i}`} key={f.slug} href={f.href} data-cur="open" data-label="View">
                <div className="pf-fimg"><Cover name={f.name} cat="web" src={images[f.slug] ?? f.img} /><span className="pf-chip">{f.tag}</span><i className="pf-go"><Arrow /></i></div>
                <div className="pf-ft"><small>{f.sector}</small><h3>{f.name}</h3><p>{f.desc}</p><span className="pf-link">Read case study <Arrow /></span></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      {/* DIRECTORY */}
      <section className="pf-sec pf-dir" id="projects">
        <div className="pf-wrap">
          <div className="pf-head" data-pf><p className="pf-eye">All projects directory</p><h2>Browse every project</h2></div>
          <div className="pf-filters" ref={bar} role="tablist" aria-label="Filter projects by category" data-pf>
            <span className="pf-ind" ref={ind} aria-hidden="true" />
            {CATS.map((c) => (
              <motion.button key={c.key} whileHover={{ y: -2 }} whileTap={{ scale: 0.95 }} transition={{ type: "spring", stiffness: 420, damping: 22 }} type="button" role="tab" aria-selected={cat === c.key} data-k={c.key} className={cat === c.key ? "on" : ""} onClick={() => pick(c.key)} data-cur="open" data-label="Filter">
                {c.label}<sup>{counts[c.key]}</sup></motion.button>
            ))}
          </div>
          <p className="pf-count" aria-live="polite">Showing <motion.b key={visible.length} initial={{ y: 8, opacity: 0 }} animate={{ y: 0, opacity: 1 }} transition={{ duration: 0.4 }}>{visible.length}</motion.b> of {list.length} projects</p>
          <div className="pf-grid" ref={grid}>
            {visible.map((p: Project, i) => (
              <article className={`pf-card ${size(i)}`} key={p.slug + i} tabIndex={0} data-cur="open" data-label="View">
                <Cover name={p.name} cat={p.cat} src={images[p.slug]} blur />
                <div className="pf-ov"><small>{CAT_LABEL[p.cat]}</small><h3>{p.name}</h3><p>{p.desc}</p></div>
                <i className="pf-go"><Arrow /></i>
              </article>
            ))}
          </div>
          {limit < list.length && (
            <div className="pf-more"><button type="button" className="pf-btn pf-mag" onClick={() => setLimit((l) => l + PAGE)}>Load more projects <motion.span key={list.length - limit} initial={{ y: 6, opacity: 0 }} animate={{ y: 0, opacity: 0.7 }} transition={{ duration: 0.35 }}>{list.length - limit} left</motion.span></button></div>
          )}
        </div>
      </section>

      {/* CTA */}
      <section className="pf-cta-sec">
        <div className="pf-wrap pf-cta">
          <p className="pf-eye">Start a conversation</p>
          <h2>Have a project in mind?</h2>
          <p>Tell us about your website, app, design or marketing needs and talk directly with the people who will build it.</p>
          <div className="pf-cta-b"><a className="pf-btn pf-mag" href="/contact" data-cur="open" data-label="Open">Start a project <Arrow /></a><a className="pf-btn pf-btn--ghost pf-mag" href="tel:9818439664">Call 9818439664</a></div>
        </div>
      </section>
    </div>
  );
}