          <figure className="dmp-photo dmp-why-img" data-clip>
            <img src={P("dmx", "board")} alt="Team collaborating around a whiteboard during a marketing planning session" loading="lazy" decoding="async" data-par />
            <figcaption className="dmp-cap"><b>Softsaro</b><span>Digital marketing and IT team &middot; Kathmandu, Nepal and USA</span></figcaption>
          </figure>
          <div>
