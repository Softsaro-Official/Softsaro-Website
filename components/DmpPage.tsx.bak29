            <h2 className="dmp-h2 left" data-up>Why work with Softsaro?</h2>
            <i className="dmp-bar l" data-up />
            <p className="dmp-lede" data-up>Marketing that is planned, made and measured in one place. You deal with one team that owns the strategy, the creative, the website and the reporting, so nothing falls between suppliers. It is not the right fit for every project, and we will tell you honestly if you need something different.</p>
            <ul className="dmp-rows">{WHY.map((w, i) => (<li key={w.t} data-up style={st(i)}><span className="dmp-ico"><Ic k={w.k} /></span><div><b>{w.t}</b><span>{w.d}</span></div></li>))}</ul>
            <div className="dmp-row-cta" data-up><a className="dmp-btn p" data-mag href="#dmp-contact"><span>Book a free consultation</span></a><a className="dmp-link" href="#dmp-work">See the portfolio <Ic k="arrow" /></a></div>
          </div>
        </div>
      </section>



      {/* ===== MEET THE TEAM ===== */}
      

      {/* ===== PROCESS ===== */}
      <section className="dmp-sec dmp-dark dmp-proc" id="dmp-process">
        <div className="dmp-in">
          <Head tag="Digital marketing process" t="Our 5-step process" lede="From first call to steady growth, built around your goals, with your approval at each stage." dark />
          <div className="dmp-proc-g">
            <ol className="dmp-steps"><i className="dmp-tl" aria-hidden="true" />
              {STEPS.map((s, i) => (<li key={s.t} data-step style={st(i)}><b>{i + 1}</b><div><h3>{s.t}</h3><p>{s.d}</p></div></li>))}
            </ol>
            <div className="dmp-pchart" aria-hidden="true">
              <svg viewBox="0 0 400 300" fill="none">
                {[60, 120, 180, 240].map((y) => (<line key={y} className="dmp-pl" x1="10" x2="390" y1={y} y2={y} />))}
                {[40, 85, 70, 120, 100, 150, 140, 185].map((h, i) => (<rect key={i} className="dmp-pbar" x={30 + i * 44} y={270 - h} width="26" height={h} rx="4" />))}
                <polyline className="dmp-pline" pathLength={1} points="43,235 87,190 131,205 175,150 219,170 263,118 307,128 351,80" />
                <circle className="dmp-pdot" cx="351" cy="80" r="8" />
              </svg>
              <small>Illustrative</small>
            </div>
          </div>
          <div className="dmp-center-cta" data-up><a className="dmp-btn o" data-mag href="#dmp-contact"><span>Request a free quote</span></a><a className="dmp-btn p" data-mag href={TEL}><span>Talk to Softsaro</span></a></div>
        </div>
      </section>

      {/* ===== SERVICES (interactive) ===== */}
      <section className="dmp-sec dmp-svcs" id="dmp-services">
        <div className="dmp-in">
          <Head tag="Services" t="Digital marketing services in Dubai" lede="Strategy, search, ads, social, content, email and reporting. Pick a service to see what is included." />
          <div className="dmp-svc">
            <div className="dmp-tabs" role="tablist" aria-label="Services" data-up><i className="dmp-svc-ind" aria-hidden="true" />
              {SERV.map((s, i) => (<button key={s.n} type="button" role="tab" id={`dmp-tab-${i}`} aria-selected={i === 0} aria-controls={`dmp-pane-${i}`} className={`dmp-tab${i === 0 ? " on" : ""}`}><span className="dmp-ti"><Ic k={s.k} /></span>{s.n}</button>))}
            </div>
            <div className="dmp-panes" data-up><div className="dmp-svc-prog" aria-hidden="true"><i /></div>
              {SERV.map((s, i) => (
                <article key={s.n} role="tabpanel" id={`dmp-pane-${i}`} aria-labelledby={`dmp-tab-${i}`} className="dmp-pane">
                  <header className="dmp-pane-h">
                    <span className="dmp-ti lg"><Ic k={s.k} /></span>
                    <div><h3>{s.h}</h3><p>{s.d}</p><ul className="dmp-pills2">{s.tags.map((t) => (<li key={t}>{t}</li>))}</ul></div>
                  </header>
                  <div className="dmp-pane-b">
                    <h4>What is included</h4>
                    <ul className="dmp-inc">{s.inc.map((x) => (<li key={x[0]}><Ic k="check" /><div><b>{x[0]}</b><span>{x[1]}</span></div></li>))}</ul>
                    <div className="dmp-pane-2">
                      <div><h4>Best for</h4><ul className="dmp-bf">{s.best.map((x) => (<li key={x}>{x}</li>))}</ul></div>
                      <div><h4>What we report</h4><ol className="dmp-rep">{s.rep.map((x, j) => (<li key={x}><i>{j + 1}</i>{x}</li>))}</ol></div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ===== TOOLS ===== */}
      <section className="dmp-sec dmp-tools">
        <div className="dmp-in">
          <Head tag="Digital marketing tools" t="Tools we use" lede="The platforms Softsaro uses to plan, run and report your digital marketing in Dubai." />
          <ul className="dmp-g4 t">
            {TOOLS.map((t, i) => (<li className="dmp-tool" key={t[1]} data-up style={st(i % 4)}><i>{t[0]}</i>{t[1]}</li>))}
          </ul>
        </div>
      </section>

      {/* ===== INDUSTRIES ===== */}
      <section className="dmp-sec dmp-ind">
        <div className="dmp-in">
          <Head tag="Digital marketing by industry" t="Industries we help grow" lede="Every sector in the UAE buys differently. We adapt the channels and message to the customer, not the other way round." />
          <div className="dmp-bentos">
            {INDUSTRIES.map((x, i) => (
              <Rise className={`dmp-bento b${i}`} key={x.t} i={i}>
                <img src={P("dmp", "ind" + (i + 1))} alt="" aria-hidden="true" loading="lazy" decoding="async" />
                <span className="dmp-ico"><Ic k={x.k} /></span>
                <h3>{x.t}</h3>
                <b className="dmp-tagline">{x.tag}</b>
                <p>{x.d}</p>
              </Rise>
            ))}
          </div>
        </div>
      </section>

      {/* ===== UAE STRATEGY ===== */}
      

      {/* ===== TERMS ===== */}
      <section className="dmp-sec dmp-terms">
        <div className="dmp-in">
          <Head tag="Digital marketing UAE explained" t="Digital marketing terms in Dubai, simply explained" lede="Marketing and digital marketing mean different things to different people. Here is how we use the main terms when advising Dubai and UAE businesses." />
          <div className="dmp-g3">
            {TERMS.map((t, i) => (<article className="dmp-card" key={t.t} data-up style={st(i % 3)}><span className="dmp-ico"><Ic k={t.k} /></span><h3>{t.t}</h3><p>{t.d}</p></article>))}
          </div>
        </div>
      </section>

      {/* ===== CHOOSING THE RIGHT AGENCY ===== */}
      <section className="dmp-sec dmp-guide" id="dmp-guide">
        <div className="dmp-in">
          <Head tag="Agency guide" t="Choosing the right agency" />
          <div className="dmp-two g">
            <div className="dmp-noteb" data-up>
              <span className="dmp-ico"><Ic k="award" /></span>
              <b>No official ranking</b>
              <p>There is no official ranking of the best digital marketing agencies, top digital marketing companies or digital marketing firms, so be careful with anyone who claims to be number one. Compare providers on evidence instead: case studies, reviews, sample reports and how clearly they explain their plan.</p>
              <p>Online marketing is remote by nature. A team that works on Dubai time can serve you as well as a local office, often at lower cost. Meet over video, agree a plan and judge by results.</p>
            </div>
            <div>
              <h4 className="dmp-sm" data-up>Checklist before you sign</h4>
              <ul className="dmp-list">{CHECKLIST.map((c, i) => (<li key={c.t} data-up style={st(i)}><span className="dmp-ico"><Ic k={c.k} /></span>{c.t}</li>))}</ul>
            </div>
          </div>
        </div>
      </section>

      {/* ===== TRAINING ===== */}
      <section className="dmp-sec dmp-learn">
        <div className="dmp-in">
          <Head tag="Digital marketing courses in Dubai" t="Courses and training" lede="Want to build the skills yourself? Softsaro also runs practical training." />
          <div className="dmp-g3">
            <article className="dmp-card" data-up><span className="dmp-ico"><Ic k="target" /></span><h3>Pick a course that teaches by doing</h3><p>Choose training with live practice, real accounts and feedback, not only slides. Look for a syllabus that covers search, ads, social media, analytics and strategy.</p></article>
            <a className="dmp-card link" href="/digital-marketing-training" data-up style={st(1)}><span className="dmp-ico"><Ic k="grad" /></span><h3>Digital marketing training</h3><p>Softsaro&rsquo;s practical digital marketing training programme.</p><span className="dmp-more">View the training <Ic k="arrow" /></span></a>
            <a className="dmp-card link" href="/seo-training" data-up style={st(2)}><span className="dmp-ico"><Ic k="search" /></span><h3>SEO training</h3><p>A practical SEO training programme for business owners, marketers and freelancers.</p><span className="dmp-more">View the training <Ic k="arrow" /></span></a>
          </div>
        </div>
      </section>

      {/* ===== PORTFOLIO ===== */}
      <section className="dmp-sec dmp-work" id="dmp-work">
        <div className="dmp-in">
          <Head tag="Digital marketing portfolio" t="Our portfolio" lede="The SEO, advertising, social media and content work we do to grow your business. Cards marked Concept example are illustrative, not client results." />
          <DmpWork items={pj} base={S} />
          <div className="dmp-center-cta" data-up><a className="dmp-btn p" data-mag href={`${S}/portfolio`}><span>View full portfolio</span></a></div>
        </div>
      </section>

      {/* ===== RESULTS & ANALYTICS ===== */}
      

      {/* ===== TESTIMONIALS ===== */}
      <section className="dmp-sec dmp-dark dmp-rev" id="dmp-reviews">
        <div className="dmp-in">
          <Head tag="Testimonials" t="Client words" lede={REVIEW_NOTE} dark />
          {tq.length ? (
            <div className="dmp-rev-top">
              <figure className="dmp-feat" data-up><i>&ldquo;</i><blockquote>{tq[Math.min(1, tq.length - 1)][2]}</blockquote><figcaption><b>{tq[Math.min(1, tq.length - 1)][0]}</b> <span>&middot; {tq[Math.min(1, tq.length - 1)][1]}</span></figcaption></figure>
              <div className="dmp-feat-side" data-up><b>Work with Softsaro</b><span>See what we have built, or talk to us about your goals.</span><a className="dmp-btn o" href={`${S}/portfolio`}><span>View portfolio</span></a></div>
            </div>
          ) : null}
          <div className="dmp-g4 r">
            {tq.map((t, i) => (<figure className="dmp-tq" key={t[0]} data-up style={st(i % 4)}><blockquote>{t[2]}</blockquote><figcaption><b>{t[0]}</b><span>{t[1]}</span></figcaption></figure>))}
          </div>
        </div>
      </section>

      {/* ===== FAQ ===== */}
      <section className="dmp-sec dmp-faqs" id="dmp-faq">
        <div className="dmp-in dmp-faq-g">
          <figure className="dmp-photo dmp-faq-img" data-clip>
            <img src={P("dmd", "global")} alt="Team discussing global marketing strategies with charts on a laptop" loading="lazy" decoding="async" data-par />
          </figure>
          <div>
            <span className="dmp-eye lt" data-up>Digital marketing in Dubai FAQ</span>
            <h2 className="dmp-h2 left lt" data-up>Frequently asked questions</h2>
            <ul className="dmp-faq">
              {FAQ.map((f, i) => (
                <li className="dmp-fqi" key={f.q}>
                  <button className="dmp-fq" type="button" id={`dmp-fq-${i}`} aria-expanded="false" aria-controls={`dmp-fa-${i}`}><span>{f.q}</span><i aria-hidden="true" /></button>
                  <div className="dmp-fa" id={`dmp-fa-${i}`} role="region" aria-labelledby={`dmp-fq-${i}`}><p>{f.a}</p></div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      {/* ===== INSIGHTS ===== */}
      <section className="dmp-sec dmp-blog">
        <div className="dmp-in">
          <div className="dmp-blog-h"><div><span className="dmp-eye" data-up>Blog</span><h2 className="dmp-h2 left" data-up>Our latest insights</h2></div><a className="dmp-btn d" href={`${S}/blog`} data-up><span>Read the blog</span></a></div>
          <a className="dmp-blog-c" href={`${S}/blog`} data-up>
            <span className="dmp-blog-img"><img src="/assets/dm/analytics.jpg" alt="" aria-hidden="true" loading="lazy" decoding="async" /></span>
            <span className="dmp-blog-b"><small>Softsaro insights</small><b>Guides on web, SEO and digital marketing</b><span>Practical articles from the Softsaro team on getting found, running campaigns and measuring what matters.</span><i>Read the blog <Ic k="arrow" /></i></span>
          </a>
        </div>
      </section>

      {/* ===== CONTACT ===== */}
      <section className="dmp-sec dmp-contact" id="dmp-contact">
        <div className="dmp-in">
          <Head tag="Contact" t="Let's grow your business" lede="Tell us about your business and goals. We will reply with an honest view of what is realistic and where to start." />
          <div className="dmp-cbox" data-up>
            <div className="dmp-cform-w"><ContactForm /></div>
            <div className="dmp-map">
              <iframe title="Softsaro office location on Google Maps" src="https://www.google.com/maps?q=Trade+Tower+Thapathali+Kathmandu&output=embed" loading="lazy" referrerPolicy="no-referrer-when-downgrade" />
              <ul className="dmp-cinfo">
                <li><a href={TEL}><Ic k="phone" />{PHONE}</a></li>
                <li><a href={`mailto:${MAIL}`}><Ic k="mail" />{MAIL}</a></li>
                <li><span><Ic k="pin" />Trade Tower, 5th Floor, Thapathali, Kathmandu</span></li>
              </ul>
            </div>
          </div>
        </div>
      </section>


      <section className="dmp-strip">
        <div className="dmp-in"><h2>Ready to grow online? Let&rsquo;s talk.</h2><div><a className="dmp-btn o" href={`${S}/services/digital-marketing-in-nepal`}><span>View all services</span></a><a className="dmp-btn w" href="#dmp-contact"><span>Book a free consultation</span></a></div></div>
      </section>

      <svg className="dmp-sky" viewBox="0 0 400 160" preserveAspectRatio="xMidYMax slice" aria-hidden="true" width="0" height="0">
        {SKY.map((b, i) => (<rect key={i} x={b.x} y={160 - b.h} width={b.w} height={b.h} />))}
      </svg>

      <DmpMotion />
      <DmpFx />
      <DmpSvcScroll />
    </main>
  );
}