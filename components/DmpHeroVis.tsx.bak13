"use client";
import { motion, useReducedMotion } from "framer-motion";

const ease = [0.16, 1, 0.3, 1] as const;

export default function HeroVis({ a, b }: { a: string; b: string }) {
  const rm = useReducedMotion();
  const chip = (delay: number) => ({
    initial: { opacity: 0, scale: 0.85 },
    animate: rm ? { opacity: 1, scale: 1 } : { opacity: 1, scale: 1, y: [0, -8, 0] },
    transition: rm ? { duration: 0 } : { opacity: { delay, duration: 0.6 }, scale: { delay, duration: 0.6 }, y: { delay: delay + 0.6, duration: 5.5, repeat: Infinity, ease: "easeInOut" as const } },
  });
  return (
    <div className="dmp-hv">
      <motion.figure className="dmp-hv-a" initial={{ opacity: 0, y: 40, scale: 0.97 }} animate={{ opacity: 1, y: 0, scale: 1 }} transition={{ duration: rm ? 0 : 1.1, delay: rm ? 0 : 0.9, ease }}>
        <img src={a} alt="" aria-hidden="true" decoding="async" />
      </motion.figure>
      <motion.figure className="dmp-hv-b" initial={{ opacity: 0, y: 40, x: 20 }} animate={{ opacity: 1, y: 0, x: 0 }} transition={{ duration: rm ? 0 : 1.1, delay: rm ? 0 : 1.15, ease }}>
        <img src={b} alt="" aria-hidden="true" decoding="async" />
      </motion.figure>
      <motion.span className="dmp-chip c1" {...chip(1.5)}><i />Search</motion.span>
      <motion.span className="dmp-chip c2" {...chip(1.7)}><i />Google Ads</motion.span>
      <motion.span className="dmp-chip c3" {...chip(1.9)}><i />Social and content</motion.span>
    </div>
  );
}