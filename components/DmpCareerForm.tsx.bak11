"use client";
import { useRef, useState } from "react";

const CONTACT = { email: "info@softsaro.com" };
// Edit this list to match your open roles.
const ROLES = [
  "Digital Marketing Executive", "SEO Specialist", "Content Writer", "Social Media Manager",
  "UI/UX Designer", "Frontend Developer", "Backend Developer", "Mobile App Developer",
  "Business Development", "Internship", "Other",
];
const MAX = 5 * 1024 * 1024;
const EXT = ["pdf", "doc", "docx"];
type S = "idle" | "sending" | "sent" | "error";

const size = (n: number) => (n < 1024 * 1024 ? `${Math.max(1, Math.round(n / 1024))} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`);

export default function DmpCareerForm() {
  const [file, setFile] = useState<File | null>(null);
  const [fileErr, setFileErr] = useState("");
  const [drag, setDrag] = useState(false);
  const [state, setState] = useState<S>("idle");
  const [msg, setMsg] = useState("");
  const [mail, setMail] = useState("");
  const inp = useRef<HTMLInputElement>(null);

  function pick(f?: File | null) {
    if (!f) return;
    const ext = (f.name.split(".").pop() || "").toLowerCase();
    if (!EXT.includes(ext)) { setFileErr("Please upload a PDF, DOC or DOCX file."); return; }
    if (f.size === 0) { setFileErr("That file is empty."); return; }
    if (f.size > MAX) { setFileErr("The file is larger than 5 MB."); return; }
    setFileErr(""); setFile(f);
  }
  function remove() { setFile(null); setFileErr(""); if (inp.current) inp.current.value = ""; }

  async function submit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    if (!file) { setFileErr("Please attach your CV (PDF, DOC or DOCX)."); return; }
    const fd = new FormData(e.currentTarget);
    fd.set("cv", file);
    const g = (k: string) => String(fd.get(k) || "").trim();
    setState("sending"); setMsg("");
    try {
      const r = await fetch("/api/careers", { method: "POST", body: fd });
      const d = await r.json().catch(() => ({} as { ok?: boolean; error?: string }));
      if (r.ok && d.ok) { setState("sent"); return; }
      setMsg(d.error || "We could not send your application online.");
    } catch {
      setMsg("We could not reach the server.");
    }
    setMail(`mailto:${CONTACT.email}?subject=${encodeURIComponent("Job application: " + g("role"))}&body=${encodeURIComponent(`Name: ${g("name")}\nEmail: ${g("email")}\nPhone: ${g("phone")}\nRole: ${g("role")}\nLinkedIn: ${g("linkedin") || "-"}\nPortfolio: ${g("portfolio") || "-"}\n\n${g("intro")}\n\n(Please attach your CV to this email.)`)}`);
    setState("error");
  }

  if (state === "sent") return (
    <div className="dmp-done" role="status"><b>Application received.</b><p>Thank you for your interest in Softsaro. Our team will review your CV and contact you if there is a fit.</p></div>
  );
  if (state === "error") return (
    <div className="dmp-done" role="alert">
      <b>Not sent yet.</b>
      <p>{msg} Your application has not been submitted. Please email your details and CV to {CONTACT.email} instead.</p>
      <div className="dmp-done-btns"><a className="dmp-btn p" href={mail}><span>Email my application</span></a><button type="button" className="dmp-btn o" onClick={() => setState("idle")}><span>Back to form</span></button></div>
    </div>
  );

  return (
    <form className="dmp-form dmp-ap" onSubmit={submit} noValidate={false}>
      <div className="dmp-ap-two">
        <input name="name" required minLength={2} maxLength={100} aria-label="Full name" placeholder="Full name" autoComplete="name" />
        <input name="phone" type="tel" required maxLength={30} aria-label="Phone number" placeholder="Phone number" autoComplete="tel" />
      </div>
      <input name="email" type="email" required maxLength={120} aria-label="Email address" placeholder="Email address" autoComplete="email" />
      <select name="role" required aria-label="Position applying for" defaultValue="">
        <option value="" disabled>Position / role applying for</option>
        {ROLES.map((r) => (<option key={r} value={r}>{r}</option>))}
      </select>

      <div
        className={`dmp-drop${drag ? " drag" : ""}${file ? " has" : ""}${fileErr ? " err" : ""}`}
        onDragOver={(e) => { e.preventDefault(); setDrag(true); }}
        onDragLeave={() => setDrag(false)}
        onDrop={(e) => { e.preventDefault(); setDrag(false); pick(e.dataTransfer.files?.[0]); }}
      >
        <input ref={inp} id="dmp-cv" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" className="dmp-sr" onChange={(e) => pick(e.target.files?.[0])} />
        {file ? (
          <div className="dmp-file">
            <span className="dmp-file-ic" aria-hidden="true">{(file.name.split(".").pop() || "").toUpperCase()}</span>
            <span className="dmp-file-n"><b>{file.name}</b><small>{size(file.size)}</small></span>
            <button type="button" className="dmp-file-b" onClick={() => inp.current?.click()}>Replace</button>
            <button type="button" className="dmp-file-b rm" onClick={remove} aria-label="Remove selected file">Remove</button>
          </div>
        ) : (
          <label htmlFor="dmp-cv" className="dmp-drop-l">
            <svg viewBox="0 0 24 24" className="dmp-ic" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16" /></svg>
            <b>Upload your CV / resume</b>
            <small>Drag and drop or click to browse &middot; PDF, DOC, DOCX &middot; max 5 MB</small>
          </label>
        )}
      </div>
      {fileErr ? <p className="dmp-ap-err" role="alert">{fileErr}</p> : null}

      <div className="dmp-ap-two">
        <input name="linkedin" type="url" maxLength={200} aria-label="LinkedIn profile (optional)" placeholder="LinkedIn (optional)" inputMode="url" />
        <input name="portfolio" type="url" maxLength={200} aria-label="Portfolio or website (optional)" placeholder="Portfolio / website (optional)" inputMode="url" />
      </div>
      <textarea name="intro" required minLength={20} maxLength={1500} rows={3} aria-label="Tell us about yourself" placeholder="Tell us about yourself and why you want to join Softsaro" />
      <input name="company" tabIndex={-1} autoComplete="off" aria-hidden="true" className="dmp-sr" />
      <button className="dmp-btn p full" type="submit" disabled={state === "sending"}><span>{state === "sending" ? "Sending..." : "Submit application"}</span></button>
      <p className="dmp-form-note">We review every application &middot; Reply within a few working days</p>
    </form>
  );
}