"use client";
import { useState } from "react";

const CONTACT = { email: "info@softsaro.com" };
// Edit this list to match your open roles.
const ROLES = [
  "Digital Marketing Executive", "SEO Specialist", "Content Writer", "Social Media Manager",
  "UI/UX Designer", "Frontend Developer", "Backend Developer", "Mobile App Developer",
  "Business Development", "Internship", "Other",
];
type S = "idle" | "sending" | "sent" | "error";

export default function DmpCareerForm() {
  const [state, setState] = useState<S>("idle");
  const [msg, setMsg] = useState("");
  const [mail, setMail] = useState("");

  async function submit(e: React.FormEvent<HTMLFormElement>) {
    e.preventDefault();
    const fd = new FormData(e.currentTarget);
    const g = (k: string) => String(fd.get(k) || "").trim();
    setState("sending"); setMsg("");
    try {
      const r = await fetch("/api/careers", { method: "POST", body: fd });
      const d = await r.json().catch(() => ({} as { ok?: boolean; error?: string }));
      if (r.ok && d.ok) { setState("sent"); return; }
      setMsg(d.error || "We could not send your application online.");
    } catch {
      setMsg("We could not reach the server.");
    }
    setMail(`mailto:${CONTACT.email}?subject=${encodeURIComponent("Job application: " + g("role"))}&body=${encodeURIComponent(`Name: ${g("name")}\nEmail: ${g("email")}\nPhone: ${g("phone")}\nRole: ${g("role")}\nLinkedIn: ${g("linkedin") || "-"}\nPortfolio: ${g("portfolio") || "-"}\n\n${g("intro")}`)}`);
    setState("error");
  }

  if (state === "sent") return (
    <div className="dmp-done" role="status"><b>Application received.</b><p>Thank you for your interest in Softsaro. Our team will review your details and contact you.</p></div>
  );
  if (state === "error") return (
    <div className="dmp-done" role="alert">
      <b>Not sent yet.</b>
      <p>{msg} Your application has not been submitted. Please email your details to {CONTACT.email} instead.</p>
      <div className="dmp-done-btns"><a className="dmp-btn p" href={mail}><span>Email my application</span></a><button type="button" className="dmp-btn o" onClick={() => setState("idle")}><span>Back to form</span></button></div>
    </div>
  );

  return (
    <form className="dmp-form dmp-ap" onSubmit={submit} noValidate={false}>
      <div className="dmp-ap-two">
        <input name="name" required minLength={2} maxLength={100} aria-label="Full name" placeholder="Full name" autoComplete="name" />
        <input name="phone" type="tel" required maxLength={30} aria-label="Phone number" placeholder="Phone number" autoComplete="tel" />
      </div>
      <input name="email" type="email" required maxLength={120} aria-label="Email address" placeholder="Email address" autoComplete="email" />
      <select name="role" required aria-label="Position applying for" defaultValue="">
        <option value="" disabled>Position / role applying for</option>
        {ROLES.map((r) => (<option key={r} value={r}>{r}</option>))}
      </select>
      <div className="dmp-ap-two">
        <input name="linkedin" type="url" maxLength={200} aria-label="LinkedIn profile (optional)" placeholder="LinkedIn (optional)" inputMode="url" />
        <input name="portfolio" type="url" maxLength={200} aria-label="Portfolio or website (optional)" placeholder="Portfolio / website (optional)" inputMode="url" />
      </div>
      <textarea name="intro" required minLength={20} maxLength={1500} rows={3} aria-label="Tell us about your business" placeholder="Tell us about your business" />
      <input name="company" tabIndex={-1} autoComplete="off" aria-hidden="true" className="dmp-sr" />
      <button className="dmp-btn p full" type="submit" disabled={state === "sending"}><span>{state === "sending" ? "Sending..." : "Submit application"}</span></button>
      <p className="dmp-form-note">We review every application &middot; Reply within a few working days</p>
    </form>
  );
}