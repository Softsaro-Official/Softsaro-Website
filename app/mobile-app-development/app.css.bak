/* Mobile app page - every rule is prefixed .ap / .ap- / .aps */
.ap {
    --p: #6a67ae;
    --p2: #3f3d7a;
    --pl: #bcb9e0;
    --pb: #ebeaf6;
    --cr: #f3efe8;
    --ink: #0a0b14;
    --ex: cubic-bezier(.7, 0, .2, 1);
    --ox: cubic-bezier(.16, 1, .3, 1);
    background: var(--cr);
    color: var(--ink);
    overflow-x: clip;
    font-family: var(--font-inter), Inter, system-ui, sans-serif
}

.ap * {
    box-sizing: border-box
}

.ap-wrap {
    max-width: 1760px;
    margin: 0 auto;
    padding: 0 clamp(20px, 8vw, 120px)
}

.ap h1,
.ap h2,
.ap h3 {
    font-family: var(--font-inter), Inter, sans-serif;
    letter-spacing: -.055em;
    font-weight: 800;
    line-height: .95;
    white-space: normal;
    max-width: none;
    margin: 0
}

:where(.ap p) {
    margin: 0
}

.ap-sec {
    position: relative;
    padding: clamp(72px, 9vw, 130px) 0
}

.ap-lab {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 12px Inter, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 30px
}

.ap-lab i {
    width: 48px;
    height: 1px;
    background: currentColor
}

.ap-lab b {
    color: #1fb81f;
    font-weight: 500
}

.ap-lab.w {
    color: #fff
}

.ap-lab.w b {
    color: #3fe33f
}

.ap-h2 {
    font-size: clamp(34px, 4.8vw, 80px);
    max-width: 16ch !important;
    text-wrap: balance
}

.ap-sw {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: .1em .1em .16em;
    margin: -.1em -.1em -.16em;
    white-space: nowrap
}

.ap-si {
    display: inline-block;
    will-change: transform
}

.ap-ln .ap-sw {
    overflow: visible;
    padding: 0;
    margin: 0
}

.ap-btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 28px;
    border-radius: 99px;
    font: 600 17px var(--font-inter), Inter, sans-serif;
    letter-spacing: -.01em;
    background: var(--p);
    color: #fff;
    transition: color .4s
}

.ap-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translateY(102%);
    border-radius: 50% 50% 0 0/100% 100% 0 0;
    transition: transform .55s var(--ex), border-radius .55s var(--ex)
}

.ap-btn:hover::before {
    transform: none;
    border-radius: 0
}

.ap-btn.g {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1px #0a0b1430
}

.ap-btn.g:hover {
    color: #fff
}

.ap-btn.w {
    background: #fff;
    color: var(--ink)
}

.ap-btn.w:hover {
    color: #fff
}

.ap-btn.gw {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1px #ffffff66
}

.ap-btn.gw::before {
    background: #fff
}

.ap-btn.gw:hover {
    color: var(--p)
}

.ap-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    transition: transform .5s var(--ex)
}

.ap-btn:hover svg {
    transform: rotate(45deg)
}

.ap-photo {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--pl)
}

/* ---------- phone frame + screens (cqw = % of phone width) ---------- */
.ap-ph {
    container-type: inline-size;
    width: 100%
}

.ap-pf {
    position: relative;
    aspect-ratio: 9/19.2;
    border-radius: 13cqw;
    background: var(--ink);
    padding: 3cqw;
    box-shadow: 0 14cqw 18cqw -8cqw #3f3d7a99, inset 0 0 0 .9cqw #2b2c38;
    transition: border-radius .5s
}

.ap-pscr {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 10.4cqw;
    overflow: hidden;
    background: #fff;
    transition: border-radius .5s
}

.ap-cam {
    position: absolute;
    top: 5.4cqw;
    left: 50%;
    width: 4.4cqw;
    height: 4.4cqw;
    margin-left: -2.2cqw;
    border-radius: 50%;
    background: var(--ink);
    z-index: 6;
    transition: width .5s, height .5s, margin .5s, border-radius .5s
}

.ap-hero[data-os=ios] .ap-cam {
    width: 27cqw;
    height: 7.4cqw;
    margin-left: -13.5cqw;
    top: 4.6cqw;
    border-radius: 9cqw
}

.ap-hero[data-os=ios] .ap-pf {
    border-radius: 15cqw
}

.ap-hero[data-os=ios] .ap-pscr {
    border-radius: 12.2cqw
}

.aps {
    position: absolute;
    inset: 0;
    padding: 12cqw 6cqw 6cqw;
    display: flex;
    flex-direction: column;
    gap: 4cqw;
    background: #fff;
    overflow: hidden
}

.aps i,
.aps u,
.aps b,
.aps span {
    display: block;
    text-decoration: none
}

.aps strong {
    font: 800 7cqw var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em
}

.aps-s-top {
    display: flex;
    align-items: center;
    gap: 3cqw;
    flex: none
}

.aps-s-top i {
    width: 9cqw;
    height: 9cqw;
    flex: none;
    border-radius: 50%;
    background: var(--pl)
}

.aps-s-top span {
    flex: 1;
    height: 8cqw;
    border-radius: 9cqw;
    background: #f1eff8
}

.aps-s-top u {
    width: 8cqw;
    height: 8cqw;
    flex: none;
    border-radius: 50%;
    background: #f1eff8
}

.aps-s-ban {
    position: relative;
    height: 30cqw;
    border-radius: 5cqw;
    background: linear-gradient(135deg, var(--p), var(--p2));
    padding: 4cqw;
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
    flex: none
}

.aps-s-ban i {
    height: 3cqw;
    width: 56%;
    border-radius: 2cqw;
    background: #fff
}

.aps-s-ban i+i {
    width: 36%;
    height: 2cqw;
    background: #ffffff80
}

.aps-s-ban b {
    width: 18cqw;
    height: 6cqw;
    border-radius: 9cqw;
    background: #3fe33f;
    margin-top: auto
}

.aps-s-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqw;
    flex: 1;
    min-height: 0
}

.aps-s-grid>div {
    border-radius: 4cqw;
    background: #f6f4fb;
    padding: 2.4cqw;
    display: flex;
    flex-direction: column;
    gap: 2cqw
}

.aps-s-grid u {
    flex: 1;
    border-radius: 3cqw;
    background: linear-gradient(135deg, #bcb9e0, #6a67ae66)
}

.aps-s-grid>div:nth-child(2) u,
.aps-s-grid>div:nth-child(3) u {
    background: linear-gradient(135deg, #dcd9ef, #bcb9e0)
}

.aps-s-grid i {
    height: 2cqw;
    border-radius: 2cqw;
    background: #dedcea
}

.aps-s-grid i+i {
    width: 50%
}

.aps-s-nav {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    padding-top: 3.4cqw;
    border-top: 1px solid #0a0b1410;
    flex: none
}

.aps-s-nav i {
    width: 6.4cqw;
    height: 6.4cqw;
    border-radius: 2cqw;
    background: #dedcea
}

.aps-s-nav i:first-child {
    background: var(--p)
}

.aps-s-row {
    display: flex;
    align-items: center;
    gap: 3.4cqw;
    flex: none
}

.aps-s-row u {
    width: 12cqw;
    height: 12cqw;
    border-radius: 3.6cqw;
    background: #f1eff8;
    flex: none
}

.aps-s-row span {
    flex: 1;
    display: grid;
    gap: 2cqw
}

.aps-s-row span i {
    height: 2.4cqw;
    border-radius: 2cqw;
    background: #dedcea
}

.aps-s-row span i+i {
    width: 58%
}

.aps-track {
    padding: 0;
    gap: 0;
    background: #eeecf7
}

.aps-s-map {
    position: relative;
    flex: 1;
    background: repeating-linear-gradient(0deg, #e1def0 0 1px, transparent 1px 9cqw), repeating-linear-gradient(90deg, #e1def0 0 1px, transparent 1px 9cqw)
}

.aps-s-map svg {
    position: absolute;
    inset: 8cqw 0 0 0;
    width: 100%;
    height: calc(100% - 8cqw)
}

.aps-s-map path {
    fill: none;
    stroke: var(--p);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 4 3;
    vector-effect: non-scaling-stroke
}

.aps-s-map circle {
    fill: var(--p)
}

.aps-s-map circle+circle {
    fill: #3fe33f
}

.aps-s-sheet {
    flex: none;
    background: #fff;
    border-radius: 7cqw 7cqw 0 0;
    padding: 6cqw;
    display: grid;
    gap: 3cqw;
    box-shadow: 0 -4cqw 8cqw -4cqw #3f3d7a33
}

.aps-s-sheet strong {
    font-size: 6cqw
}

.aps-s-sheet i {
    height: 2.4cqw;
    width: 60%;
    border-radius: 2cqw;
    background: #dedcea
}

.aps-s-steps {
    display: flex;
    gap: 2cqw
}

.aps-s-steps u {
    flex: 1;
    height: 1.6cqw;
    border-radius: 2cqw;
    background: var(--pl)
}

.aps-s-steps u:first-child,
.aps-s-steps u:nth-child(2) {
    background: var(--p)
}

.aps-s-course {
    display: flex;
    align-items: center;
    gap: 4cqw;
    padding: 4cqw;
    border-radius: 5cqw;
    background: #f6f4fb;
    flex: none
}

.aps-s-course svg {
    width: 20cqw;
    height: 20cqw;
    flex: none;
    transform: rotate(-90deg)
}

.aps-s-course circle {
    fill: none;
    stroke: #dedcea;
    stroke-width: 4
}

.aps-s-course .r {
    stroke: var(--p);
    stroke-dasharray: 94;
    stroke-dashoffset: 30;
    stroke-linecap: round
}

.aps-s-course span {
    flex: 1;
    display: grid;
    gap: 2.4cqw
}

.aps-s-course span i {
    height: 3cqw;
    border-radius: 2cqw;
    background: var(--ink)
}

.aps-s-course span i+i {
    width: 60%;
    height: 2cqw;
    background: #cfcde0
}

.aps-s-card {
    position: relative;
    height: 36cqw;
    border-radius: 5cqw;
    background: linear-gradient(135deg, var(--ink), var(--p2));
    color: #fff;
    padding: 5cqw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: none
}

.aps-s-card i {
    width: 9cqw;
    height: 7cqw;
    border-radius: 1.6cqw;
    background: #ffffff40
}

.aps-s-card strong {
    font: 600 5cqw Inter, sans-serif;
    letter-spacing: .1em
}

.aps-s-card b {
    position: absolute;
    right: 5cqw;
    top: 5cqw;
    width: 9cqw;
    height: 9cqw;
    border-radius: 50%;
    background: #3fe33f
}

.aps-s-bars {
    display: flex;
    align-items: flex-end;
    gap: 3cqw;
    height: 30cqw;
    flex: none
}

.aps-s-bars i {
    flex: 1;
    border-radius: 2cqw 2cqw 0 0;
    background: linear-gradient(var(--p), #bcb9e0)
}

.aps-s-hero {
    position: relative;
    height: 46cqw;
    border-radius: 5cqw;
    background: linear-gradient(160deg, #bcb9e0, var(--p) 60%, var(--p2));
    flex: none;
    overflow: hidden
}

.aps-s-hero i {
    position: absolute;
    bottom: -12cqw;
    border-radius: 50%;
    background: #ffffff26
}

.aps-s-hero i:first-child {
    left: -8cqw;
    width: 44cqw;
    height: 44cqw
}

.aps-s-hero i+i {
    right: -10cqw;
    width: 36cqw;
    height: 36cqw;
    background: #3fe33f55
}

.aps-s-chips {
    display: flex;
    gap: 3cqw;
    flex: none
}

.aps-s-chips b {
    height: 8cqw;
    flex: 1;
    border-radius: 9cqw;
    background: #f1eff8
}

.aps-s-chips b:first-child {
    background: var(--p)
}

.aps-kit {
    gap: 5cqw
}

.aps-k-sw {
    display: flex;
    gap: 2.4cqw
}

.aps-k-sw i {
    flex: 1;
    aspect-ratio: 1;
    border-radius: 3cqw;
    background: var(--p)
}

.aps-k-sw i:nth-child(2) {
    background: var(--p2)
}

.aps-k-sw i:nth-child(3) {
    background: var(--pl)
}

.aps-k-sw i:nth-child(4) {
    background: #3fe33f
}

.aps-kit strong {
    font-size: 22cqw;
    line-height: 1;
    color: var(--p)
}

.aps-k-ui {
    display: flex;
    align-items: center;
    gap: 3cqw
}

.aps-k-ui b {
    background: var(--p);
    color: #fff;
    font: 600 4cqw Inter, sans-serif;
    padding: 2.6cqw 6cqw;
    border-radius: 9cqw
}

.aps-k-ui em {
    font: 600 4cqw Inter, sans-serif;
    font-style: normal;
    padding: 2.4cqw 6cqw;
    border-radius: 9cqw;
    box-shadow: inset 0 0 0 .5cqw var(--p);
    color: var(--p)
}

.aps-k-ui u {
    width: 13cqw;
    height: 7cqw;
    border-radius: 9cqw;
    background: var(--p);
    position: relative
}

.aps-k-ui u.o {
    background: #dedcea
}

.aps-k-ui u i {
    position: absolute;
    right: 1cqw;
    top: 1cqw;
    width: 5cqw;
    height: 5cqw;
    border-radius: 50%;
    background: #fff
}

.aps-k-ui u.o i {
    right: auto;
    left: 1cqw
}

.aps-k-in {
    height: 11cqw;
    border-radius: 3cqw;
    box-shadow: inset 0 0 0 .5cqw #cfcde0;
    display: flex;
    align-items: center;
    padding: 0 4cqw
}

.aps-k-in i {
    width: 36%;
    height: 2.4cqw;
    border-radius: 2cqw;
    background: #dedcea
}

.aps-api {
    background: var(--ink);
    color: #fff
}

.aps-a-row {
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding: 3.6cqw 4cqw;
    border-radius: 3.6cqw;
    background: #ffffff12;
    font: 500 4.2cqw 'Inter', sans-serif
}

.aps-a-row i {
    width: 3cqw;
    height: 3cqw;
    border-radius: 50%;
    background: #3fe33f
}

.aps-a-row span {
    flex: 1
}

.aps-a-row b {
    font-size: 3.4cqw;
    color: #3fe33f
}

.aps-t-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqw
}

.aps-t-grid>div {
    aspect-ratio: 1;
    border-radius: 4cqw;
    background: #f6f4fb;
    display: grid;
    place-items: center
}

.aps-t-grid svg {
    width: 42%;
    fill: none;
    stroke: var(--p);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round
}

.aps-t-bar {
    height: 3cqw;
    border-radius: 2cqw;
    background: #dedcea;
    overflow: hidden;
    margin-top: auto
}

.aps-t-bar i {
    height: 100%;
    width: 82%;
    background: var(--p)
}

.aps-rel>b {
    margin-top: auto;
    text-align: center;
    background: var(--p);
    color: #fff;
    font: 600 4.6cqw Inter, sans-serif;
    padding: 3.6cqw;
    border-radius: 9cqw
}

/* ---------- hero ---------- */
.ap-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(76px + clamp(24px, 4vw, 64px)) 0 clamp(70px, 8vw, 120px)
}

.ap-hero-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(#0a0b140d 1px, transparent 1px), linear-gradient(90deg, #0a0b140d 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(70% 70% at 70% 45%, #000, transparent);
    mask-image: radial-gradient(70% 70% at 70% 45%, #000, transparent);
    pointer-events: none
}

.ap-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none
}

.ap-blob.a {
    width: 560px;
    height: 560px;
    right: -120px;
    top: -40px;
    background: var(--p);
    opacity: .28
}

.ap-blob.b {
    width: 380px;
    height: 380px;
    left: -120px;
    bottom: -60px;
    background: #c9f5c9;
    opacity: .5
}

.ap-hero-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 70px);
    align-items: center;
    width: 100%
}

.ap-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 12.5px Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 32px
}

.ap-eyebrow i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3fe33f;
    box-shadow: 0 0 0 0 #3fe33f99;
    animation: apping 2s infinite
}

@keyframes apping {
    70% {
        box-shadow: 0 0 0 10px #3fe33f00
    }
}

.ap-h1 {
    font-size: clamp(40px, 5.6vw, 96px);
    line-height: .92
}

.ap-ln {
    display: block;
    overflow: hidden;
    padding: .04em 0 .12em;
    margin-bottom: -.12em
}

.ap-lt {
    display: block;
    white-space: nowrap
}

.ap-h1 em {
    font-style: normal;
    color: var(--p)
}

.ap-lead {
    font-size: clamp(17px, 1.5vw, 21px);
    color: #4a4b55;
    max-width: 42ch;
    margin: 26px 0 26px !important;
    line-height: 1.55
}

.ap-os {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 99px;
    background: #fff;
    box-shadow: 0 0 0 1px #0a0b1412;
    margin-bottom: 26px
}

.ap-os span {
    display: block;
    font: 500 12px Inter, sans-serif;
    color: #77758a;
    padding: 0 10px 0 14px;
    letter-spacing: .06em;
    text-transform: uppercase
}

.ap-os button {
    border: 0;
    background: transparent;
    font: 600 15px var(--font-inter), Inter, sans-serif;
    padding: 10px 20px;
    border-radius: 99px;
    cursor: pointer;
    color: var(--ink);
    transition: background .4s, color .4s
}

.ap-os button.on {
    background: var(--p);
    color: #fff
}

.ap-cta,
.ap-cta2 {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center
}

.ap-stage {
    position: relative;
    width: 100%;
    max-width: 700px;
    margin-left: auto;
    aspect-ratio: 1/.98
}

.ap-layer {
    position: absolute;
    inset: 0;
    pointer-events: none
}

.ap-p {
    position: absolute
}

.ap-p.main {
    left: 29%;
    top: 1%;
    width: 43%;
    z-index: 3
}

.ap-p.l {
    left: 0;
    top: 20%;
    width: 31%;
    transform: rotate(-8deg);
    z-index: 1
}

.ap-p.r {
    right: 0;
    top: 24%;
    width: 31%;
    transform: rotate(8deg);
    z-index: 1
}

.ap-slides {
    position: absolute;
    inset: 0
}

.ap-slides>* {
    position: absolute;
    inset: 0
}

.ap-dots {
    position: absolute;
    left: 50%;
    bottom: -2.4rem;
    transform: translateX(-50%);
    display: flex;
    gap: 8px
}

.ap-dots i {
    width: 8px;
    height: 8px;
    border-radius: 9px;
    background: #0a0b1428;
    transition: all .5s var(--ox)
}

.ap-dots i.on {
    width: 28px;
    background: var(--p)
}

.ap-toast {
    position: absolute;
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 18px 11px 11px;
    border-radius: 18px;
    background: #ffffffe8;
    backdrop-filter: blur(12px);
    color: var(--ink);
    box-shadow: 0 18px 40px -14px #3f3d7a88, 0 0 0 1px #0a0b1410
}

.ap-toast i {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--p);
    color: #fff;
    display: grid;
    place-items: center;
    font: 700 14px Inter, sans-serif;
    font-style: normal;
    flex: none
}

.ap-toast span {
    display: grid;
    line-height: 1.2
}

.ap-toast b {
    font: 700 13px var(--font-inter), Inter, sans-serif
}

.ap-toast small {
    font: 400 11px Inter, sans-serif;
    color: #77758a
}

.ap-toast.t1 {
    left: -4%;
    top: 10%
}

.ap-toast.t2 {
    right: -3%;
    top: 46%
}

.ap-toast.t3 {
    left: 2%;
    bottom: 12%
}

.ap-tag {
    position: absolute;
    left: 50%;
    bottom: -3rem;
    transform: translateX(-50%);
    font: 500 11px Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #77758a;
    white-space: nowrap
}

/* ---------- what we build ---------- */
.ap-build {
    background: #fff
}

.ap-acc {
    display: flex;
    gap: 16px;
    height: min(70vh, 620px);
    margin-top: clamp(36px, 5vw, 60px)
}

.ap-ac {
    position: relative;
    flex: 1;
    min-width: 0;
    border-radius: 32px;
    overflow: hidden;
    padding: clamp(22px, 2.4vw, 40px);
    cursor: pointer;
    transition: flex .9s var(--ex);
    outline: none
}

.ap-ac.on {
    flex: 3.2
}

.ap-ac:focus-visible {
    box-shadow: 0 0 0 3px var(--pl)
}

.ap-ac.a0 {
    background: var(--p);
    color: #fff
}

.ap-ac.a1 {
    background: var(--ink);
    color: #fff
}

.ap-ac.a2 {
    background: var(--pb);
    color: var(--ink)
}

.ap-ac-h span {
    font: 600 14px Inter, sans-serif;
    opacity: .6
}

.ap-ac-h h3 {
    font-size: clamp(26px, 3vw, 50px);
    margin-top: 10px;
    max-width: 8ch
}

.ap-ac-x {
    max-width: 28ch;
    margin-top: 22px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity .6s var(--ox), transform .6s var(--ox)
}

.ap-ac.on .ap-ac-x {
    opacity: 1;
    transform: none;
    transition-delay: .35s
}

.ap-ac-x p {
    font-size: clamp(16px, 1.25vw, 18px);
    line-height: 1.5;
    opacity: .88
}

.ap-ac ul,
.ap-eb ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 18px 0 0
}

.ap-ac li,
.ap-eb li {
    padding: 8px 16px;
    border-radius: 99px;
    box-shadow: inset 0 0 0 1px currentColor;
    font: 500 13px Inter, sans-serif;
    opacity: .8
}

.ap-ac-ph {
    position: absolute;
    right: 14%;
    bottom: -14%;
    width: min(70%, 270px);
    opacity: .6;
    transition: opacity .7s, width .9s var(--ex), right .9s var(--ex)
}

.ap-ac.on .ap-ac-ph {
    opacity: 1;
    right: 7%;
    width: min(40%, 270px)
}

/* ---------- expertise: pinned phone ---------- */
.ap-ex-in {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(30px, 6vw, 100px)
}

.ap-ex-l {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    place-items: center;
    align-self: start
}

.ap-ex-phone {
    width: min(72%, 320px)
}

.ap-ex-screens {
    position: absolute;
    inset: 0
}

.ap-ex-screens>* {
    clip-path: inset(100% 0 0 0);
    transition: clip-path .9s var(--ex)
}

.ap-ex-screens>*:first-child,
.ap-ex-screens>*.on {
    clip-path: inset(0)
}

.ap-ex-photo {
    position: absolute;
    left: 0;
    bottom: 10%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: .5rem solid var(--cr);
    box-shadow: 0 20px 50px -18px #3f3d7a88
}

.ap-ex-prog {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    gap: 10px
}

.ap-ex-prog i {
    width: 8px;
    height: 8px;
    border-radius: 9px;
    background: #0a0b1428;
    transition: all .5s var(--ox)
}

.ap-ex-prog i.on {
    height: 30px;
    background: var(--p)
}

.ap-ex-r .ap-h2 {
    margin-bottom: clamp(20px, 4vw, 50px)
}

.ap-eb {
    min-height: 84vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: .22;
    transition: opacity .6s
}

.ap-eb.on {
    opacity: 1
}

.ap-eb span {
    font: 600 14px Inter, sans-serif;
    color: var(--p)
}

.ap-eb h3 {
    font-size: clamp(30px, 3.8vw, 62px);
    margin: 10px 0 14px
}

.ap-eb p {
    font-size: clamp(16px, 1.4vw, 20px);
    color: #4a4b55;
    max-width: 34ch;
    line-height: 1.5
}

.ap-eb li {
    color: var(--p2)
}

.ap-eb-img {
    width: 100%;
    max-width: 560px;
    aspect-ratio: 16/10;
    border-radius: 26px;
    margin-top: 28px
}

/* ---------- showcase ---------- */
.ap-show {
    position: relative;
    background: var(--ink);
    color: #fff
}

.ap-show-pin {
    position: relative;
    padding: clamp(72px, 9vw, 130px) 0
}

.ap-show .ap-h2 {
    max-width: 14ch !important
}

.ap-note {
    font: 500 12px Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #bcb9e0;
    margin-top: 16px
}

.ap-ringw {
    margin-top: 40px
}

.ap-ring {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 clamp(20px, 8vw, 120px) 20px;
    scrollbar-width: none
}

.ap-ring::-webkit-scrollbar {
    display: none
}

.ap-rp {
    flex: 0 0 min(56vw, 230px);
    scroll-snap-align: center
}

.ap-show-photo {
    display: block;
    width: calc(100% - 2*clamp(20px, 8vw, 120px));
    margin: 28px auto 0;
    aspect-ratio: 16/8;
    border-radius: 26px
}

.ap-show-photo.b {
    display: none
}

.ap-h .ap-show-pin {
    height: 100vh;
    padding: 0;
    overflow: hidden
}

.ap-h .ap-show-head {
    position: absolute;
    top: calc(76px + 3vh);
    left: 0;
    right: 0;
    z-index: 3
}

.ap-h .ap-show .ap-h2 {
    font-size: clamp(28px, 3vw, 52px)
}

.ap-h .ap-ringw {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    --w: min(17vw, 290px)
}

.ap-h .ap-ring {
    position: relative;
    display: block;
    overflow: visible;
    padding: 0;
    width: var(--w);
    height: calc(var(--w)*2.13);
    margin-top: 9vh;
    transform-style: preserve-3d
}

.ap-h .ap-rp {
    position: absolute;
    inset: 0;
    width: 100%;
    flex: none;
    transform: rotateY(calc(var(--i)*60deg)) translateZ(calc(var(--w)*1.3));
    backface-visibility: hidden
}

.ap-h .ap-show-photo {
    position: absolute;
    width: min(15vw, 270px);
    margin: 0;
    aspect-ratio: 4/3;
    z-index: 2;
    bottom: 6%
}

.ap-h .ap-show-photo.a {
    right: 5%
}

.ap-h .ap-show-photo.b {
    display: block;
    left: 5%
}

/* ---------- process ---------- */
.ap-pbox {
    position: relative;
    margin-top: clamp(36px, 5vw, 70px);
    display: grid;
    gap: 8px
}

.ap-pv,
.ap-trav {
    display: none
}

.ap-pstep {
    position: relative;
    padding: 0 0 26px 62px
}

.ap-pstep b {
    position: absolute;
    left: 0;
    top: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--cr);
    box-shadow: inset 0 0 0 2px #0a0b1424;
    font: 700 15px var(--font-inter), Inter, sans-serif;
    transition: .5s
}

.ap-pstep .c h3 {
    font-size: clamp(24px, 2.2vw, 34px)
}

.ap-pstep .c p {
    color: #4a4b55;
    font-size: 15px;
    line-height: 1.4;
    margin-top: 6px
}

.ap-pstep.on b {
    background: var(--p);
    color: #fff;
    box-shadow: 0 0 0 7px #6a67ae26
}

.ap-h .ap-pbox {
    display: block;
    aspect-ratio: 1200/520;
    margin-bottom: 60px
}

.ap-h .ap-pv {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible
}

.ap-pv path {
    fill: none;
    stroke: var(--p);
    stroke-width: 4;
    stroke-linecap: round
}

.ap-pv path.bg {
    stroke: #0a0b141f;
    stroke-dasharray: 3 9
}

.ap-h .ap-trav {
    display: block;
    position: absolute;
    z-index: 4;
    width: 30px;
    height: 54px;
    border-radius: 9px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    box-shadow: 0 14px 26px -8px #3f3d7a99, inset 0 0 0 2px #2b2c38
}

.ap-trav i {
    position: absolute;
    inset: 4px;
    border-radius: 6px;
    background: linear-gradient(160deg, var(--pl), var(--p))
}

.ap-h .ap-pstep {
    position: absolute;
    width: 42px;
    height: 42px;
    padding: 0;
    transform: translate(-50%, -50%)
}

.ap-h .ap-pstep b {
    position: relative
}

.ap-h .ap-pstep .c {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(150px, 16vw, 240px);
    text-align: center;
    opacity: .35;
    transition: opacity .6s
}

.ap-h .ap-pstep.on .c {
    opacity: 1
}

.ap-h .ap-pstep.up .c {
    bottom: calc(100% + 22px)
}

.ap-h .ap-pstep.down .c {
    top: calc(100% + 22px)
}

/* ---------- tech ---------- */
.ap-tech {
    background: var(--ink);
    color: #fff;
    overflow: hidden
}

.ap-tech-bg {
    position: absolute;
    inset: -12% 0;
    opacity: .22;
    pointer-events: none
}

.ap-tech .ap-wrap {
    position: relative;
    z-index: 1
}

.ap-tech .ap-h2 {
    max-width: 14ch !important
}

.ap-field {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 50px
}

.ap-ci {
    display: flex;
    flex-direction: column;
    padding: 16px 26px;
    border-radius: 22px;
    background: #ffffff14;
    backdrop-filter: blur(10px);
    box-shadow: inset 0 0 0 1px #ffffff2e;
    white-space: nowrap;
    transition: background .4s
}

.ap-ci b {
    font: 800 clamp(22px, 2.4vw, 38px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em
}

.ap-ci small {
    font: 500 12px Inter, sans-serif;
    color: #bcb9e0;
    margin-top: 6px
}

.ap-chip:hover .ap-ci {
    background: var(--p)
}

.ap-h .ap-field {
    display: block;
    position: relative;
    height: clamp(380px, 44vw, 580px)
}

.ap-h .ap-chip {
    position: absolute;
    left: var(--x);
    top: var(--y)
}

/* ---------- why ---------- */
.ap-why {
    background: #fff
}

.ap-why-in {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(30px, 6vw, 100px)
}

.ap-why-l {
    position: sticky;
    top: 110px;
    align-self: start
}

.ap-big {
    font: 800 clamp(130px, 18vw, 320px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.08em;
    color: var(--p)
}

.ap-bigs {
    font: 600 clamp(18px, 1.8vw, 26px)/1.2 var(--font-inter), Inter, sans-serif;
    margin-top: 18px;
    max-width: 16ch
}

.ap-why-img {
    width: 100%;
    max-width: 520px;
    aspect-ratio: 16/10;
    border-radius: 28px;
    margin-top: 32px
}

.ap-wy {
    position: relative;
    padding: 34px 0 40px 56px
}

.ap-wl {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--ink);
    transform-origin: left
}

.ap-wy span {
    position: absolute;
    left: 0;
    top: 38px;
    font: 600 14px Inter, sans-serif;
    color: var(--p)
}

.ap-wy h3 {
    font-size: clamp(24px, 2.6vw, 40px);
    margin-bottom: 8px
}

.ap-wy p {
    color: #4a4b55;
    max-width: 36ch;
    line-height: 1.5
}

.ap-why-n {
    padding: 26px 0 0 56px;
    border-top: 1px solid #0a0b1420;
    color: #4a4b55;
    max-width: 46ch;
    line-height: 1.5
}

/* ---------- faq ---------- */
.ap-faq-in {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(30px, 6vw, 100px)
}

.ap-faq-in .ap-h2 {
    max-width: 11ch !important
}

.ap-faq-h {
    position: sticky;
    top: 110px;
    align-self: start
}

.ap-q {
    border-top: 1px solid #0a0b1420
}

.ap-q:last-child {
    border-bottom: 1px solid #0a0b1420
}

.ap-q button {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    color: var(--ink);
    font: 600 clamp(18px, 1.6vw, 24px)/1.2 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.ap-q button:focus-visible {
    outline: 2px solid var(--p);
    outline-offset: 4px
}

.ap-q button i {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--pb);
    position: relative;
    transition: transform .5s var(--ox), background .3s
}

.ap-q button i::before,
.ap-q button i::after {
    content: "";
    position: absolute;
    left: 11px;
    right: 11px;
    top: 17px;
    height: 2px;
    background: var(--p)
}

.ap-q button i::after {
    transform: rotate(90deg)
}

.ap-q.open button i {
    transform: rotate(45deg);
    background: var(--p)
}

.ap-q.open button i::before,
.ap-q.open button i::after {
    background: #fff
}

.ap-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .6s var(--ox)
}

.ap-q.open .ap-a {
    grid-template-rows: 1fr
}

.ap-a>p {
    overflow: hidden;
    min-height: 0;
    color: #4a4b55;
    max-width: 60ch;
    line-height: 1.55
}

.ap-q.open .ap-a>p {
    padding-bottom: 24px
}

/* ---------- cta ---------- */
.ap-cta-sec {
    position: relative;
    overflow: hidden;
    background: var(--p);
    color: #fff;
    padding: clamp(90px, 12vw, 170px) 0
}

.ap-cta-in {
    position: relative;
    z-index: 2
}

.ap-mega {
    font-size: clamp(40px, 6.6vw, 112px);
    line-height: .92;
    max-width: 11ch !important
}

.ap-sub {
    font-size: clamp(17px, 1.6vw, 22px);
    color: #ffffffd9;
    max-width: 36ch;
    margin: 30px 0 34px !important;
    line-height: 1.5
}

.ap-cta-ph {
    position: absolute;
    right: 7%;
    top: 12%;
    width: min(22vw, 300px);
    z-index: 1
}

.ap-cta-sec>.ap-toast.ct1 {
    right: 25%;
    top: 22%
}

.ap-cta-sec>.ap-toast.ct2 {
    right: 3%;
    top: 62%
}

/* ---------- responsive ---------- */
@media(max-width:1100px) {
    .ap-h1 {
        font-size: clamp(40px, 6.4vw, 72px)
    }

    .ap-eb {
        min-height: 78vh
    }
}

@media(max-width:900px) {
    .ap-hero {
        min-height: auto;
        padding-bottom: clamp(70px, 12vw, 110px)
    }

    .ap-hero-in {
        grid-template-columns: 1fr
    }

    .ap-stage {
        max-width: 520px;
        margin: 10px auto 44px
    }

    .ap-h1 {
        font-size: clamp(40px, 10.4vw, 80px)
    }

    .ap-lt {
        white-space: normal
    }

    .ap-acc {
        flex-direction: column;
        height: auto
    }

    .ap-ac,
    .ap-ac.on {
        flex: none
    }

    .ap-ac-x {
        opacity: 1;
        transform: none
    }

    .ap-ac .ap-ac-ph,
    .ap-ac.on .ap-ac-ph {
        position: relative;
        right: auto;
        bottom: auto;
        width: 52%;
        max-width: 240px;
        margin: 24px auto -22%;
        opacity: 1
    }

    .ap-ac-h h3 {
        max-width: none
    }

    .ap-ex-in {
        grid-template-columns: clamp(104px, 22vw, 220px) minmax(0, 1fr);
        gap: clamp(18px, 4vw, 40px)
    }

    .ap-ex-l {
        height: auto;
        position: sticky;
        top: 84px;
        display: block
    }

    .ap-ex-phone {
        width: 100%
    }

    .ap-ex-photo,
    .ap-ex-prog {
        display: none
    }

    .ap-eb {
        min-height: 70vh
    }

    .ap-eb h3 {
        font-size: clamp(26px, 6.4vw, 40px)
    }

    .ap-why-in,
    .ap-faq-in {
        grid-template-columns: 1fr
    }

    .ap-why-l,
    .ap-faq-h {
        position: relative;
        top: auto
    }

    .ap-cta-ph {
        width: 34vw;
        max-width: 220px;
        right: 2%;
        top: 6%;
        opacity: .5
    }

    .ap-mega {
        font-size: clamp(38px, 10vw, 76px)
    }
}

@media(max-width:600px) {
    .ap-eb {
        min-height: 60vh
    }

    .ap-toast.t2,
    .ap-toast.t3 {
        display: none
    }

    .ap-toast.t1 {
        left: 0
    }

    .ap-btn {
        height: 54px;
        padding: 0 22px;
        font-size: 16px
    }

    .ap-cta-sec>.ap-toast {
        display: none
    }

    .ap-h2 {
        font-size: clamp(32px, 9vw, 44px)
    }

    .ap-show-photo {
        aspect-ratio: 4/3
    }
}

@media(prefers-reduced-motion:reduce) {
    .ap * {
        animation: none !important
    }

    .ap-eb {
        opacity: 1
    }

    .ap-ex-screens>* {
        clip-path: inset(0) !important
    }
}