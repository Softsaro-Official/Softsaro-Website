/* ===== WEB DEV PAGE ===== */
.wd-page {
    overflow-x: clip
}

.wd-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: .04em 0 .16em;
    margin-bottom: -.16em
}

.wd-i {
    display: inline-block;
    will-change: transform
}

.wd-h2 {
    font: 800 clamp(34px, 5vw, 76px)/.98 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    max-width: 15ch;
    margin-top: 26px
}

.wd-h2 b {
    color: var(--blue)
}

.wd-h2.mega {
    font-size: clamp(44px, 7.4vw, 118px);
    max-width: 11ch;
    color: #fff
}

.wd-dark .wd-h2,
.wd-why .wd-h2,
.wd-cta .wd-h2 {
    color: #fff
}

.wd-dark .wd-h2 b,
.wd-why .wd-h2 b {
    color: #b0add9
}

.wd-cta .wd-h2 b {
    color: var(--green)
}

.wd-ph {
    position: relative;
    display: block;
    overflow: hidden;
    background: linear-gradient(135deg, #9d9bd4, var(--blue2))
}

.wd-ph img,
.wd-px img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover
}

.wd-px {
    position: relative;
    overflow: hidden
}

.wd-px img {
    inset: -9% 0 auto 0;
    height: 118%
}

/* hero */
.wd-hero {
    padding: clamp(120px, 13vw, 170px) 0 clamp(70px, 9vw, 120px);
    overflow: visible
}

.wd-hero .wrap {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: clamp(24px, 4vw, 70px);
    align-items: center
}

.wd-hero h1 {
    white-space: normal;
    font-size: clamp(40px, 5.2vw, 84px);
    line-height: .96;
    letter-spacing: -.055em;
    max-width: 11ch
}

.wd-hero h1 b {
    color: var(--blue)
}

.wd-hero .eyebrow {
    margin-bottom: 26px
}

.wd-hero .sub {
    max-width: 33em
}

.wd-facts {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    margin-top: 42px;
    padding-top: 26px;
    border-top: 1px solid var(--line)
}

.wd-facts b {
    display: block;
    font: 800 clamp(26px, 2.6vw, 38px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    color: var(--blue)
}

.wd-facts small {
    font-size: 13px;
    color: #555a70
}

.wd-collage {
    position: relative;
    width: 100%;
    max-width: 700px;
    margin: 0 auto;
    aspect-ratio: 1/.9
}

.wd-blob {
    position: absolute;
    inset: 4% 0 2% 8%;
    border-radius: 44% 56% 52% 48%/50% 44% 56% 50%;
    background: linear-gradient(145deg, #9d9bd4, var(--blue) 55%, var(--blue2));
    box-shadow: 0 50px 80px -30px #6a67ae88
}

.wd-l {
    position: absolute
}

.wd-main {
    left: 2%;
    top: 8%;
    width: 80%
}

.wd-phone {
    right: 0;
    bottom: 0;
    width: 23%
}

.wd-code {
    left: -3%;
    bottom: 6%;
    width: 44%
}

.wd-chip {
    padding: 9px 16px;
    border-radius: 99px;
    background: #fff;
    font: 600 clamp(11px, 1vw, 14px) var(--font-inter), Inter, sans-serif;
    box-shadow: 0 18px 36px -14px #3b397888
}

.wd-chip.wd-c1 {
    right: 2%;
    top: 2%
}

.wd-chip.wd-c2 {
    left: 30%;
    bottom: -2%;
    background: var(--ink);
    color: #fff
}

/* browser / mockups */
.wd-win {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid #fff;
    box-shadow: 0 40px 70px -28px #3b3978b0
}

.wd-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    background: #1a1d2b;
    color: #c9cbd9;
    font-size: 10px
}

.wd-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff5f57
}

.wd-bar i:nth-child(2) {
    background: #febc2e
}

.wd-bar i:nth-child(3) {
    background: #28c840
}

.wd-bar span {
    margin-left: 12px;
    padding: 3px 12px;
    border-radius: 99px;
    background: #ffffff1a;
    letter-spacing: .02em
}

.wd-site,
.wd-list {
    padding: clamp(10px, 1.4vw, 18px)
}

.wd-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(10px, 1.4vw, 18px)
}

.wd-nav b {
    width: clamp(34px, 4vw, 56px);
    height: 10px;
    border-radius: 5px;
    background: var(--blue);
    margin-right: auto
}

.wd-nav span {
    width: clamp(18px, 2.4vw, 34px);
    height: 6px;
    border-radius: 4px;
    background: #0a0b1426
}

.wd-nav em {
    width: clamp(28px, 3.4vw, 48px);
    height: 14px;
    border-radius: 99px;
    background: var(--ink)
}

.wd-herom {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(8px, 1.2vw, 16px);
    align-items: center
}

.wd-herom .wd-ph {
    aspect-ratio: 4/3;
    border-radius: 12px
}

.wd-sk {
    display: block;
    border-radius: 5px;
    background: #0a0b1418;
    height: clamp(5px, .7vw, 9px);
    margin-bottom: 8px
}

.wd-sk.k1 {
    height: clamp(9px, 1.3vw, 16px);
    width: 92%;
    background: var(--ink)
}

.wd-sk.k2 {
    height: clamp(9px, 1.3vw, 16px);
    width: 62%;
    background: var(--blue)
}

.wd-sk.k3 {
    width: 80%
}

.wd-sk.k4 {
    width: 36%;
    height: clamp(12px, 1.6vw, 20px);
    border-radius: 99px;
    background: var(--blue);
    margin-top: 12px
}

.wd-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(6px, .9vw, 12px);
    margin-top: clamp(10px, 1.4vw, 18px)
}

.wd-3 i {
    height: clamp(26px, 4vw, 54px);
    border-radius: 10px;
    background: var(--cream2)
}

.wd-codecard {
    background: #14162a;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 30px 50px -20px #0a0b14aa
}

.wd-codecard pre {
    margin: 0;
    padding: 12px 14px 16px;
    font: 500 clamp(9px, .9vw, 12px)/1.7 ui-monospace, Menlo, Consolas, monospace;
    color: #b0add9;
    white-space: pre
}

.wd-phonebody {
    position: relative;
    background: #14162a;
    border-radius: clamp(18px, 2.2vw, 30px);
    padding: 6px;
    box-shadow: 0 30px 50px -18px #0a0b14aa;
    aspect-ratio: 9/18
}

.wd-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 30%;
    height: 5px;
    margin-left: -15%;
    border-radius: 9px;
    background: #14162a;
    z-index: 2
}

.wd-pscreen {
    height: 100%;
    background: #fff;
    border-radius: clamp(14px, 1.8vw, 24px);
    padding: clamp(8px, 1vw, 14px);
    overflow: hidden
}

.wd-pscreen .wd-nav {
    margin: 6px 0 10px
}

.wd-pscreen .wd-ph {
    aspect-ratio: 1;
    border-radius: 10px;
    margin-bottom: 10px
}

.wd-pscreen .wd-3 {
    grid-template-columns: repeat(2, 1fr)
}

.wd-dash {
    display: grid;
    grid-template-columns: 22% 1fr;
    min-height: clamp(150px, 20vw, 290px)
}

.wd-dash aside {
    background: #14162a;
    padding: 12px 10px;
    display: grid;
    align-content: start;
    gap: 8px
}

.wd-dash aside b {
    height: 10px;
    border-radius: 5px;
    background: var(--blue);
    margin-bottom: 6px
}

.wd-dash aside i {
    height: 7px;
    border-radius: 4px;
    background: #ffffff26
}

.wd-dash>div {
    padding: clamp(8px, 1.2vw, 16px)
}

.wd-kpi {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px
}

.wd-kpi i {
    height: clamp(22px, 3vw, 40px);
    border-radius: 10px;
    background: var(--cream2)
}

.wd-chart {
    display: block;
    width: 100%;
    height: clamp(54px, 8vw, 110px);
    margin: 12px 0 8px
}

.wd-rows {
    display: grid;
    gap: 7px
}

.wd-rows i {
    height: 8px;
    border-radius: 4px;
    background: #0a0b1418
}

.wd-search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px
}

.wd-search i {
    flex: 1;
    height: clamp(14px, 1.8vw, 22px);
    border-radius: 99px;
    background: var(--cream2)
}

.wd-search b {
    width: clamp(30px, 4vw, 56px);
    height: clamp(14px, 1.8vw, 22px);
    border-radius: 99px;
    background: var(--blue)
}

.wd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(7px, 1vw, 12px)
}

.wd-grid div i {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: #0a0b1426;
    margin-top: 7px
}

.wd-grid div i.s {
    width: 55%
}

.wd-t {
    display: block;
    aspect-ratio: 4/3;
    border-radius: 10px;
    background: linear-gradient(135deg, #b0add9, var(--blue))
}

.wd-t.wd-t1 {
    background: linear-gradient(135deg, #d6d4ee, #9d9bd4)
}

.wd-t.wd-t2 {
    background: linear-gradient(135deg, #9d9bd4, var(--blue2))
}

.wd-t.wd-t3 {
    background: linear-gradient(135deg, #ebe6dc, #b0add9)
}

/* what we build */
.wd-build {
    background: var(--cream)
}

.wd-cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(40px, 5vw, 64px)
}

.wd-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 30px;
    background: #fff;
    padding: clamp(26px, 3vw, 44px);
    min-height: clamp(280px, 26vw, 350px);
    display: flex;
    flex-direction: column;
    transition: color .5s, transform .7s var(--o)
}

.wd-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--blue);
    transform: translateY(101%);
    transition: transform .7s var(--o)
}

.wd-card:hover::before {
    transform: translateY(0)
}

.wd-card:hover {
    color: #fff;
    transform: translateY(-6px)
}

.wd-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: auto;
    padding-bottom: 40px
}

.wd-card-top small {
    font: 500 13px Inter, sans-serif;
    color: #888;
    transition: color .4s
}

.wd-card:hover small {
    color: var(--green)
}

.wd-ico {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: grid;
    place-items: center;
    background: var(--cream);
    color: var(--blue);
    transition: background .4s, color .4s
}

.wd-card:hover .wd-ico {
    background: #ffffff26;
    color: #fff
}

.wd-card h3 {
    font: 800 clamp(24px, 2.3vw, 34px)/1.05 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    margin-bottom: 12px
}

.wd-card p {
    color: #4a4b55;
    max-width: 36ch;
    transition: color .4s
}

.wd-card:hover p {
    color: #ecebf7
}

.wd-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px
}

.wd-tags span {
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 99px;
    border: 1px solid var(--line);
    transition: border-color .4s
}

.wd-card:hover .wd-tags span {
    border-color: #ffffff55
}

.wd-forlab {
    margin: clamp(40px, 5vw, 64px) 0 16px;
    font: 600 13px Inter, sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #555a70
}

.wd-for {
    display: flex;
    flex-wrap: wrap;
    gap: 10px
}

.wd-for li {
    padding: 10px 20px;
    border-radius: 99px;
    background: var(--cream2);
    font-weight: 500;
    transition: background .3s, color .3s, transform .5s var(--o)
}

.wd-for li:hover {
    background: var(--blue);
    color: #fff;
    transform: translateY(-3px)
}

/* expertise (dark) */
.wd-dark {
    background: var(--ink);
    color: #fff
}

.wd-split {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(30px, 6vw, 100px);
    align-items: start
}

.wd-sticky {
    position: sticky;
    top: 110px
}

.wd-arch {
    margin-top: clamp(28px, 3vw, 44px);
    aspect-ratio: 4/4.6;
    border-radius: 200px 200px 28px 28px;
    background: linear-gradient(160deg, #9d9bd4, var(--blue2))
}

.wd-xrows li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(14px, 2vw, 30px);
    align-items: center;
    padding: clamp(22px, 2.6vw, 36px) 0;
    border-top: 1px solid #ffffff26;
    transition: padding .5s var(--o), background .4s
}

.wd-xrows li:last-child {
    border-bottom: 1px solid #ffffff26
}

.wd-xrows small {
    font: 500 13px Inter, sans-serif;
    color: var(--green)
}

.wd-xrows h3 {
    font: 800 clamp(24px, 2.8vw, 42px)/1.05 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.045em;
    transition: color .4s
}

.wd-xrows p {
    color: #c9cbd9;
    margin-top: 8px;
    max-width: 38ch
}

.wd-xrows svg {
    color: #8b88c8;
    transition: transform .5s var(--o), color .4s
}

.wd-xrows li:hover {
    padding-left: clamp(10px, 1.6vw, 24px)
}

.wd-xrows li:hover h3 {
    color: #b0add9
}

.wd-xrows li:hover svg {
    transform: translate(4px, -4px);
    color: #fff
}

/* showcase */
.wd-show {
    padding-bottom: 0
}

.wd-stage {
    position: relative;
    height: clamp(440px, 58vw, 780px);
    margin-top: clamp(40px, 5vw, 70px)
}

.wd-s {
    position: absolute
}

.wd-s.wd-s1 {
    left: 0;
    top: 14%;
    width: 35%
}

.wd-s.wd-s2 {
    left: 21%;
    top: 0;
    width: 58%;
    z-index: 2
}

.wd-s.wd-s3 {
    right: 0;
    top: 18%;
    width: 35%
}

.wd-s.wd-s4 {
    right: 19%;
    bottom: -3%;
    width: 13%;
    z-index: 3
}

.wd-s.wd-s2 .wd-win {
    box-shadow: 0 60px 100px -30px #3b3978cc
}

.wd-caps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 3vw, 44px);
    margin: clamp(40px, 5vw, 70px) 0 clamp(60px, 8vw, 110px)
}

.wd-caps li {
    border-top: 1px solid var(--ink);
    padding-top: 16px
}

.wd-caps b {
    display: block;
    font: 700 clamp(18px, 1.6vw, 24px) var(--font-inter), Inter, sans-serif;
    letter-spacing: -.03em;
    margin-bottom: 6px
}

.wd-caps span {
    color: #4a4b55
}

.wd-band {
    height: clamp(300px, 42vw, 560px);
    background: linear-gradient(160deg, #9d9bd4, var(--blue2));
    display: grid;
    align-items: end
}

.wd-band p {
    position: relative;
    z-index: 2;
    padding: clamp(24px, 4vw, 64px);
    font: 800 clamp(30px, 5vw, 76px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    color: #fff;
    max-width: 14ch
}

.wd-band::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, transparent 35%, #0a0b1499)
}

/* process */
.wd-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(14px, 2vw, 28px);
    margin-top: clamp(50px, 6vw, 80px)
}

.wd-line {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 22px;
    height: 2px;
    background: var(--line)
}

.wd-line i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: 0 0
}

.wd-step {
    position: relative
}

.wd-step b {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--cream);
    border: 2px solid var(--line);
    font: 700 14px Inter, sans-serif;
    position: relative;
    z-index: 1;
    transition: background .5s, color .5s, border-color .5s
}

.wd-step h3 {
    font: 800 clamp(22px, 2.2vw, 32px) var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    margin: 22px 0 8px;
    opacity: .3;
    transition: opacity .5s
}

.wd-step p {
    color: #4a4b55;
    opacity: .3;
    transition: opacity .5s;
    max-width: 24ch
}

.wd-step.on b {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    box-shadow: 0 0 0 8px #6a67ae22
}

.wd-step.on h3,
.wd-step.on p {
    opacity: 1
}

/* why */
.wd-why {
    background: var(--blue);
    color: #fff
}

.wd-why-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    grid-auto-rows: minmax(220px, auto);
    gap: clamp(14px, 2vw, 22px);
    margin-top: clamp(40px, 5vw, 64px)
}

.wd-big {
    grid-row: span 2;
    border-radius: 30px;
    background: var(--ink);
    padding: clamp(26px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: space-between
}

.wd-big b {
    font: 800 clamp(90px, 12vw, 190px)/.85 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.07em;
    color: #b0add9
}

.wd-big p {
    color: #c9cbd9;
    max-width: 26ch
}

.wd-wc {
    border-radius: 30px;
    background: #ffffff14;
    border: 1px solid #ffffff30;
    padding: clamp(22px, 2.4vw, 34px);
    display: flex;
    flex-direction: column;
    transition: background .4s, transform .6s var(--o)
}

.wd-wc:hover {
    background: #ffffff26;
    transform: translateY(-6px)
}

.wd-wc small {
    font: 500 13px Inter, sans-serif;
    color: var(--green)
}

.wd-wc h3 {
    font: 800 clamp(20px, 1.9vw, 28px)/1.1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    margin: auto 0 8px
}

.wd-wc p {
    color: #ecebf7
}

/* tech */
.wd-pills {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(10px, 1.4vw, 18px);
    margin-top: clamp(36px, 4vw, 56px)
}

.wd-pills li {
    font: 700 clamp(20px, 2.6vw, 38px) var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    padding: clamp(12px, 1.4vw, 20px) clamp(22px, 2.6vw, 38px);
    border-radius: 99px;
    border: 1.5px solid var(--ink);
    transition: background .35s, color .35s, transform .6s var(--o), border-color .35s
}

.wd-pills li:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    transform: translateY(-6px) rotate(-2deg)
}

.wd-note {
    margin-top: 34px;
    color: #4a4b55;
    max-width: 46ch
}

/* faq */
.wd-faq {
    background: var(--cream2)
}

.wd-faqs {
    border-top: 1px solid var(--ink)
}

.wd-faqs details {
    border-bottom: 1px solid var(--line)
}

.wd-faqs summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    font: 600 clamp(17px, 1.5vw, 21px)/1.25 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.wd-faqs summary::-webkit-details-marker {
    display: none
}

.wd-faqs summary svg {
    flex: none;
    color: var(--blue);
    transition: transform .4s var(--o)
}

.wd-faqs details[open] summary svg {
    transform: rotate(135deg)
}

.wd-faqs details p {
    padding: 0 40px 24px 0;
    color: #4a4b55;
    max-width: 60ch
}

/* cta */
.wd-cta {
    background: var(--blue);
    color: #fff
}

.wd-ctagrid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(30px, 5vw, 80px);
    align-items: center
}

.wd-ctap {
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.4;
    color: #ecebf7;
    max-width: 30em;
    margin: 26px 0 34px
}

.wd-meta {
    margin-top: 30px;
    color: #dedcf1;
    font-size: 15px
}

.wd-meta a {
    text-decoration: underline;
    text-underline-offset: 4px
}

.wd-ctaph {
    aspect-ratio: 4/5;
    border-radius: 32px;
    background: linear-gradient(160deg, #9d9bd4, var(--blue2));
    transform: rotate(3deg);
    box-shadow: 0 50px 90px -30px #0a0b1488
}

@media (max-width:1000px) {

    .wd-hero .wrap,
    .wd-split,
    .wd-ctagrid {
        grid-template-columns: 1fr
    }

    .wd-hero h1 {
        max-width: none
    }

    .wd-sticky {
        position: static
    }

    .wd-arch {
        max-width: 420px
    }

    .wd-why-grid {
        grid-template-columns: 1fr 1fr
    }

    .wd-big {
        grid-column: 1/-1;
        grid-row: auto;
        min-height: 260px
    }

    .wd-steps {
        grid-template-columns: 1fr;
        gap: 34px;
        padding-left: 4px
    }

    .wd-line {
        left: 22px;
        right: auto;
        top: 22px;
        bottom: 30px;
        width: 2px;
        height: auto
    }

    .wd-line i {
        width: 100%;
        height: 100%;
        transform-origin: 0 0
    }

    .wd-step {
        padding-left: 70px
    }

    .wd-step b {
        position: absolute;
        left: 0;
        top: 0
    }

    .wd-step h3 {
        margin-top: 0
    }
}

@media (max-width:700px) {

    .wd-cards,
    .wd-why-grid,
    .wd-caps {
        grid-template-columns: 1fr
    }

    .wd-stage {
        height: auto;
        display: grid;
        gap: 22px
    }

    .wd-s {
        position: relative;
        inset: auto;
        width: 100% !important
    }

    .wd-s.wd-s4 {
        width: 46% !important;
        justify-self: center
    }

    .wd-facts {
        flex-wrap: wrap
    }

    .wd-code {
        display: none
    }

    .wd-xrows li {
        grid-template-columns: auto 1fr
    }

    .wd-xrows svg {
        display: none
    }
}

/* WX WEB DEV v2 */
.wx-page section {
    padding: 0;
    overflow: visible;
    position: relative
}

.wx-page h1,
.wx-page h2,
.wx-page h3 {
    max-width: none;
    white-space: normal
}

.wx-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: .14em;
    margin-bottom: -.14em
}

.wx-i {
    display: inline-block
}

.wx-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 600 12px/1 Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 clamp(18px, 2.4vw, 30px)
}

.wx-eyebrow i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green)
}

.wx-page .wx-h1 {
    font-size: clamp(46px, 8vw, 138px);
    line-height: .92;
    letter-spacing: -.06em;
    max-width: 15ch;
    margin: 0
}

.wx-h1 em {
    font-style: normal;
    color: var(--blue)
}

.wx-page .wx-h2 {
    font-size: clamp(34px, 5vw, 84px);
    line-height: .98;
    letter-spacing: -.05em;
    max-width: 16ch;
    margin: 18px 0 0
}

.wx-page .wx-h2.wx-big {
    font-size: clamp(40px, 6.4vw, 110px);
    max-width: 12ch
}

.wx-sub {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.5;
    color: #34353f;
    max-width: 34em;
    margin: 0
}

.wx-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px
}

.btn.wx-out {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink)
}

/* HERO */
.wx-hero {
    padding: clamp(120px, 12vw, 170px) 0 clamp(40px, 5vw, 70px)
}

.wx-hero-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: clamp(22px, 3vw, 40px)
}

.wx-stage {
    position: relative;
    width: min(1280px, 94vw);
    margin: clamp(30px, 4vw, 60px) auto 0;
    aspect-ratio: 16/8.4
}

.wx-l {
    position: absolute
}

.wx-blob {
    position: absolute;
    left: 30%;
    top: 6%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 46% 54% 50% 50%/52% 44% 56% 48%;
    background: radial-gradient(circle at 30% 25%, #9d9bd2, var(--blue) 55%, var(--blue2));
    filter: blur(.5px);
    opacity: .95
}

.wx-L1 {
    left: 4%;
    top: 2%;
    width: 60%;
    z-index: 2
}

.wx-L2 {
    left: 58%;
    top: 10%;
    width: 15.5%;
    z-index: 4
}

.wx-L3 {
    left: 0;
    bottom: 2%;
    width: 25%;
    z-index: 5
}

.wx-L4 {
    right: 1%;
    top: 0;
    width: 23%;
    z-index: 3
}

.wx-L5 {
    right: 3%;
    bottom: 0;
    width: 27%;
    z-index: 5
}

.wx-L6 {
    left: 43%;
    bottom: -3%;
    width: 9.5%;
    min-width: 84px;
    z-index: 6
}

.wx-win {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 50px 80px -34px rgba(59, 57, 120, .55)
}

.wx-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #f4f2fa
}

.wx-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57
}

.wx-bar i:nth-child(2) {
    background: #febc2e
}

.wx-bar i:nth-child(3) {
    background: #28c840
}

.wx-url {
    margin-left: 10px;
    flex: 1;
    max-width: 220px;
    background: #fff;
    border-radius: 99px;
    font: 500 10px Inter, sans-serif;
    padding: 4px 10px;
    color: #777
}

.wx-shot {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #ece9f7
}

.wx-shot img,
.wx-phone img,
.wx-round img,
.wx-exp-pic img,
.wx-b img,
.wx-tilt img,
.wx-cta-pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block
}

.wx-empty {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #d6d4ee, #8b88c8)
}

.wx-ov {
    position: absolute;
    left: 5%;
    top: 9%;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 42%
}

.wx-ov b {
    height: 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, .9)
}

.wx-ov b:nth-child(2) {
    width: 70%
}

.wx-ov b:nth-child(3) {
    width: 50%;
    opacity: .7
}

.wx-ov span {
    margin-top: 6px;
    width: 34%;
    height: 16px;
    border-radius: 99px;
    background: var(--blue)
}

.wx-phone {
    position: relative;
    aspect-ratio: 9/19;
    border-radius: 28px;
    border: 6px solid #12131f;
    background: #12131f;
    overflow: hidden;
    box-shadow: 0 40px 60px -26px rgba(10, 11, 20, .55)
}

.wx-dash {
    background: #fff;
    border-radius: 18px;
    padding: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 36px 50px -26px rgba(59, 57, 120, .5)
}

.wx-dash small {
    display: block;
    font: 600 10px Inter, sans-serif;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 12px
}

.wx-dash div {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: clamp(48px, 6vw, 90px)
}

.wx-dash i {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--blue), #b3b1dc)
}

.wx-round {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 40px 60px -28px rgba(10, 11, 20, .5);
    background: #d6d4ee
}

.wx-code {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #12131f;
    color: #cfd2ee;
    font: 600 clamp(9px, .95vw, 13px)/1.6 ui-monospace, Consolas, monospace;
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 36px 50px -24px rgba(10, 11, 20, .6)
}

.wx-badge {
    display: block;
    width: 100%;
    animation: wx-spin 14s linear infinite
}

@keyframes wx-spin {
    to {
        transform: rotate(360deg)
    }
}

/* MARQUEE */
.wx-mq {
    overflow: hidden;
    padding: clamp(34px, 5vw, 70px) 0;
    border-block: 1px solid var(--line);
    display: grid;
    gap: 14px
}

.wx-mq-row {
    overflow: hidden
}

.wx-mq-in {
    display: flex;
    width: max-content;
    animation: wx-mq 46s linear infinite
}

.wx-rev .wx-mq-in {
    animation-direction: reverse;
    animation-duration: 58s
}

.wx-mq:hover .wx-mq-in {
    animation-play-state: paused
}

@keyframes wx-mq {
    to {
        transform: translateX(-50%)
    }
}

.wx-mq-in span {
    display: flex;
    align-items: center;
    gap: clamp(22px, 3vw, 44px);
    padding-right: clamp(22px, 3vw, 44px);
    font: 700 clamp(34px, 6vw, 92px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    white-space: nowrap
}

.wx-mq-in i {
    width: .3em;
    height: .3em;
    border-radius: 50%;
    background: var(--blue);
    flex: none
}

.wx-rev .wx-mq-in span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink)
}

/* WHAT WE BUILD: horizontal */
.wx-hs {
    padding: clamp(70px, 9vw, 130px) 0 clamp(50px, 6vw, 90px);
    background: var(--cream2);
    overflow: hidden
}

.wx-hs-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(30px, 4vw, 56px)
}

.wx-hs-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 600 12px Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #777
}

.wx-hs-bar i {
    display: block;
    width: clamp(90px, 14vw, 200px);
    height: 2px;
    background: var(--blue);
    transform-origin: left;
    transform: scaleX(0)
}

.wx-hs-track {
    display: flex;
    gap: clamp(16px, 2vw, 28px);
    padding: 0 clamp(20px, 8vw, 120px) 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none
}

.wx-hs-track::-webkit-scrollbar {
    display: none
}

.wx-panel {
    flex: none;
    scroll-snap-align: start;
    width: min(88vw, 1060px);
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(24px, 3.2vw, 48px);
    border-radius: 36px;
    background: #fff;
    border: 1px solid var(--line)
}

.wx-panel:nth-child(even) {
    background: #e6e3f5
}

.wx-num {
    display: block;
    font: 800 clamp(72px, 10vw, 170px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--blue);
    margin-bottom: clamp(18px, 2.4vw, 34px)
}

.wx-panel h3 {
    font-size: clamp(26px, 2.8vw, 44px);
    letter-spacing: -.045em;
    line-height: 1;
    margin: 0 0 12px
}

.wx-panel p {
    color: #4a4b55;
    line-height: 1.55;
    max-width: 30em;
    margin: 0
}

.wx-panel ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0
}

.wx-panel li {
    padding: 7px 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .7);
    font: 600 13px Inter, sans-serif
}

.wx-panel-vis .wx-win {
    box-shadow: 0 40px 60px -34px rgba(59, 57, 120, .5)
}

.wx-mk {
    padding: 22px;
    aspect-ratio: 16/10;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: linear-gradient(180deg, #fff, #f4f2fa)
}

.wx-mk-h {
    height: 22px;
    width: 60%;
    border-radius: 8px;
    background: var(--ink)
}

.wx-mk-p {
    height: 9px;
    width: 78%;
    border-radius: 6px;
    background: #d9d7e6
}

.wx-mk-p.s {
    width: 52%
}

.wx-mk-b {
    height: 20px;
    width: 26%;
    border-radius: 99px;
    background: var(--blue);
    margin-bottom: 8px
}

.wx-mk-g {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    flex: 1
}

.wx-mk-g i {
    border-radius: 12px;
    background: linear-gradient(145deg, #d6d4ee, #9d9bd2)
}

.wx-ad {
    display: grid;
    grid-template-columns: 70px 1fr;
    aspect-ratio: 16/10;
    background: #fff
}

.wx-ad aside {
    background: var(--blue2);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px
}

.wx-ad aside i {
    height: 8px;
    border-radius: 5px;
    background: rgba(255, 255, 255, .55)
}

.wx-ad div {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px
}

.wx-ad p {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0
}

.wx-ad p b {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: #e6e3f5;
    flex: none
}

.wx-ad p span {
    height: 9px;
    border-radius: 6px;
    background: #d9d7e6
}

.wx-ad p em {
    margin-left: auto;
    width: 42px;
    height: 16px;
    border-radius: 99px;
    background: rgba(63, 227, 63, .25)
}

.wx-ap {
    aspect-ratio: 16/10;
    padding: 18px;
    background: #fff;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: 1.5fr 1fr;
    gap: 14px
}

.wx-ap-k {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px
}

.wx-ap-k i {
    height: 34px;
    border-radius: 12px;
    background: #f1effa
}

.wx-ap svg {
    width: 100%;
    height: 100%;
    display: block
}

.wx-ap-b {
    display: flex;
    align-items: flex-end;
    gap: 8px
}

.wx-ap-b i {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--blue), #b3b1dc)
}

.wx-js .wx-hs {
    overflow: hidden
}

@media(min-width:901px) {
    .wx-js .wx-hs {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(60px, 6vw, 90px)
    }

    .wx-js .wx-hs-track {
        overflow: visible;
        width: max-content;
        scroll-snap-type: none
    }
}

/* EXPERTISE: pinned */
.wx-exp {
    padding: clamp(70px, 8vw, 120px) 0;
    background: var(--cream)
}

.wx-exp-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: center
}

.wx-exp-list {
    list-style: none;
    margin: clamp(24px, 3vw, 44px) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink)
}

.wx-exp-item {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 2px 14px;
    width: 100%;
    cursor: pointer;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    opacity: .38;
    transition: opacity .4s var(--o), padding .5s var(--o)
}

.wx-exp-item:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px
}

.wx-exp-item b {
    grid-row: 1/3;
    font: 600 13px Inter, sans-serif;
    color: var(--blue);
    padding-top: .8em
}

.wx-et {
    font: 700 clamp(26px, 3.3vw, 52px)/1.05 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.045em
}

.wx-ed {
    font-size: 14.5px;
    line-height: 1.5;
    color: #4a4b55;
    max-height: 0;
    overflow: hidden;
    transition: max-height .5s var(--o)
}

.wx-exp-item.on {
    opacity: 1;
    padding-left: 10px
}

.wx-exp-item.on .wx-ed {
    max-height: 5em
}

.wx-exp-item:hover {
    opacity: .8
}

.wx-exp-frame {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 220px 220px 32px 32px;
    overflow: hidden;
    background: #d6d4ee;
    box-shadow: 0 50px 80px -40px rgba(59, 57, 120, .55)
}

.wx-exp-pic {
    position: absolute;
    inset: 0;
    overflow: hidden
}

.wx-exp-pic:not(:first-child) {
    clip-path: inset(100% 0 0 0)
}

@media(min-width:901px) {
    .wx-js .wx-exp {
        min-height: 100vh;
        display: grid;
        align-items: center
    }
}

/* BENTO */
.wx-bento {
    padding: clamp(70px, 9vw, 130px) 0;
    background: var(--cream2)
}

.wx-bg {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(70px, 8vw, 120px);
    gap: clamp(12px, 1.6vw, 22px);
    margin-top: clamp(34px, 4vw, 60px)
}

.wx-b {
    position: relative;
    margin: 0;
    border-radius: 26px;
    overflow: hidden;
    background: #d6d4ee
}

.wx-b figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    background: rgba(255, 255, 255, .88);
    backdrop-filter: blur(8px);
    border-radius: 99px;
    padding: 7px 14px;
    font: 600 12px/1 Inter, sans-serif
}

.wx-b1 {
    grid-column: 1/8;
    grid-row: 1/5
}

.wx-b2 {
    grid-column: 8/13;
    grid-row: 1/4
}

.wx-b3 {
    grid-column: 8/13;
    grid-row: 4/7
}

.wx-b4 {
    grid-column: 1/5;
    grid-row: 5/8
}

.wx-b5 {
    grid-column: 5/8;
    grid-row: 5/8
}

/* PROCESS rows */
.wx-proc {
    padding: clamp(70px, 9vw, 130px) 0
}

.wx-rows {
    list-style: none;
    margin: clamp(34px, 4vw, 60px) 0 0;
    padding: 0
}

.wx-row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(90px, 14vw, 220px) 1.1fr 1fr;
    gap: 20px;
    align-items: center;
    padding: clamp(22px, 3vw, 40px) 0;
    transition: padding .6s var(--o), background .4s
}

.wx-rline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--ink);
    transform-origin: left
}

.wx-rn {
    font: 800 clamp(56px, 9vw, 150px)/.85 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    transition: color .6s var(--o), -webkit-text-stroke-color .6s var(--o)
}

.wx-row.on .wx-rn {
    color: var(--blue);
    -webkit-text-stroke-color: var(--blue)
}

.wx-row h3 {
    font-size: clamp(28px, 4vw, 64px);
    letter-spacing: -.05em;
    line-height: 1;
    margin: 0
}

.wx-row p {
    color: #4a4b55;
    max-width: 26em;
    line-height: 1.55;
    margin: 0
}

.wx-row:hover {
    padding-left: clamp(10px, 2vw, 28px)
}

/* WHY */
.wx-why {
    padding: clamp(80px, 10vw, 150px) 0;
    background: var(--blue);
    color: #fff
}

.wx-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: center
}

.wx-count {
    font: 800 clamp(110px, 18vw, 300px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.07em;
    margin: clamp(20px, 3vw, 40px) 0 14px;
    color: var(--ink)
}

.wx-why-s {
    max-width: 20em;
    color: #ecebf7;
    margin: 0 0 clamp(24px, 3vw, 40px)
}

.wx-tilt {
    position: relative;
    aspect-ratio: 16/10;
    max-width: 480px;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 40px 60px -30px rgba(10, 11, 20, .6);
    background: #8b88c8
}

.wx-why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px
}

.wx-why-list li {
    padding: clamp(22px, 2.6vw, 34px);
    border-radius: 26px;
    background: rgba(255, 255, 255, .1);
    border: 1px solid rgba(255, 255, 255, .22);
    transition: background .4s, translate .5s var(--o)
}

.wx-why-list li:hover {
    background: rgba(255, 255, 255, .18);
    translate: 8px 0
}

.wx-why-list small {
    font: 600 13px Inter, sans-serif;
    color: var(--green)
}

.wx-why-list h3 {
    font-size: clamp(22px, 2.2vw, 32px);
    letter-spacing: -.04em;
    margin: 14px 0 6px;
    line-height: 1.05
}

.wx-why-list p {
    margin: 0;
    color: #ecebf7;
    font-size: 15px;
    line-height: 1.5
}

/* TECH */
.wx-tech {
    padding: clamp(70px, 9vw, 130px) 0
}

.wx-pills {
    list-style: none;
    margin: clamp(30px, 4vw, 56px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px
}

.wx-pills li {
    padding: clamp(12px, 1.6vw, 22px) clamp(22px, 3vw, 44px);
    border-radius: 99px;
    border: 1.5px solid var(--ink);
    font: 700 clamp(20px, 3vw, 46px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    transition: background .3s, color .3s, border-color .3s, translate .5s var(--o)
}

.wx-pills li:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    translate: 0 -6px
}

/* FAQ */
.wx-faq {
    padding: clamp(70px, 9vw, 130px) 0;
    background: var(--cream2)
}

.wx-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: start
}

.wx-faq-list {
    border-top: 1px solid var(--ink)
}

.wx-faq-list details {
    border-bottom: 1px solid var(--line)
}

.wx-faq-list summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    font: 600 clamp(17px, 1.5vw, 21px)/1.25 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.wx-faq-list summary::-webkit-details-marker {
    display: none
}

.wx-faq-list summary i {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    transition: transform .4s var(--o)
}

.wx-faq-list summary i::before,
.wx-faq-list summary i::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--blue);
    border-radius: 2px
}

.wx-faq-list summary i::after {
    transform: rotate(90deg)
}

.wx-faq-list details[open] summary i {
    transform: rotate(135deg)
}

.wx-faq-list details p {
    padding: 0 40px 24px 0;
    color: #4a4b55;
    max-width: 56ch;
    line-height: 1.6;
    margin: 0
}

/* CTA */
.wx-cta-s {
    padding: clamp(80px, 10vw, 150px) 0
}

.wx-cta-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(30px, 5vw, 80px);
    align-items: center
}

.wx-cta-s .wx-sub {
    margin: 22px 0 28px
}

.wx-contact {
    margin: 26px 0 0;
    font-size: 14px;
    color: #4a4b55
}

.wx-contact a {
    text-decoration: underline
}

.wx-cta-pic {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 34px;
    overflow: hidden;
    background: #d6d4ee;
    box-shadow: 0 50px 80px -36px rgba(59, 57, 120, .55);
    transform: rotate(3deg)
}

/* RESPONSIVE */
@media(max-width:1000px) {

    .wx-exp-grid,
    .wx-why-grid,
    .wx-faq-grid,
    .wx-cta-grid {
        grid-template-columns: minmax(0, 1fr)
    }

    .wx-row {
        grid-template-columns: 90px 1fr
    }

    .wx-row p {
        grid-column: 2
    }

    .wx-exp-frame {
        max-width: 520px;
        margin: 0 auto;
        order: -1
    }
}

@media(max-width:900px) {
    .wx-panel {
        grid-template-columns: minmax(0, 1fr);
        width: 86vw
    }

    .wx-hs-bar {
        display: none
    }

    .wx-bg {
        grid-template-columns: repeat(2, 1fr);
        grid-auto-rows: clamp(110px, 26vw, 190px)
    }

    .wx-b1 {
        grid-column: 1/3;
        grid-row: auto/span 2
    }

    .wx-b2,
    .wx-b3,
    .wx-b4,
    .wx-b5 {
        grid-column: auto;
        grid-row: auto/span 2
    }

    .wx-b3 {
        grid-column: 1/3
    }
}

@media(max-width:700px) {
    .wx-stage {
        aspect-ratio: 1/1.05
    }

    .wx-L1 {
        left: 0;
        top: 2%;
        width: 78%
    }

    .wx-L2 {
        left: 60%;
        top: 30%;
        width: 30%
    }

    .wx-L3 {
        display: none
    }

    .wx-L4 {
        right: 0;
        top: 0;
        width: 34%
    }

    .wx-L5 {
        display: none
    }

    .wx-L6 {
        left: 6%;
        bottom: 2%;
        width: 22%
    }

    .wx-hero-row {
        flex-direction: column;
        align-items: flex-start
    }

    .wx-row {
        grid-template-columns: 64px 1fr
    }
}

@media(prefers-reduced-motion:reduce) {

    .wx-mq-in,
    .wx-badge {
        animation: none
    }
}

/* WX IMAGES */
.wx-xwide {
    aspect-ratio: 21/8;
    margin-top: clamp(30px, 4vw, 56px)
}

.wx-xtall {
    aspect-ratio: 4/5;
    max-width: 420px;
    margin-top: clamp(24px, 3vw, 40px)
}

@media(max-width:900px) {
    .wx-xwide {
        aspect-ratio: 16/10
    }

    .wx-xtall {
        aspect-ratio: 16/10;
        max-width: none
    }
}

/* WX TYPE */
/* restore section spacing (".wx-page section{padding:0}" was overriding every section) */
.wx-page .wx-hero {
    padding: clamp(112px, 10vw, 150px) 0 clamp(36px, 4vw, 60px)
}

.wx-page .wx-hs {
    padding: clamp(56px, 7vw, 100px) 0 clamp(44px, 5vw, 72px);
    overflow: hidden
}

.wx-page .wx-exp,
.wx-page .wx-bento,
.wx-page .wx-proc,
.wx-page .wx-tech,
.wx-page .wx-faq {
    padding: clamp(56px, 7vw, 100px) 0
}

.wx-page .wx-why,
.wx-page .wx-cta-s {
    padding: clamp(64px, 8vw, 110px) 0
}

.wx-w {
    padding-top: .08em;
    margin-top: -.08em
}

/* hierarchy: H1 > H2 > panel/row titles > body */
.wx-page .wx-h1 {
    font-size: clamp(38px, 5.6vw, 92px);
    line-height: .96;
    letter-spacing: -.055em;
    max-width: 16ch
}

.wx-eyebrow {
    font-size: 11px;
    margin-bottom: clamp(16px, 2vw, 24px)
}

.wx-sub {
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.55;
    max-width: 32em
}

.wx-hero-row {
    margin-top: clamp(20px, 2.4vw, 32px)
}

.wx-page .wx-h2 {
    font-size: clamp(30px, 3.9vw, 62px);
    line-height: 1.02;
    letter-spacing: -.045em;
    max-width: 18ch;
    margin-top: 16px
}

.wx-page .wx-h2.wx-big {
    font-size: clamp(34px, 5.2vw, 86px);
    max-width: 13ch
}

.wx-pills li {
    font-size: clamp(16px, 1.9vw, 26px);
    padding: clamp(10px, 1.2vw, 16px) clamp(18px, 2.2vw, 32px)
}

.wx-faq-list summary {
    font-size: clamp(16px, 1.3vw, 19px)
}

.wx-faq-list details p {
    font-size: 15px
}

.wx-contact {
    font-size: 13.5px
}

/* ===== ROUND 35: stat card hover ===== */
@media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .about .stats>div {
        transition: transform .5s cubic-bezier(.2, .7, .2, 1), background-color .4s
    }

    .about .stats>div:hover {
        transform: translateY(-10px)
    }

    .about .stats>div:not(:nth-child(2 of :has(>b))):hover {
        background: #d6d1f3 !important
    }

    .about .stats>div:nth-child(2 of :has(>b)) {
        background-size: 140% 140% !important;
        background-position: 0% 0%;
        transition: transform .5s cubic-bezier(.2, .7, .2, 1), background-position .8s ease
    }

    .about .stats>div:nth-child(2 of :has(>b)):hover {
        background-position: 100% 100%
    }
}

/* ===== ROUND 36: premium stat card hover ===== */
.about .stats>div {
    isolation: isolate
}

.about .stats>div b,
.about .stats>div small {
    position: relative;
    z-index: 2
}

.about .stats>div::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .65), transparent 70%);
    transition: opacity .5s ease
}

.about .stats>div:nth-child(2 of :has(>b))::before {
    content: "";
    position: absolute;
    inset: -20% auto -20% -60%;
    width: 40%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .35), transparent);
    transform: skewX(-18deg);
    opacity: 0
}

@media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .about .stats>div {
        transition: transform .7s cubic-bezier(.16, 1, .3, 1), box-shadow .7s cubic-bezier(.16, 1, .3, 1), background-color .5s
    }

    .about .stats>div:hover {
        transform: translateY(-12px) !important;
        box-shadow: 0 30px 50px -28px rgba(75, 47, 208, .45)
    }

    .about .stats>div:hover::after {
        opacity: 1
    }

    .about .stats>div:nth-child(2 of :has(>b)):hover::before {
        opacity: 1;
        animation: statSheen 1.2s cubic-bezier(.16, 1, .3, 1) forwards
    }

    .about .stats>div b i {
        display: inline-block;
        transition: transform .6s cubic-bezier(.16, 1, .3, 1)
    }

    .about .stats>div:hover b i {
        transform: translateY(-6px) rotate(8deg)
    }
}

@keyframes statSheen {
    from {
        left: -60%
    }

    to {
        left: 140%
    }
}

.about .stats>div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300px
}

.about .sico {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, currentColor 14%, transparent)
}

.about .sico svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round
}

.about .sbody small {
    display: block;
    margin-top: 14px
}

/* stats icon fix */
.about .stats>div {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    min-height: 300px
}

.about .stats>div .sico {
    margin-bottom: auto;
    position: relative;
    z-index: 2;
    color: #4b2fd0
}

.about .stats>div:nth-child(2 of :has(>b)) .sico {
    color: #fff
}


/* stats card size */
.about .stats>div {
    min-height: 230px !important;
    height: auto !important;
    padding: 22px !important;
    scale: 1 !important
}

.about .stats>div b {
    font-size: clamp(44px, 5vw, 72px) !important
}

/* stats: GSAP owns transform, no CSS springs */
.about .stats>div {
    transition: box-shadow .5s, background-color .5s !important
}

.about .stats>div:hover .sico {
    animation: none !important
}

/* ===== UX UIUX PAGE ===== */
.ux-page {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-inter), Inter, system-ui, sans-serif;
    overflow-x: clip
}

.ux-page * {
    box-sizing: border-box
}

.ux-page h1,
.ux-page h2,
.ux-page h3 {
    font-family: var(--font-inter), 'Inter', sans-serif;
    margin: 0;
    max-width: none;
    white-space: normal;
    letter-spacing: -.035em;
    line-height: 1;
    font-weight: 600
}

.ux-page p,
.ux-page ol,
.ux-page ul,
.ux-page figure {
    margin: 0
}

.ux-page em {
    font-style: normal;
    color: var(--blue)
}

.ux-c {
    width: min(1280px, calc(100% - 48px));
    margin: 0 auto
}

.ux-page .ux-s {
    position: relative;
    padding: clamp(72px, 9vw, 130px) 0;
    overflow: clip
}

.ux-eye {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 12px/1 var(--font-inter), sans-serif;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--blue2);
    margin-bottom: 22px
}

.ux-eye i {
    width: 28px;
    height: 2px;
    background: var(--blue);
    display: block
}

.ux-page .ux-h1 {
    font-size: clamp(40px, 6vw, 96px);
    margin-bottom: 24px
}

.ux-page .ux-h2 {
    font-size: clamp(32px, 4.4vw, 68px);
    margin-bottom: clamp(30px, 4vw, 56px)
}

.ux-page .ux-h2--xl {
    font-size: clamp(40px, 6vw, 96px)
}

.ux-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0 .06em .12em 0;
    margin: 0 -.06em -.12em 0
}

.ux-i {
    display: inline-block;
    will-change: transform
}

.ux-sub {
    font-size: clamp(15px, 1.25vw, 18px);
    line-height: 1.6;
    max-width: 46ch;
    color: rgba(10, 11, 20, .7);
    margin-bottom: 30px
}

.ux-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap
}

.ux-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 26px;
    border-radius: 99px;
    background: var(--blue);
    color: #fff;
    font: 600 14px var(--font-inter), sans-serif;
    text-decoration: none;
    box-shadow: 0 14px 30px -12px rgba(106, 103, 174, .8);
    transition: background .4s, color .4s
}

.ux-btn:hover {
    background: var(--ink);
    color: #fff
}

.ux-btn--ghost {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink)
}

.ux-btn--ghost:hover {
    background: var(--ink);
    color: #fff
}

/* hero */
.ux-page .ux-hero {
    padding: clamp(110px, 12vw, 150px) 0 clamp(50px, 6vw, 90px);
    min-height: 100svh;
    display: flex;
    align-items: center
}

.ux-hero .ux-c {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: clamp(24px, 4vw, 60px);
    align-items: center
}

.ux-stage {
    position: relative;
    aspect-ratio: 1/.92;
    width: 100%
}

.ux-l {
    position: absolute
}

.ux-l-blob {
    left: 8%;
    top: 4%;
    width: 88%;
    height: 92%
}

.ux-blob {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, rgba(106, 103, 174, .45), rgba(106, 103, 174, 0) 70%);
    filter: blur(10px)
}

.ux-l-win {
    left: 0;
    top: 7%;
    width: 80%
}

.ux-l-phone {
    right: 0;
    top: 20%;
    width: 30%
}

.ux-l-pal {
    left: 4%;
    bottom: 0;
    width: 36%
}

.ux-l-sel {
    right: 12%;
    bottom: 6%
}

.ux-win {
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 40px 80px -30px rgba(40, 36, 110, .35), 0 0 0 1px var(--line);
    overflow: hidden
}

.ux-win-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: #faf8f4
}

.ux-win-bar>span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d9d4c8;
    flex: none
}

.ux-win-bar b {
    font: 500 11px 'Inter', sans-serif;
    margin-left: 10px;
    padding: 4px 10px;
    border-radius: 99px;
    background: #fff;
    border: 1px solid var(--line);
    white-space: nowrap
}

.ux-bd {
    margin-left: auto;
    position: relative;
    font: 600 10px var(--font-inter), sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blue2);
    height: 14px;
    min-width: 90px;
    text-align: right
}

.ux-bd span {
    position: absolute;
    right: 0;
    top: 0;
    white-space: nowrap
}

.ux-win-body {
    padding: 16px;
    display: grid;
    gap: 14px
}

.ux-nv {
    display: flex;
    align-items: center;
    gap: 14px
}

.ux-nvl {
    display: flex;
    gap: 10px;
    margin-left: auto
}

.ux-wf {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: rgba(10, 11, 20, .05);
    border: 1px dashed rgba(10, 11, 20, .25)
}

.ux-fill {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--blue)
}

.ux-fill img,
.ux-fill .ux-empty {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block
}

.ux-f-ink {
    background: var(--ink)
}

.ux-f-soft {
    background: #dcd9f1
}

.ux-wf-logo {
    width: 70px;
    height: 16px
}

.ux-wf-l {
    width: 34px;
    height: 8px;
    margin-top: 4px
}

.ux-wf-pill {
    width: 64px;
    height: 22px;
    border-radius: 99px
}

.ux-hb {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 14px;
    align-items: stretch
}

.ux-hb-t {
    display: grid;
    gap: 8px;
    align-content: center
}

.ux-wf-h {
    height: 20px
}

.ux-wf-p {
    height: 8px
}

.ux-w70 {
    width: 70%
}

.ux-w55 {
    width: 55%
}

.ux-wf-btn {
    width: 90px;
    height: 24px;
    border-radius: 99px;
    margin-top: 6px
}

.ux-wf-img {
    min-height: 130px;
    border-radius: 12px;
    background: linear-gradient(to top right, transparent calc(50% - 1px), rgba(10, 11, 20, .25) 50%, transparent calc(50% + 1px)), linear-gradient(to bottom right, transparent calc(50% - 1px), rgba(10, 11, 20, .25) 50%, transparent calc(50% + 1px)), rgba(10, 11, 20, .04)
}

.ux-cards3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px
}

.ux-wf-card {
    height: 54px;
    border-radius: 10px
}

.ux-phone {
    background: #0a0b14;
    border-radius: 26px;
    padding: 7px;
    box-shadow: 0 30px 60px -20px rgba(10, 11, 20, .5)
}

.ux-ph-s {
    background: #fff;
    border-radius: 20px;
    padding: 14px 10px 10px;
    display: grid;
    gap: 8px;
    overflow: hidden
}

.ux-ph-top {
    display: flex;
    align-items: center;
    gap: 8px
}

.ux-ph-top i {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--blue);
    flex: none
}

.ux-ph-top b {
    height: 7px;
    width: 50%;
    border-radius: 4px;
    background: #dcd9f1
}

.ux-ph-card {
    background: linear-gradient(135deg, var(--blue), var(--blue2));
    color: #fff;
    border-radius: 14px;
    padding: 10px
}

.ux-ph-card small {
    display: block;
    font: 500 8px 'Inter', sans-serif;
    opacity: .8
}

.ux-ph-card strong {
    font: 600 20px var(--font-inter), sans-serif
}

.ux-ph-card svg {
    display: block;
    width: 100%;
    height: 24px;
    margin-top: 4px
}

.ux-ph-card path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.5;
    stroke-linecap: round
}

.ux-ph-row {
    display: flex;
    align-items: center;
    gap: 7px
}

.ux-ph-row i {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: #dcd9f1;
    flex: none
}

.ux-ph-row span {
    flex: 1;
    height: 7px;
    border-radius: 4px;
    background: #ebe6dc
}

.ux-ph-row em {
    width: 16px;
    height: 7px;
    border-radius: 4px;
    background: var(--green)
}

.ux-ph-tab {
    display: flex;
    justify-content: space-around;
    padding-top: 6px;
    border-top: 1px solid var(--line)
}

.ux-ph-tab i {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: #dcd9f1
}

.ux-ph-tab i:first-child {
    background: var(--blue)
}

.ux-pal {
    background: #fff;
    border-radius: 16px;
    padding: 14px;
    box-shadow: 0 24px 50px -24px rgba(40, 36, 110, .4), 0 0 0 1px var(--line)
}

.ux-pal small {
    font: 600 10px var(--font-inter), sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(10, 11, 20, .55)
}

.ux-sw {
    display: flex;
    gap: 6px;
    margin: 10px 0
}

.ux-sw i {
    flex: 1;
    aspect-ratio: 1;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--line)
}

.ux-aa {
    font: 600 34px/1 var(--font-inter), sans-serif;
    display: flex;
    align-items: baseline;
    gap: 8px
}

.ux-aa span {
    font: 500 11px 'Inter', sans-serif;
    color: rgba(10, 11, 20, .55)
}

.ux-sel {
    position: relative;
    padding: 12px 18px;
    border: 1.5px solid var(--blue)
}

.ux-sel b {
    display: inline-block;
    background: var(--blue);
    color: #fff;
    padding: 10px 18px;
    border-radius: 99px;
    font: 600 13px var(--font-inter), sans-serif
}

.ux-sel span {
    position: absolute;
    left: -1px;
    top: -24px;
    background: var(--blue);
    color: #fff;
    font: 600 10px 'Inter', sans-serif;
    padding: 3px 7px;
    border-radius: 4px;
    white-space: nowrap
}

.ux-sel i {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #fff;
    border: 1.5px solid var(--blue)
}

.ux-sel i:nth-of-type(1) {
    left: -5px;
    top: -5px
}

.ux-sel i:nth-of-type(2) {
    right: -5px;
    top: -5px
}

.ux-sel i:nth-of-type(3) {
    left: -5px;
    bottom: -5px
}

.ux-sel i:nth-of-type(4) {
    right: -5px;
    bottom: -5px
}

.ux-dcur {
    position: absolute;
    left: 30%;
    top: 40%;
    z-index: 6;
    pointer-events: none
}

.ux-dcur svg {
    width: 22px;
    height: 22px;
    fill: var(--blue);
    stroke: #fff;
    stroke-width: 1.2;
    display: block
}

.ux-dcur span {
    position: absolute;
    left: 16px;
    top: 16px;
    background: var(--blue);
    color: #fff;
    font: 600 10px 'Inter', sans-serif;
    padding: 4px 9px;
    border-radius: 99px;
    white-space: nowrap
}

/* marquee */
.ux-mq {
    overflow: hidden;
    border-block: 1px solid var(--line);
    padding: 18px 0;
    background: var(--cream2)
}

.ux-mq-t {
    display: flex;
    align-items: center;
    width: max-content;
    animation: uxmq 40s linear infinite;
    font: 600 clamp(20px, 2.4vw, 34px) var(--font-inter), sans-serif;
    letter-spacing: -.02em;
    white-space: nowrap
}

.ux-mq-i {
    display: flex;
    align-items: center;
    flex: none
}

.ux-mq-i i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--blue);
    margin: 0 34px
}

@keyframes uxmq {
    to {
        transform: translateX(-50%)
    }
}

/* accordion */
.ux-page .ux-what {
    background: var(--cream)
}

.ux-ac {
    display: flex;
    gap: 14px;
    height: clamp(420px, 46vw, 540px)
}

.ux-ac-p {
    position: relative;
    flex: 1;
    min-width: 0;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line);
    padding: 26px;
    overflow: hidden;
    cursor: pointer;
    transition: flex .9s var(--o), background .5s, color .5s
}

.ux-ac-p.on {
    flex: 3.4;
    background: var(--ink);
    color: #fff
}

.ux-ac-head span {
    font: 600 12px var(--font-inter), sans-serif;
    letter-spacing: .14em;
    color: var(--blue)
}

.ux-ac-head h3 {
    font-size: clamp(20px, 2.1vw, 30px);
    margin-top: 10px
}

.ux-ac-p p {
    margin-top: 12px;
    max-width: 30ch;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .6s .15s, transform .6s .15s var(--o)
}

.ux-ac-p.on p {
    opacity: .8;
    transform: none
}

.ux-ac-vis {
    position: absolute;
    left: 26px;
    right: 26px;
    bottom: 26px;
    height: 48%;
    opacity: 0;
    transform: translateY(30px);
    transition: opacity .8s .1s, transform .8s .1s var(--o)
}

.ux-ac-p.on .ux-ac-vis {
    opacity: 1;
    transform: none
}

.ux-mv {
    position: absolute;
    inset: 0
}

.ux-mv i {
    display: block;
    border-radius: 10px;
    background: rgba(255, 255, 255, .16)
}

.ux-mv i.p {
    background: var(--blue)
}

/* expertise */
.ux-page .ux-ex {
    padding: 0;
    overflow: clip;
    background: var(--cream2)
}

.ux-ex-pin {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 90px 0 40px
}

.ux-ex-grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: center
}

.ux-ex-l {
    position: relative;
    padding-left: 22px
}

.ux-ex-l .ux-h2 {
    margin-bottom: 28px
}

.ux-ex-list {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line)
}

.ux-ex-item {
    border-bottom: 1px solid var(--line)
}

.ux-ex-item button {
    background: none;
    border: 0;
    width: 100%;
    text-align: left;
    display: grid;
    grid-template-columns: 44px 1fr;
    column-gap: 8px;
    align-items: baseline;
    padding: 16px 0;
    cursor: pointer;
    color: inherit;
    font: inherit
}

.ux-ex-item span {
    font: 600 12px var(--font-inter), sans-serif;
    letter-spacing: .14em;
    color: var(--blue)
}

.ux-ex-item b {
    font: 600 clamp(22px, 2.4vw, 34px)/1.1 var(--font-inter), sans-serif;
    letter-spacing: -.03em;
    opacity: .35;
    transition: opacity .5s
}

.ux-ex-item.on b {
    opacity: 1
}

.ux-ex-item small {
    grid-column: 2;
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    font-size: 14.5px;
    line-height: 1.5;
    max-width: 42ch;
    transition: max-height .5s var(--o), opacity .5s, margin .5s
}

.ux-ex-item.on small {
    max-height: 90px;
    opacity: .75;
    margin-top: 8px
}

.ux-ex-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--line)
}

.ux-ex-bar i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: top;
    transform: scaleY(0)
}

.ux-canvas {
    position: relative;
    aspect-ratio: 1.1/1;
    border-radius: 26px;
    background: #fff;
    box-shadow: 0 50px 90px -40px rgba(40, 36, 110, .45), 0 0 0 1px var(--line);
    overflow: hidden
}

.ux-ill {
    position: absolute;
    right: 16px;
    bottom: 12px;
    z-index: 5;
    font: 600 9px var(--font-inter), sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(10, 11, 20, .45)
}

.ux-lay {
    position: absolute;
    inset: 0;
    clip-path: inset(0% 100% 0% 0%);
    padding: 7%;
    display: grid;
    gap: 12px;
    align-content: start
}

.ux-lay:first-of-type {
    clip-path: inset(0% 0% 0% 0%)
}

.ux-lay-t {
    font: 600 11px var(--font-inter), sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--blue2)
}

.ux-lay0 {
    background: #f6f2ea
}

.ux-lay-ph {
    position: relative;
    height: 42%;
    border-radius: 14px;
    overflow: hidden
}

.ux-lay-ph img,
.ux-lay-ph .ux-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover
}

.ux-notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px
}

.ux-notes span {
    background: #fff;
    border-left: 3px solid var(--blue);
    border-radius: 8px;
    padding: 10px;
    font: 500 12px/1.3 'Inter', sans-serif;
    box-shadow: 0 8px 20px -12px rgba(10, 11, 20, .3)
}

.ux-lay1 {
    background: #fff radial-gradient(rgba(10, 11, 20, .12) 1px, transparent 1px);
    background-size: 18px 18px
}

.ux-wf2 {
    position: relative;
    border: 1.5px dashed rgba(10, 11, 20, .35);
    border-radius: 8px;
    background: rgba(255, 255, 255, .7);
    min-height: 56px
}

.ux-wf2 b {
    position: absolute;
    left: 8px;
    top: -9px;
    background: var(--blue);
    color: #fff;
    font: 600 9px 'Inter', sans-serif;
    padding: 2px 6px;
    border-radius: 4px
}

.ux-wf2-n {
    min-height: 34px
}

.ux-wf2-hero {
    min-height: clamp(110px, 15vw, 190px)
}

.ux-wf2-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px
}

.ux-lay2 {
    background: #ece9fa
}

.ux-flow {
    display: flex;
    align-items: center;
    margin-top: 6%
}

.ux-scr {
    position: relative;
    flex: 0 0 26%;
    aspect-ratio: 9/16;
    background: #fff;
    border-radius: 16px;
    padding: 10px;
    display: grid;
    gap: 7px;
    align-content: start;
    box-shadow: 0 18px 40px -20px rgba(40, 36, 110, .5)
}

.ux-scr i {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: #dcd9f1
}

.ux-scr u {
    display: block;
    height: 34px;
    border-radius: 8px;
    background: var(--blue);
    text-decoration: none
}

.ux-arr {
    position: relative;
    flex: 1;
    height: 0;
    border-top: 2px dashed var(--blue)
}

.ux-arr:after {
    content: "";
    position: absolute;
    right: -1px;
    top: -6px;
    border: 5px solid transparent;
    border-left: 8px solid var(--blue)
}

.ux-hot {
    position: absolute;
    right: 12px;
    bottom: 12px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(106, 103, 174, .4);
    animation: uxpulse 1.8s infinite
}

@keyframes uxpulse {
    0% {
        transform: scale(.6);
        opacity: 1
    }

    100% {
        transform: scale(2.2);
        opacity: 0
    }
}

.ux-lay3 {
    background: #fff
}

.ux-fd-ph {
    position: relative;
    height: 40%;
    border-radius: 14px;
    overflow: hidden
}

.ux-fd-ph img,
.ux-fd-ph .ux-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover
}

.ux-fd-t {
    display: grid;
    gap: 8px
}

.ux-fd-t i {
    display: block;
    height: 14px;
    border-radius: 5px;
    background: var(--ink)
}

.ux-fd-t b {
    justify-self: start;
    background: var(--blue);
    color: #fff;
    padding: 9px 18px;
    border-radius: 99px;
    font: 600 12px var(--font-inter), sans-serif;
    margin-top: 4px
}

.ux-fd-sw {
    display: flex;
    gap: 8px
}

.ux-fd-sw i {
    width: 26px;
    height: 26px;
    border-radius: 50%
}

/* showcase */
.ux-page .ux-sc {
    background: var(--cream)
}

.ux-sc-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap
}

.ux-chips {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 12px var(--font-inter), sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: clamp(30px, 4vw, 56px)
}

.ux-chip {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: #fff;
    padding: 3px;
    cursor: pointer
}

.ux-chip i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%
}

.ux-chip.on {
    border-color: var(--ink)
}

.ux-sc-stage {
    --ac: #6a67ae;
    --ac2: #dcd9f1;
    position: relative;
    height: clamp(560px, 56vw, 780px);
    perspective: 1400px
}

.ux-sc-stage[data-theme="green"] {
    --ac: #2fbf2f;
    --ac2: #d3f5d3
}

.ux-sc-stage[data-theme="ink"] {
    --ac: #0a0b14;
    --ac2: #dcdbe2
}

.ux-sc-browser {
    position: absolute;
    left: 0;
    top: 0;
    width: 76%;
    height: 78%;
    background: #fff;
    border-radius: 22px;
    box-shadow: 0 60px 100px -40px rgba(40, 36, 110, .45), 0 0 0 1px var(--line);
    overflow: hidden;
    transform-origin: 50% 100%;
    display: flex;
    flex-direction: column
}

.ux-sc-body {
    flex: 1;
    display: grid;
    grid-template-columns: 18% 1fr;
    min-height: 0
}

.ux-sb {
    background: #faf8f4;
    border-right: 1px solid var(--line);
    padding: 16px 12px;
    display: grid;
    gap: 10px;
    align-content: start
}

.ux-sb i {
    display: block;
    height: 10px;
    border-radius: 5px;
    background: #e6e1d6
}

.ux-sb .ux-sb-logo {
    height: 16px;
    width: 70%;
    background: var(--ac);
    transition: background .6s
}

.ux-sb .ux-sb-a {
    background: var(--ac2);
    height: 22px;
    border-radius: 8px;
    transition: background .6s
}

.ux-sm {
    padding: clamp(12px, 2vw, 24px);
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: clamp(10px, 1.6vw, 18px);
    min-height: 0
}

.ux-sm-top {
    display: flex;
    justify-content: space-between;
    align-items: center
}

.ux-sm-top b {
    height: 14px;
    width: 30%;
    border-radius: 6px;
    background: var(--ink)
}

.ux-sm-top i {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--ac);
    transition: background .6s
}

.ux-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px
}

.ux-kpis div {
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 12px
}

.ux-kpis small {
    display: block;
    font: 500 11px 'Inter', sans-serif;
    color: rgba(10, 11, 20, .55)
}

.ux-kpis strong {
    font: 600 clamp(22px, 3vw, 40px)/1.1 var(--font-inter), sans-serif;
    letter-spacing: -.03em
}

.ux-chart {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    min-height: 0
}

.ux-bars {
    position: absolute;
    inset: 14px;
    display: flex;
    gap: 2.5%;
    align-items: flex-end
}

.ux-bar {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: var(--ac2);
    transition: background .6s
}

.ux-bar:nth-child(4n) {
    background: var(--ac)
}

.ux-line {
    position: absolute;
    inset: 14px;
    width: calc(100% - 28px);
    height: calc(100% - 28px)
}

.ux-ln {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke
}

.ux-bd-ill {
    color: var(--blue2)
}

.ux-ph2 {
    position: absolute;
    width: 23%;
    aspect-ratio: 9/18.5;
    background: #0a0b14;
    border-radius: 34px;
    padding: 8px;
    box-shadow: 0 40px 70px -26px rgba(10, 11, 20, .55)
}

.ux-ph2-a {
    right: 15%;
    top: 12%
}

.ux-ph2-b {
    right: 0;
    top: 34%;
    width: 21%
}

.ux-ph2 .s {
    width: 100%;
    height: 100%;
    border-radius: 27px;
    background: #fff;
    overflow: hidden;
    display: grid;
    grid-template-rows: 44% 1fr
}

.ux-ph2-img {
    position: relative;
    overflow: hidden
}

.ux-ph2-img img,
.ux-ph2-img .ux-empty {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover
}

.ux-ph2-b {}

.ux-ph2 .ux-ph2-b,
.ux-ph2-a .ux-ph2-b {
    padding: 12px;
    display: grid;
    gap: 8px;
    align-content: start
}

.ux-ph2-a .ux-ph2-b i {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: #e6e1d6
}

.ux-ph2-a .ux-ph2-b b {
    justify-self: start;
    background: var(--ac);
    color: #fff;
    padding: 7px 14px;
    border-radius: 99px;
    font: 600 10px var(--font-inter), sans-serif;
    margin-top: 6px;
    transition: background .6s
}

.ux-ph2 .s2 {
    grid-template-rows: auto 1fr;
    padding: 16px 12px;
    gap: 14px;
    justify-items: center
}

.ux-ring {
    width: 56%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(var(--ac) 0 72%, var(--ac2) 0);
    display: grid;
    place-items: center;
    transition: background .6s
}

.ux-ring i {
    display: block;
    width: 72%;
    height: 72%;
    border-radius: 50%;
    background: #fff
}

.ux-ph2-l {
    width: 100%;
    display: grid;
    gap: 8px;
    align-content: start
}

.ux-ph2-l i {
    display: block;
    height: 20px;
    border-radius: 8px;
    background: var(--ac2);
    transition: background .6s
}

.ux-fig {
    position: relative;
    overflow: hidden
}

.ux-fig img,
.ux-fig .ux-empty {
    position: absolute;
    left: 0;
    top: -10%;
    width: 100%;
    height: 120%;
    object-fit: cover
}

.ux-empty {
    background: linear-gradient(135deg, var(--blue), var(--blue2))
}

.ux-fig-a {
    position: absolute;
    left: 6%;
    bottom: 0;
    width: 34%;
    aspect-ratio: 4/3;
    border-radius: 22px;
    z-index: 3;
    box-shadow: 0 30px 60px -30px rgba(10, 11, 20, .5)
}

/* process stack */
.ux-page .ux-pr {
    background: var(--cream2)
}

.ux-stack {
    padding-bottom: 6vh
}

.ux-pc {
    position: sticky;
    top: calc(100px + var(--i) * 20px);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) clamp(90px, 12vw, 160px);
    align-items: center;
    gap: clamp(18px, 4vw, 60px);
    padding: clamp(24px, 3.4vw, 48px);
    margin-bottom: 28px;
    border-radius: 30px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line), 0 30px 60px -40px rgba(40, 36, 110, .4);
    min-height: clamp(200px, 22vw, 280px)
}

.ux-pc:nth-child(3n+2) {
    background: var(--blue);
    color: #fff
}

.ux-pc:nth-child(3n) {
    background: var(--ink);
    color: #fff
}

.ux-pc-n {
    font: 600 clamp(56px, 8vw, 128px)/.85 var(--font-inter), sans-serif;
    letter-spacing: -.05em;
    color: var(--blue)
}

.ux-pc:nth-child(3n+2) .ux-pc-n,
.ux-pc:nth-child(3n) .ux-pc-n {
    color: rgba(255, 255, 255, .35)
}

.ux-pc h3 {
    font-size: clamp(26px, 3.2vw, 48px)
}

.ux-pc p {
    margin-top: 12px;
    max-width: 44ch;
    font-size: 15px;
    line-height: 1.55;
    opacity: .75
}

.ux-pc-art {
    width: 100%;
    height: auto;
    overflow: visible
}

.ux-dr {
    fill: none;
    stroke: var(--blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1
}

.ux-pc:nth-child(3n+2) .ux-dr,
.ux-pc:nth-child(3n) .ux-dr {
    stroke: #fff
}

/* why */
.ux-page .ux-why {
    background: var(--ink);
    color: #fff
}

.ux-eye--l {
    color: #bdbbea
}

.ux-eye--l i {
    background: #bdbbea
}

.ux-stmt {
    font: 600 clamp(28px, 4.6vw, 72px)/1.08 var(--font-inter), sans-serif;
    letter-spacing: -.035em;
    max-width: 22ch;
    margin-bottom: clamp(40px, 6vw, 90px)
}

.ux-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, .18);
    padding-top: 30px;
    margin-bottom: 40px
}

.ux-stat b {
    display: block;
    font: 600 clamp(48px, 8vw, 130px)/1 var(--font-inter), sans-serif;
    letter-spacing: -.05em;
    color: var(--green)
}

.ux-stat span {
    font-size: 14px;
    opacity: .7
}

.ux-bens {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px
}

.ux-ben {
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 22px;
    padding: 24px;
    background: rgba(255, 255, 255, .04);
    transition: transform .5s var(--o), background .4s, border-color .4s
}

.ux-ben:hover {
    transform: translateY(-6px);
    background: rgba(106, 103, 174, .25);
    border-color: var(--blue)
}

.ux-ben h3 {
    font-size: 20px;
    margin-bottom: 10px;
    letter-spacing: -.02em
}

.ux-ben p {
    font-size: 14px;
    line-height: 1.55;
    opacity: .7
}

/* cta */
.ux-page .ux-end {
    background: var(--cream)
}

.ux-end-g {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: center
}

.ux-end .ux-h2 {
    margin-bottom: 30px
}

.ux-ct {
    list-style: none;
    padding: 0;
    margin-top: 34px;
    display: grid;
    gap: 8px;
    font-size: 15px
}

.ux-ct a {
    color: var(--ink)
}

.ux-fig-c {
    aspect-ratio: 4/5;
    border-radius: 32px;
    transform: rotate(3deg);
    box-shadow: 0 40px 80px -40px rgba(40, 36, 110, .5)
}

/* responsive */
@media (max-width:900px) {

    .ux-hero .ux-c,
    .ux-ex-grid,
    .ux-end-g {
        grid-template-columns: 1fr
    }

    .ux-page .ux-hero {
        min-height: 0
    }

    .ux-stage {
        aspect-ratio: 1/1
    }

    .ux-ac {
        flex-direction: column;
        height: auto
    }

    .ux-ac-p,
    .ux-ac-p.on {
        flex: none;
        min-height: 300px;
        background: var(--ink);
        color: #fff
    }

    .ux-ac-p p {
        opacity: .8;
        transform: none
    }

    .ux-ac-vis {
        opacity: 1;
        transform: none;
        height: 45%
    }

    .ux-ex-pin {
        min-height: 0;
        padding: 70px 0
    }

    .ux-ex-bar {
        display: none
    }

    .ux-ex-l {
        padding-left: 0
    }

    .ux-sc-stage {
        height: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        perspective: none
    }

    .ux-sc-browser {
        position: relative;
        grid-column: 1/3;
        width: 100%;
        height: auto;
        min-height: 340px
    }

    .ux-ph2 {
        position: relative;
        right: auto;
        top: auto;
        width: 100%;
        max-width: 220px;
        margin: 0 auto
    }

    .ux-ph2-b {
        width: 100%
    }

    .ux-fig-a {
        position: relative;
        left: auto;
        bottom: auto;
        grid-column: 1/3;
        width: 100%
    }

    .ux-pc {
        grid-template-columns: auto minmax(0, 1fr)
    }

    .ux-pc-art {
        display: none
    }

    .ux-bens {
        grid-template-columns: 1fr 1fr
    }

    .ux-fig-c {
        max-width: 420px
    }
}

@media (max-width:560px) {
    .ux-bens {
        grid-template-columns: 1fr
    }

    .ux-stats {
        grid-template-columns: 1fr
    }

    .ux-l-phone {
        width: 34%
    }

    .ux-l-pal {
        width: 44%
    }

    .ux-kpis {
        gap: 6px
    }

    .ux-kpis div {
        padding: 8px
    }
}

@media (prefers-reduced-motion:reduce) {

    .ux-mq-t,
    .ux-hot {
        animation: none
    }
}

/* ===== UX POLISH ===== */
.ux-page h1,
.ux-page h2 {
    text-wrap: balance
}

.ux-page p {
    text-wrap: pretty
}

.ux-page .ux-eye {
    margin-bottom: 24px
}

.ux-page .ux-h1 {
    line-height: 1.02;
    margin-bottom: 26px
}

.ux-page .ux-h2 {
    line-height: 1.04
}

.ux-page .ux-sub {
    margin-bottom: 32px;
    max-width: 44ch;
    line-height: 1.65
}

.ux-page .ux-stmt {
    margin-bottom: clamp(44px, 6vw, 90px);
    line-height: 1.1
}

.ux-page .ux-ct {
    margin-top: 36px;
    gap: 10px;
    line-height: 1.5
}

.ux-page .ux-pc p,
.ux-page .ux-ben p {
    line-height: 1.6
}

.ux-page .ux-ex-l .ux-h2 {
    margin-bottom: 30px
}

.ux-page .ux-ex-item button {
    padding: 18px 0
}

/* closed accordion panels: show a soft visual instead of blank white */
.ux-ac-p:not(.on) .ux-ac-vis {
    opacity: .7;
    transform: none;
    left: 16px;
    right: 16px;
    bottom: 16px;
    height: 42%
}

.ux-ac-p:not(.on) .ux-mv i {
    background: rgba(106, 103, 174, .16)
}

.ux-ac-p:not(.on) .ux-mv i.p {
    background: var(--blue)
}

/* pinned canvas: photos had collapsed to zero height */
.ux-lay-ph,
.ux-fd-ph {
    height: auto;
    aspect-ratio: 16/8
}

.ux-wf2-hero {
    min-height: clamp(120px, 19vw, 240px)
}

.ux-lay {
    gap: 14px
}

/* showcase: stop phone covering the third KPI */
.ux-sc-browser {
    width: 66%
}

.ux-ph2-a {
    right: 11%
}

@media (max-width:900px) {
    .ux-sc-browser {
        width: 100%
    }

    .ux-page .ux-eye {
        margin-bottom: 18px
    }

    .ux-page .ux-sub {
        margin-bottom: 26px
    }

    .ux-ac-p:not(.on) .ux-ac-vis {
        opacity: 1;
        left: 26px;
        right: 26px;
        bottom: 26px;
        height: 45%
    }

    .ux-lay-ph,
    .ux-fd-ph {
        aspect-ratio: 16/9
    }
}

.wd-cta {
    background: var(--blue);
    color: #fff
}

.wd-ctagrid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(30px, 5vw, 80px);
    align-items: center
}

.wd-ctap {
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.4;
    color: #ecebf7;
    max-width: 30em;
    margin: 26px 0 34px
}

.wd-meta {
    margin-top: 30px;
    color: #dedcf1;
    font-size: 15px
}

.wd-meta a {
    text-decoration: underline;
    text-underline-offset: 4px
}

.wd-ctaph {
    aspect-ratio: 4/5;
    border-radius: 32px;
    background: linear-gradient(160deg, #9d9bd4, var(--blue2));
    transform: rotate(3deg);
    box-shadow: 0 50px 90px -30px #0a0b1488
}

@media (max-width:1000px) {

    .wd-hero .wrap,
    .wd-split,
    .wd-ctagrid {
        grid-template-columns: 1fr
    }

    .wd-hero h1 {
        max-width: none
    }

    .wd-sticky {
        position: static
    }

    .wd-arch {
        max-width: 420px
    }

    .wd-why-grid {
        grid-template-columns: 1fr 1fr
    }

    .wd-big {
        grid-column: 1/-1;
        grid-row: auto;
        min-height: 260px
    }

    .wd-steps {
        grid-template-columns: 1fr;
        gap: 34px;
        padding-left: 4px
    }

    .wd-line {
        left: 22px;
        right: auto;
        top: 22px;
        bottom: 30px;
        width: 2px;
        height: auto
    }

    .wd-line i {
        width: 100%;
        height: 100%;
        transform-origin: 0 0
    }

    .wd-step {
        padding-left: 70px
    }

    .wd-step b {
        position: absolute;
        left: 0;
        top: 0
    }

    .wd-step h3 {
        margin-top: 0
    }
}

@media (max-width:700px) {

    .wd-cards,
    .wd-why-grid,
    .wd-caps {
        grid-template-columns: 1fr
    }

    .wd-stage {
        height: auto;
        display: grid;
        gap: 22px
    }

    .wd-s {
        position: relative;
        inset: auto;
        width: 100% !important
    }

    .wd-s.wd-s4 {
        width: 46% !important;
        justify-self: center
    }

    .wd-facts {
        flex-wrap: wrap
    }

    .wd-code {
        display: none
    }

    .wd-xrows li {
        grid-template-columns: auto 1fr
    }

    .wd-xrows svg {
        display: none
    }
}

/* WX WEB DEV v2 */
.wx-page section {
    padding: 0;
    overflow: visible;
    position: relative
}

.wx-page h1,
.wx-page h2,
.wx-page h3 {
    max-width: none;
    white-space: normal
}

.wx-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: .14em;
    margin-bottom: -.14em
}

.wx-i {
    display: inline-block
}

.wx-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 600 12px/1 Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 clamp(18px, 2.4vw, 30px)
}

.wx-eyebrow i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green)
}

.wx-page .wx-h1 {
    font-size: clamp(46px, 8vw, 138px);
    line-height: .92;
    letter-spacing: -.06em;
    max-width: 15ch;
    margin: 0
}

.wx-h1 em {
    font-style: normal;
    color: var(--blue)
}

.wx-page .wx-h2 {
    font-size: clamp(34px, 5vw, 84px);
    line-height: .98;
    letter-spacing: -.05em;
    max-width: 16ch;
    margin: 18px 0 0
}

.wx-page .wx-h2.wx-big {
    font-size: clamp(40px, 6.4vw, 110px);
    max-width: 12ch
}

.wx-sub {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.5;
    color: #34353f;
    max-width: 34em;
    margin: 0
}

.wx-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px
}

.btn.wx-out {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink)
}

/* HERO */
.wx-hero {
    padding: clamp(120px, 12vw, 170px) 0 clamp(40px, 5vw, 70px)
}

.wx-hero-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-top: clamp(22px, 3vw, 40px)
}

.wx-stage {
    position: relative;
    width: min(1280px, 94vw);
    margin: clamp(30px, 4vw, 60px) auto 0;
    aspect-ratio: 16/8.4
}

.wx-l {
    position: absolute
}

.wx-blob {
    position: absolute;
    left: 30%;
    top: 6%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: 46% 54% 50% 50%/52% 44% 56% 48%;
    background: radial-gradient(circle at 30% 25%, #9d9bd2, var(--blue) 55%, var(--blue2));
    filter: blur(.5px);
    opacity: .95
}

.wx-L1 {
    left: 4%;
    top: 2%;
    width: 60%;
    z-index: 2
}

.wx-L2 {
    left: 58%;
    top: 10%;
    width: 15.5%;
    z-index: 4
}

.wx-L3 {
    left: 0;
    bottom: 2%;
    width: 25%;
    z-index: 5
}

.wx-L4 {
    right: 1%;
    top: 0;
    width: 23%;
    z-index: 3
}

.wx-L5 {
    right: 3%;
    bottom: 0;
    width: 27%;
    z-index: 5
}

.wx-L6 {
    left: 43%;
    bottom: -3%;
    width: 9.5%;
    min-width: 84px;
    z-index: 6
}

.wx-win {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 50px 80px -34px rgba(59, 57, 120, .55)
}

.wx-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #f4f2fa
}

.wx-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff5f57
}

.wx-bar i:nth-child(2) {
    background: #febc2e
}

.wx-bar i:nth-child(3) {
    background: #28c840
}

.wx-url {
    margin-left: 10px;
    flex: 1;
    max-width: 220px;
    background: #fff;
    border-radius: 99px;
    font: 500 10px Inter, sans-serif;
    padding: 4px 10px;
    color: #777
}

.wx-shot {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #ece9f7
}

.wx-shot img,
.wx-phone img,
.wx-round img,
.wx-exp-pic img,
.wx-b img,
.wx-tilt img,
.wx-cta-pic img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block
}

.wx-empty {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #d6d4ee, #8b88c8)
}

.wx-ov {
    position: absolute;
    left: 5%;
    top: 9%;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 42%
}

.wx-ov b {
    height: 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, .9)
}

.wx-ov b:nth-child(2) {
    width: 70%
}

.wx-ov b:nth-child(3) {
    width: 50%;
    opacity: .7
}

.wx-ov span {
    margin-top: 6px;
    width: 34%;
    height: 16px;
    border-radius: 99px;
    background: var(--blue)
}

.wx-phone {
    position: relative;
    aspect-ratio: 9/19;
    border-radius: 28px;
    border: 6px solid #12131f;
    background: #12131f;
    overflow: hidden;
    box-shadow: 0 40px 60px -26px rgba(10, 11, 20, .55)
}

.wx-dash {
    background: #fff;
    border-radius: 18px;
    padding: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 36px 50px -26px rgba(59, 57, 120, .5)
}

.wx-dash small {
    display: block;
    font: 600 10px Inter, sans-serif;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 12px
}

.wx-dash div {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: clamp(48px, 6vw, 90px)
}

.wx-dash i {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--blue), #b3b1dc)
}

.wx-round {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 40px 60px -28px rgba(10, 11, 20, .5);
    background: #d6d4ee
}

.wx-code {
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #12131f;
    color: #cfd2ee;
    font: 600 clamp(9px, .95vw, 13px)/1.6 ui-monospace, Consolas, monospace;
    border-radius: 16px;
    padding: 16px 18px;
    box-shadow: 0 36px 50px -24px rgba(10, 11, 20, .6)
}

.wx-badge {
    display: block;
    width: 100%;
    animation: wx-spin 14s linear infinite
}

@keyframes wx-spin {
    to {
        transform: rotate(360deg)
    }
}

/* MARQUEE */
.wx-mq {
    overflow: hidden;
    padding: clamp(34px, 5vw, 70px) 0;
    border-block: 1px solid var(--line);
    display: grid;
    gap: 14px
}

.wx-mq-row {
    overflow: hidden
}

.wx-mq-in {
    display: flex;
    width: max-content;
    animation: wx-mq 46s linear infinite
}

.wx-rev .wx-mq-in {
    animation-direction: reverse;
    animation-duration: 58s
}

.wx-mq:hover .wx-mq-in {
    animation-play-state: paused
}

@keyframes wx-mq {
    to {
        transform: translateX(-50%)
    }
}

.wx-mq-in span {
    display: flex;
    align-items: center;
    gap: clamp(22px, 3vw, 44px);
    padding-right: clamp(22px, 3vw, 44px);
    font: 700 clamp(34px, 6vw, 92px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    white-space: nowrap
}

.wx-mq-in i {
    width: .3em;
    height: .3em;
    border-radius: 50%;
    background: var(--blue);
    flex: none
}

.wx-rev .wx-mq-in span {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink)
}

/* WHAT WE BUILD: horizontal */
.wx-hs {
    padding: clamp(70px, 9vw, 130px) 0 clamp(50px, 6vw, 90px);
    background: var(--cream2);
    overflow: hidden
}

.wx-hs-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(30px, 4vw, 56px)
}

.wx-hs-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    font: 600 12px Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #777
}

.wx-hs-bar i {
    display: block;
    width: clamp(90px, 14vw, 200px);
    height: 2px;
    background: var(--blue);
    transform-origin: left;
    transform: scaleX(0)
}

.wx-hs-track {
    display: flex;
    gap: clamp(16px, 2vw, 28px);
    padding: 0 clamp(20px, 8vw, 120px) 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none
}

.wx-hs-track::-webkit-scrollbar {
    display: none
}

.wx-panel {
    flex: none;
    scroll-snap-align: start;
    width: min(88vw, 1060px);
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(20px, 3vw, 48px);
    align-items: center;
    padding: clamp(24px, 3.2vw, 48px);
    border-radius: 36px;
    background: #fff;
    border: 1px solid var(--line)
}

.wx-panel:nth-child(even) {
    background: #e6e3f5
}

.wx-num {
    display: block;
    font: 800 clamp(72px, 10vw, 170px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--blue);
    margin-bottom: clamp(18px, 2.4vw, 34px)
}

.wx-panel h3 {
    font-size: clamp(26px, 2.8vw, 44px);
    letter-spacing: -.045em;
    line-height: 1;
    margin: 0 0 12px
}

.wx-panel p {
    color: #4a4b55;
    line-height: 1.55;
    max-width: 30em;
    margin: 0
}

.wx-panel ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0
}

.wx-panel li {
    padding: 7px 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, .7);
    font: 600 13px Inter, sans-serif
}

.wx-panel-vis .wx-win {
    box-shadow: 0 40px 60px -34px rgba(59, 57, 120, .5)
}

.wx-mk {
    padding: 22px;
    aspect-ratio: 16/10;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: linear-gradient(180deg, #fff, #f4f2fa)
}

.wx-mk-h {
    height: 22px;
    width: 60%;
    border-radius: 8px;
    background: var(--ink)
}

.wx-mk-p {
    height: 9px;
    width: 78%;
    border-radius: 6px;
    background: #d9d7e6
}

.wx-mk-p.s {
    width: 52%
}

.wx-mk-b {
    height: 20px;
    width: 26%;
    border-radius: 99px;
    background: var(--blue);
    margin-bottom: 8px
}

.wx-mk-g {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    flex: 1
}

.wx-mk-g i {
    border-radius: 12px;
    background: linear-gradient(145deg, #d6d4ee, #9d9bd2)
}

.wx-ad {
    display: grid;
    grid-template-columns: 70px 1fr;
    aspect-ratio: 16/10;
    background: #fff
}

.wx-ad aside {
    background: var(--blue2);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px
}

.wx-ad aside i {
    height: 8px;
    border-radius: 5px;
    background: rgba(255, 255, 255, .55)
}

.wx-ad div {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px
}

.wx-ad p {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0
}

.wx-ad p b {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: #e6e3f5;
    flex: none
}

.wx-ad p span {
    height: 9px;
    border-radius: 6px;
    background: #d9d7e6
}

.wx-ad p em {
    margin-left: auto;
    width: 42px;
    height: 16px;
    border-radius: 99px;
    background: rgba(63, 227, 63, .25)
}

.wx-ap {
    aspect-ratio: 16/10;
    padding: 18px;
    background: #fff;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: 1.5fr 1fr;
    gap: 14px
}

.wx-ap-k {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px
}

.wx-ap-k i {
    height: 34px;
    border-radius: 12px;
    background: #f1effa
}

.wx-ap svg {
    width: 100%;
    height: 100%;
    display: block
}

.wx-ap-b {
    display: flex;
    align-items: flex-end;
    gap: 8px
}

.wx-ap-b i {
    flex: 1;
    border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--blue), #b3b1dc)
}

.wx-js .wx-hs {
    overflow: hidden
}

@media(min-width:901px) {
    .wx-js .wx-hs {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-block: clamp(60px, 6vw, 90px)
    }

    .wx-js .wx-hs-track {
        overflow: visible;
        width: max-content;
        scroll-snap-type: none
    }
}

/* EXPERTISE: pinned */
.wx-exp {
    padding: clamp(70px, 8vw, 120px) 0;
    background: var(--cream)
}

.wx-exp-grid {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: center
}

.wx-exp-list {
    list-style: none;
    margin: clamp(24px, 3vw, 44px) 0 0;
    padding: 0;
    border-top: 1px solid var(--ink)
}

.wx-exp-item {
    all: unset;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 2px 14px;
    width: 100%;
    cursor: pointer;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    opacity: .38;
    transition: opacity .4s var(--o), padding .5s var(--o)
}

.wx-exp-item:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px
}

.wx-exp-item b {
    grid-row: 1/3;
    font: 600 13px Inter, sans-serif;
    color: var(--blue);
    padding-top: .8em
}

.wx-et {
    font: 700 clamp(26px, 3.3vw, 52px)/1.05 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.045em
}

.wx-ed {
    font-size: 14.5px;
    line-height: 1.5;
    color: #4a4b55;
    max-height: 0;
    overflow: hidden;
    transition: max-height .5s var(--o)
}

.wx-exp-item.on {
    opacity: 1;
    padding-left: 10px
}

.wx-exp-item.on .wx-ed {
    max-height: 5em
}

.wx-exp-item:hover {
    opacity: .8
}

.wx-exp-frame {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 220px 220px 32px 32px;
    overflow: hidden;
    background: #d6d4ee;
    box-shadow: 0 50px 80px -40px rgba(59, 57, 120, .55)
}

.wx-exp-pic {
    position: absolute;
    inset: 0;
    overflow: hidden
}

.wx-exp-pic:not(:first-child) {
    clip-path: inset(100% 0 0 0)
}

@media(min-width:901px) {
    .wx-js .wx-exp {
        min-height: 100vh;
        display: grid;
        align-items: center
    }
}

/* BENTO */
.wx-bento {
    padding: clamp(70px, 9vw, 130px) 0;
    background: var(--cream2)
}

.wx-bg {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(70px, 8vw, 120px);
    gap: clamp(12px, 1.6vw, 22px);
    margin-top: clamp(34px, 4vw, 60px)
}

.wx-b {
    position: relative;
    margin: 0;
    border-radius: 26px;
    overflow: hidden;
    background: #d6d4ee
}

.wx-b figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    background: rgba(255, 255, 255, .88);
    backdrop-filter: blur(8px);
    border-radius: 99px;
    padding: 7px 14px;
    font: 600 12px/1 Inter, sans-serif
}

.wx-b1 {
    grid-column: 1/8;
    grid-row: 1/5
}

.wx-b2 {
    grid-column: 8/13;
    grid-row: 1/4
}

.wx-b3 {
    grid-column: 8/13;
    grid-row: 4/7
}

.wx-b4 {
    grid-column: 1/5;
    grid-row: 5/8
}

.wx-b5 {
    grid-column: 5/8;
    grid-row: 5/8
}

/* PROCESS rows */
.wx-proc {
    padding: clamp(70px, 9vw, 130px) 0
}

.wx-rows {
    list-style: none;
    margin: clamp(34px, 4vw, 60px) 0 0;
    padding: 0
}

.wx-row {
    position: relative;
    display: grid;
    grid-template-columns: clamp(90px, 14vw, 220px) 1.1fr 1fr;
    gap: 20px;
    align-items: center;
    padding: clamp(22px, 3vw, 40px) 0;
    transition: padding .6s var(--o), background .4s
}

.wx-rline {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--ink);
    transform-origin: left
}

.wx-rn {
    font: 800 clamp(56px, 9vw, 150px)/.85 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    transition: color .6s var(--o), -webkit-text-stroke-color .6s var(--o)
}

.wx-row.on .wx-rn {
    color: var(--blue);
    -webkit-text-stroke-color: var(--blue)
}

.wx-row h3 {
    font-size: clamp(28px, 4vw, 64px);
    letter-spacing: -.05em;
    line-height: 1;
    margin: 0
}

.wx-row p {
    color: #4a4b55;
    max-width: 26em;
    line-height: 1.55;
    margin: 0
}

.wx-row:hover {
    padding-left: clamp(10px, 2vw, 28px)
}

/* WHY */
.wx-why {
    padding: clamp(80px, 10vw, 150px) 0;
    background: var(--blue);
    color: #fff
}

.wx-why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: center
}

.wx-count {
    font: 800 clamp(110px, 18vw, 300px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.07em;
    margin: clamp(20px, 3vw, 40px) 0 14px;
    color: var(--ink)
}

.wx-why-s {
    max-width: 20em;
    color: #ecebf7;
    margin: 0 0 clamp(24px, 3vw, 40px)
}

.wx-tilt {
    position: relative;
    aspect-ratio: 16/10;
    max-width: 480px;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 40px 60px -30px rgba(10, 11, 20, .6);
    background: #8b88c8
}

.wx-why-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px
}

.wx-why-list li {
    padding: clamp(22px, 2.6vw, 34px);
    border-radius: 26px;
    background: rgba(255, 255, 255, .1);
    border: 1px solid rgba(255, 255, 255, .22);
    transition: background .4s, translate .5s var(--o)
}

.wx-why-list li:hover {
    background: rgba(255, 255, 255, .18);
    translate: 8px 0
}

.wx-why-list small {
    font: 600 13px Inter, sans-serif;
    color: var(--green)
}

.wx-why-list h3 {
    font-size: clamp(22px, 2.2vw, 32px);
    letter-spacing: -.04em;
    margin: 14px 0 6px;
    line-height: 1.05
}

.wx-why-list p {
    margin: 0;
    color: #ecebf7;
    font-size: 15px;
    line-height: 1.5
}

/* TECH */
.wx-tech {
    padding: clamp(70px, 9vw, 130px) 0
}

.wx-pills {
    list-style: none;
    margin: clamp(30px, 4vw, 56px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px
}

.wx-pills li {
    padding: clamp(12px, 1.6vw, 22px) clamp(22px, 3vw, 44px);
    border-radius: 99px;
    border: 1.5px solid var(--ink);
    font: 700 clamp(20px, 3vw, 46px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    transition: background .3s, color .3s, border-color .3s, translate .5s var(--o)
}

.wx-pills li:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    translate: 0 -6px
}

/* FAQ */
.wx-faq {
    padding: clamp(70px, 9vw, 130px) 0;
    background: var(--cream2)
}

.wx-faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: start
}

.wx-faq-list {
    border-top: 1px solid var(--ink)
}

.wx-faq-list details {
    border-bottom: 1px solid var(--line)
}

.wx-faq-list summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    font: 600 clamp(17px, 1.5vw, 21px)/1.25 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.wx-faq-list summary::-webkit-details-marker {
    display: none
}

.wx-faq-list summary i {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    transition: transform .4s var(--o)
}

.wx-faq-list summary i::before,
.wx-faq-list summary i::after {
    content: "";
    position: absolute;
    left: 3px;
    right: 3px;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--blue);
    border-radius: 2px
}

.wx-faq-list summary i::after {
    transform: rotate(90deg)
}

.wx-faq-list details[open] summary i {
    transform: rotate(135deg)
}

.wx-faq-list details p {
    padding: 0 40px 24px 0;
    color: #4a4b55;
    max-width: 56ch;
    line-height: 1.6;
    margin: 0
}

/* CTA */
.wx-cta-s {
    padding: clamp(80px, 10vw, 150px) 0
}

.wx-cta-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(30px, 5vw, 80px);
    align-items: center
}

.wx-cta-s .wx-sub {
    margin: 22px 0 28px
}

.wx-contact {
    margin: 26px 0 0;
    font-size: 14px;
    color: #4a4b55
}

.wx-contact a {
    text-decoration: underline
}

.wx-cta-pic {
    position: relative;
    aspect-ratio: 4/5;
    border-radius: 34px;
    overflow: hidden;
    background: #d6d4ee;
    box-shadow: 0 50px 80px -36px rgba(59, 57, 120, .55);
    transform: rotate(3deg)
}

/* RESPONSIVE */
@media(max-width:1000px) {

    .wx-exp-grid,
    .wx-why-grid,
    .wx-faq-grid,
    .wx-cta-grid {
        grid-template-columns: minmax(0, 1fr)
    }

    .wx-row {
        grid-template-columns: 90px 1fr
    }

    .wx-row p {
        grid-column: 2
    }

    .wx-exp-frame {
        max-width: 520px;
        margin: 0 auto;
        order: -1
    }
}

@media(max-width:900px) {
    .wx-panel {
        grid-template-columns: minmax(0, 1fr);
        width: 86vw
    }

    .wx-hs-bar {
        display: none
    }

    .wx-bg {
        grid-template-columns: repeat(2, 1fr);
        grid-auto-rows: clamp(110px, 26vw, 190px)
    }

    .wx-b1 {
        grid-column: 1/3;
        grid-row: auto/span 2
    }

    .wx-b2,
    .wx-b3,
    .wx-b4,
    .wx-b5 {
        grid-column: auto;
        grid-row: auto/span 2
    }

    .wx-b3 {
        grid-column: 1/3
    }
}

@media(max-width:700px) {
    .wx-stage {
        aspect-ratio: 1/1.05
    }

    .wx-L1 {
        left: 0;
        top: 2%;
        width: 78%
    }

    .wx-L2 {
        left: 60%;
        top: 30%;
        width: 30%
    }

    .wx-L3 {
        display: none
    }

    .wx-L4 {
        right: 0;
        top: 0;
        width: 34%
    }

    .wx-L5 {
        display: none
    }

    .wx-L6 {
        left: 6%;
        bottom: 2%;
        width: 22%
    }

    .wx-hero-row {
        flex-direction: column;
        align-items: flex-start
    }

    .wx-row {
        grid-template-columns: 64px 1fr
    }
}

@media(prefers-reduced-motion:reduce) {

    .wx-mq-in,
    .wx-badge {
        animation: none
    }
}

/* WX IMAGES */
.wx-xwide {
    aspect-ratio: 21/8;
    margin-top: clamp(30px, 4vw, 56px)
}

.wx-xtall {
    aspect-ratio: 4/5;
    max-width: 420px;
    margin-top: clamp(24px, 3vw, 40px)
}

@media(max-width:900px) {
    .wx-xwide {
        aspect-ratio: 16/10
    }

    .wx-xtall {
        aspect-ratio: 16/10;
        max-width: none
    }
}

/* WX TYPE */
/* restore section spacing (".wx-page section{padding:0}" was overriding every section) */
.wx-page .wx-hero {
    padding: clamp(112px, 10vw, 150px) 0 clamp(36px, 4vw, 60px)
}

.wx-page .wx-hs {
    padding: clamp(56px, 7vw, 100px) 0 clamp(44px, 5vw, 72px);
    overflow: hidden
}

.wx-page .wx-exp,
.wx-page .wx-bento,
.wx-page .wx-proc,
.wx-page .wx-tech,
.wx-page .wx-faq {
    padding: clamp(56px, 7vw, 100px) 0
}

.wx-page .wx-why,
.wx-page .wx-cta-s {
    padding: clamp(64px, 8vw, 110px) 0
}

.wx-w {
    padding-top: .08em;
    margin-top: -.08em
}

/* hierarchy: H1 > H2 > panel/row titles > body */
.wx-page .wx-h1 {
    font-size: clamp(38px, 5.6vw, 92px);
    line-height: .96;
    letter-spacing: -.055em;
    max-width: 16ch
}

.wx-eyebrow {
    font-size: 11px;
    margin-bottom: clamp(16px, 2vw, 24px)
}

.wx-sub {
    font-size: clamp(15px, 1.15vw, 18px);
    line-height: 1.55;
    max-width: 32em
}

.wx-hero-row {
    margin-top: clamp(20px, 2.4vw, 32px)
}

.wx-page .wx-h2 {
    font-size: clamp(30px, 3.9vw, 62px);
    line-height: 1.02;
    letter-spacing: -.045em;
    max-width: 18ch;
    margin-top: 16px
}

.wx-page .wx-h2.wx-big {
    font-size: clamp(34px, 5.2vw, 86px);
    max-width: 13ch
}

.wx-mq {
    padding: clamp(26px, 3.6vw, 50px) 0
}

.wx-mq-in span {
    font-size: clamp(26px, 4.2vw, 62px)
}

.wx-num {
    font-size: clamp(56px, 7vw, 112px);
    margin-bottom: clamp(14px, 1.8vw, 26px)
}

.wx-panel h3 {
    font-size: clamp(22px, 2.1vw, 32px);
    letter-spacing: -.04em
}

.wx-panel p {
    font-size: 15px
}

.wx-et {
    font-size: clamp(22px, 2.5vw, 38px)
}

.wx-exp-item {
    padding: 14px 0
}

.wx-ed {
    font-size: 14px
}

.wx-rn {
    font-size: clamp(44px, 6vw, 92px)
}

.wx-row h3 {
    font-size: clamp(24px, 2.9vw, 44px)
}

.wx-row {
    padding: clamp(18px, 2.4vw, 30px) 0
}

@media(min-width:1001px) {
    .wx-row {
        grid-template-columns: clamp(80px, 11vw, 170px) 1.1fr 1fr
    }
}

.wx-row p {
    font-size: 15px
}

.wx-count {
    font-size: clamp(84px, 11vw, 190px);
    margin: clamp(14px, 2vw, 26px) 0 10px
}

.wx-why-list li {
    padding: clamp(18px, 2vw, 28px)
}

.wx-why-list h3 {
    font-size: clamp(19px, 1.7vw, 26px)
}

.wx-why-list p {
    font-size: 14.5px
}

.wx-pills li {
    font-size: clamp(16px, 1.9vw, 26px);
    padding: clamp(10px, 1.2vw, 16px) clamp(18px, 2.2vw, 32px)
}

.wx-faq-list summary {
    font-size: clamp(16px, 1.3vw, 19px)
}

.wx-faq-list details p {
    font-size: 15px
}

.wx-contact {
    font-size: 13.5px
}

/* ===== ROUND 35: stat card hover ===== */
@media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .about .stats>div {
        transition: transform .5s cubic-bezier(.2, .7, .2, 1), background-color .4s
    }

    .about .stats>div:hover {
        transform: translateY(-10px)
    }

    .about .stats>div:not(:nth-child(2 of :has(>b))):hover {
        background: #d6d1f3 !important
    }

    .about .stats>div:nth-child(2 of :has(>b)) {
        background-size: 140% 140% !important;
        background-position: 0% 0%;
        transition: transform .5s cubic-bezier(.2, .7, .2, 1), background-position .8s ease
    }

    .about .stats>div:nth-child(2 of :has(>b)):hover {
        background-position: 100% 100%
    }
}

/* ===== ROUND 36: premium stat card hover ===== */
.about .stats>div {
    isolation: isolate
}

.about .stats>div b,
.about .stats>div small {
    position: relative;
    z-index: 2
}

.about .stats>div::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .65), transparent 70%);
    transition: opacity .5s ease
}

.about .stats>div:nth-child(2 of :has(>b))::before {
    content: "";
    position: absolute;
    inset: -20% auto -20% -60%;
    width: 40%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .35), transparent);
    transform: skewX(-18deg);
    opacity: 0
}

@media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .about .stats>div {
        transition: transform .7s cubic-bezier(.16, 1, .3, 1), box-shadow .7s cubic-bezier(.16, 1, .3, 1), background-color .5s
    }

    .about .stats>div:hover {
        transform: translateY(-12px) !important;
        box-shadow: 0 30px 50px -28px rgba(75, 47, 208, .45)
    }

    .about .stats>div:hover::after {
        opacity: 1
    }

    .about .stats>div:nth-child(2 of :has(>b)):hover::before {
        opacity: 1;
        animation: statSheen 1.2s cubic-bezier(.16, 1, .3, 1) forwards
    }

    .about .stats>div b i {
        display: inline-block;
        transition: transform .6s cubic-bezier(.16, 1, .3, 1)
    }

    .about .stats>div:hover b i {
        transform: translateY(-6px) rotate(8deg)
    }
}

@keyframes statSheen {
    from {
        left: -60%
    }

    to {
        left: 140%
    }
}

.about .stats>div {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 300px
}

.about .sico {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, currentColor 14%, transparent)
}

.about .sico svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round
}

.about .sbody small {
    display: block;
    margin-top: 14px
}

/* stats icon fix */
.about .stats>div {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    min-height: 300px
}

.about .stats>div .sico {
    margin-bottom: auto;
    position: relative;
    z-index: 2;
    color: #4b2fd0
}

.about .stats>div:nth-child(2 of :has(>b)) .sico {
    color: #fff
}


/* stats card size */
.about .stats>div {
    min-height: 230px !important;
    height: auto !important;
    padding: 22px !important;
    scale: 1 !important
}

.about .stats>div b {
    font-size: clamp(44px, 5vw, 72px) !important
}

/* stats: GSAP owns transform, no CSS springs */
.about .stats>div {
    transition: box-shadow .5s, background-color .5s !important
}

.about .stats>div:hover .sico {
    animation: none !important
}


/* why: planner board */
.why {
    overflow-x: clip
}

.why .wstage {
    margin-top: clamp(32px, 4vw, 56px);
    perspective: 1600px
}


.why .wbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 16px 22px;
    border-bottom: 1px solid #2a2d45
}

.why .wbar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #33364f
}

.why .wbar span {
    margin-left: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #9a9bb2
}

.why .wcells {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr))
}

.why .wcell {
    position: relative;
    min-height: 230px;
    padding: 18px;
    border-right: 1px solid #23263c;
    border-bottom: 1px solid #23263c
}

.why .wcell:nth-child(3n) {
    border-right: 0
}

.why .wcell:nth-child(n+4) {
    border-bottom: 0
}

.why .wcell>small {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 11px;
    font-weight: 600;
    color: #5a5d78;
    opacity: 1
}

.why .wcard {
    position: relative;
    height: 100%;
    padding: 20px;
    border-radius: 18px;
    background: #f6f3ee;
    color: #14112b;
    display: flex;
    flex-direction: column;
    box-shadow: 0 22px 30px -18px rgba(0, 0, 0, .75), inset 0 1px 0 #fff;
    transform: rotate(var(--r, -2deg));
    transition: transform .5s cubic-bezier(.22, 1, .36, 1), box-shadow .5s
}

.why .wcard:hover {
    transform: rotate(0) translateY(-8px) scale(1.03);
    box-shadow: 0 34px 40px -20px rgba(0, 0, 0, .85), inset 0 1px 0 #fff
}

.why .wic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--g);
    margin-bottom: auto;
    box-shadow: 0 10px 16px -8px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .35)
}

.why .wic svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round
}

.why .wcard h3 {
    margin: 18px 0 0 !important;
    font-size: 19px !important;
    font-weight: 700;
    letter-spacing: -.025em;
    line-height: 1.15 !important;
    color: #14112b !important
}

.why .wcard p {
    margin: 8px 0 0 !important;
    font-size: 13px !important;
    line-height: 1.5 !important;
    color: #5b5870 !important;
    max-width: none !important;
    opacity: 1 !important
}

.why .wc1 {
    --g: linear-gradient(145deg, #3b55d9, #6a85f5);
    --r: -2.5deg
}

.why .wc2 {
    --g: linear-gradient(145deg, #178a3a, #3cc062);
    --r: 1.8deg
}

.why .wc3 {
    --g: linear-gradient(145deg, #d4561a, #c4246b 60%, #6f2a9e);
    --r: -1.5deg
}

.why .wc4 {
    --g: linear-gradient(145deg, #4a30d1, #8668f0);
    --r: 2deg
}

.why .wc5 {
    --g: linear-gradient(145deg, #0b8584, #2fc4b4);
    --r: -2deg
}

.why .wc6 {
    --g: linear-gradient(145deg, #c93036, #ee6a62);
    --r: 1.5deg
}

@media (max-width:900px) {
    .why .wcells {
        grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .why .wcell:nth-child(n) {
        border-right: 1px solid #23263c;
        border-bottom: 1px solid #23263c
    }

    .why .wcell:nth-child(2n) {
        border-right: 0
    }
}

@media (max-width:560px) {
    .why .wcells {
        grid-template-columns: 1fr
    }

    .why .wcell:nth-child(n) {
        border-right: 0
    }

    .why .wcell {
        min-height: 0
    }

    .why .wcard {
        min-height: 190px
    }
}

@media (prefers-reduced-motion:reduce) {
    .why .wcard {
        transition: none
    }
}


/* ===== WHY BOARD POLISH ===== */
/* room for the corner number so cards never cover it */
.why .wcell {
    padding: 34px 14px 14px !important;
    min-height: 210px !important
}

/* cards straight, tilt comes from the board only */
.why .wstage .wcard {
    transform: none
}

.why .wstage .wcard:hover {
    transform: translateY(-8px) scale(1.03)
}

/* tighter card: icon top, text pinned to bottom */
.why .wstage .wcard {
    justify-content: space-between;
    padding: 18px 20px 20px
}

.why .wstage .wcard h3 {
    margin: 0 !important;
    font-size: 20px !important
}

.why .wstage .wcard p {
    margin: 6px 0 0 !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
    color: #46425c !important
}


/* ===== WHY SOFTSARO: PATH LAYOUT ===== */
.why.wsec {
    padding: clamp(48px, 6vw, 84px) 0;
    background: radial-gradient(60% 70% at 100% 55%, #6a67ae55, transparent 70%), repeating-linear-gradient(90deg, #ffffff07 0 1px, transparent 1px 96px), var(--ink)
}

.why.wsec .wrap {
    max-width: 1320px;
    padding: 0 clamp(20px, 4vw, 64px)
}

.why.wsec .lab {
    margin-bottom: 16px
}

.why.wsec .wp-h {
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.12;
    letter-spacing: -.045em;
    max-width: 20ch;
    margin: 0
}

.why.wsec .wp-h mark {
    background: var(--blue);
    color: #fff;
    padding: .02em .22em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone
}

.wp-board {
    position: relative;
    margin-top: clamp(20px, 2.5vw, 36px)
}

.wp-svg {
    display: none;
    width: 100%;
    height: auto;
    overflow: visible
}

.wp-track {
    fill: none;
    stroke: url(#wptg);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 8px #6a67ae88)
}

.wp-ln line {
    stroke: #ffffff4d;
    stroke-width: 1
}

.wp-ln circle {
    fill: #fff
}

.wp-join {
    fill: var(--green)
}

.wp-node {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--cream);
    color: var(--blue2);
    box-shadow: 0 14px 30px -10px #000c, 0 0 0 6px #ffffff10
}

.wp-node svg {
    width: 48%;
    height: 48%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round
}

.wp-txt h3 {
    margin: 0 0 5px;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.15;
    letter-spacing: -.025em;
    font-weight: 700;
    color: #fff
}

.wp-txt p {
    margin: 0;
    max-width: none;
    font-size: clamp(12.5px, 1vw, 13.5px);
    line-height: 1.45;
    color: #c4c3d6
}

.wp-it {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 16px;
    position: relative;
    padding-bottom: 22px
}

.wp-it:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 29px;
    top: 62px;
    bottom: 2px;
    width: 2px;
    background: linear-gradient(var(--blue), #6a67ae22)
}

.wp-it .wp-node {
    width: 60px;
    height: 60px
}

@media(min-width:980px) {
    .wp-board {
        aspect-ratio: 1200/560
    }

    .wp-svg {
        display: block;
        position: absolute;
        inset: 0;
        height: 100%
    }

    .wp-it {
        display: contents
    }

    .wp-it::before {
        display: none
    }

    .wp-node,
    .wp-txt {
        position: absolute
    }

    .wp-it .wp-node {
        left: calc(var(--cx) / 12 * 1%);
        top: calc(var(--cy) / 560 * 100%);
        width: calc(116 / 12 * 1%);
        height: auto;
        aspect-ratio: 1;
        transform: translate(-50%, -50%)
    }

    .wp-txt {
        left: calc(var(--cx) / 12 * 1%);
        width: calc(190 / 12 * 1%);
        transform: translateX(-50%);
        text-align: center
    }

    .wp-txt.up {
        bottom: calc(430 / 560 * 100%)
    }

    .wp-txt.down {
        top: calc(440 / 560 * 100%)
    }
}

.wp-js .wp-track {
    stroke-dasharray: 1;
    stroke-dashoffset: 1
}

.wp-js .wp-node {
    opacity: 0;
    scale: .6
}

.wp-js .wp-txt,
.wp-js .wp-ln,
.wp-js .wp-join {
    opacity: 0
}

.wp-js .wp-txt {
    translate: 0 10px
}

.wp-js .wp-board.in .wp-track {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 2.4s cubic-bezier(.5, 0, .2, 1)
}

.wp-js .wp-board.in .wp-node {
    opacity: 1;
    scale: 1;
    transition: opacity .5s, scale .8s cubic-bezier(.34, 1.56, .64, 1);
    transition-delay: calc(var(--n)*.4s + .2s)
}

.wp-js .wp-board.in .wp-ln,
.wp-js .wp-board.in .wp-join {
    opacity: 1;
    transition: opacity .5s;
    transition-delay: calc(var(--n)*.4s + .5s)
}

.wp-js .wp-board.in .wp-txt {
    opacity: 1;
    translate: 0 0;
    transition: opacity .7s, translate .9s cubic-bezier(.16, 1, .3, 1);
    transition-delay: calc(var(--n)*.4s + .55s)
}

@media(max-width:979px) {
    .wp-js .wp-track {
        display: none
    }
}

@media(prefers-reduced-motion:reduce) {

    .wp-js .wp-node,
    .wp-js .wp-txt,
    .wp-js .wp-ln,
    .wp-js .wp-join {
        opacity: 1;
        scale: 1;
        translate: none
    }

    .wp-js .wp-track {
        stroke-dashoffset: 0
    }
}

/* ===== WHY: remove highlight block ===== */
.why.wsec .wp-h mark {
    background: none !important;
    color: inherit !important;
    padding: 0 !important
}


/* ===== WHY: scroll-linked draw ===== */
.wp-js .wp-board .wp-node {
    opacity: var(--o, 0);
    scale: var(--s, .6);
    transition: none !important
}

.wp-js .wp-board .wp-txt {
    opacity: var(--o, 0);
    translate: 0 calc(var(--ty, 14) * 1px);
    transition: none !important
}

.wp-js .wp-board .wp-ln,
.wp-js .wp-board .wp-join {
    transition: none !important
}

.wp-js .wp-board .wp-track {
    transition: none !important
}
.wp-js .wp-board .wp-node{opacity:var(--o,0);scale:var(--s,.6);transition:none !important}
.wp-js .wp-board .wp-txt{opacity:var(--o,0);translate:0 calc(var(--ty,14) * 1px);transition:none !important}
.wp-js .wp-board .wp-ln,.wp-js .wp-board .wp-join{transition:none !important}

.price-extra{margin:0 0 26px}.price-extra h3{margin:0 0 10px;font:700 14px/1.1 Inter,sans-serif;text-decoration:underline;text-underline-offset:4px}.price-extra p{display:flex;gap:10px;margin:0 0 9px;font-size:13px;line-height:1.35}.price-extra p i{font-style:normal;color:#438d50;font-weight:800}.price-extra--excluded p i{color:#e95568}.price-card--featured .price-extra p i{color:#54dc6e}

/* Expanded menu groups must take space in the desktop grid. */
@media(min-width:701px){.menu-links .menu-sw .msub{position:static;width:auto}.menu-links{align-items:start}.menu-links .menu-sw{align-self:start}}

.price-feature-group{margin:28px 0}.price-feature-group h3{margin:0 0 12px;font:700 15px/1.1 Inter,sans-serif;text-decoration:underline;text-underline-offset:5px}.price-feature-group ul{margin:0;gap:10px}.price-feature-group li{font-size:12px}.price-feature-group li.is-excluded i{color:#e95568}.price-card--featured .price-feature-group li.is-excluded i{color:#ff8a99}

.price-card{isolation:isolate;transform-style:preserve-3d}.price-card::before{content:"";position:absolute;z-index:-1;inset:0;border-radius:inherit;opacity:0;background:radial-gradient(260px circle at var(--px,50%) var(--py,50%),#ffffffb8,transparent 68%);transition:opacity .45s}.price-card:hover::before{opacity:.72}.price-card--featured::before{background:radial-gradient(280px circle at var(--px,50%) var(--py,50%),#b8b5ff88,transparent 70%)}.price-card .price-action{position:relative}.price-card .price-action::after{content:"";position:absolute;inset:auto 0 -1px;width:100%;height:2px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .45s var(--o)}.price-card:hover .price-action::after{transform:scaleX(1)}

.price-card button.price-action{width:100%;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer}.plan-modal-open{overflow:hidden}.plan-modal{position:fixed;z-index:200;inset:0;display:grid;place-items:center;padding:20px;background:#090a14a6;backdrop-filter:blur(12px);animation:planFade .3s ease both}.plan-modal-card{display:grid;grid-template-columns:minmax(230px,.94fr) minmax(340px,1.06fr);width:min(860px,100%);min-height:430px;overflow:hidden;border-radius:16px;background:#fff;box-shadow:0 35px 90px #0009;animation:planLift .55s cubic-bezier(.16,1,.3,1) both}.plan-modal-card aside{padding:30px clamp(24px,4vw,46px);background:linear-gradient(145deg,#9997ff,#7472df);color:#fff}.plan-modal-card aside p{margin:0;font:700 clamp(24px,2.3vw,34px)/1 var(--font-inter),Inter,sans-serif}.plan-modal-card aside strong{display:block;font:800 clamp(48px,5vw,72px)/.8 var(--font-inter),Inter,sans-serif;letter-spacing:-.06em}.plan-modal-form{position:relative;padding:30px clamp(26px,4vw,48px);color:#202230}.plan-modal-form h2{margin:0 36px 24px 0;font:650 17px/1.2 Inter,sans-serif;letter-spacing:.01em}.plan-modal-close{position:absolute;top:13px;right:13px;width:30px;height:30px;border:0;border-radius:9px;background:#7c79e5;color:#fff;font-size:25px;line-height:1;cursor:pointer;transition:transform .3s var(--o)}.plan-modal-close:hover{transform:rotate(90deg) scale(1.08)}.plan-modal-form form{display:grid;gap:17px}.plan-modal-form label{display:grid;gap:8px;font:600 12px/1.2 Inter,sans-serif}.plan-modal-form input{width:100%;border:0;border-bottom:1px solid #d7d7e4;padding:8px 10px;font:400 13px Inter,sans-serif;outline:none;transition:border-color .25s}.plan-modal-form input:focus{border-color:#706de2;box-shadow:0 2px 0 #706de2}.plan-modal-form input::placeholder{color:#b7b7c8}.plan-modal-selected{display:grid;gap:8px;padding-top:3px}.plan-modal-selected span{font-size:12px}.plan-modal-selected b{font:650 14px/1.35 Inter,sans-serif}.plan-modal-selected small{color:#85859b;font-size:10px;letter-spacing:.08em}.plan-modal-submit{justify-self:start;margin-top:5px;padding:10px 31px;border:0;border-radius:8px;background:#7b78e4;color:#fff;font-weight:700;cursor:pointer;transition:transform .25s var(--o),box-shadow .25s}.plan-modal-submit:hover{transform:translateY(-3px);box-shadow:0 12px 20px -10px #5551bc}.plan-modal-submit:focus-visible,.plan-modal-close:focus-visible{outline:3px solid #24213f;outline-offset:3px}@keyframes planFade{from{opacity:0}to{opacity:1}}@keyframes planLift{from{opacity:0;transform:translateY(35px) scale(.96)}to{opacity:1;transform:none}}@media(max-width:650px){.plan-modal{padding:12px;place-items:end center}.plan-modal-card{grid-template-columns:1fr;min-height:0;max-height:92vh;overflow:auto}.plan-modal-card aside{padding:24px 28px}.plan-modal-card aside p{font-size:22px}.plan-modal-card aside strong{font-size:48px}.plan-modal-form{padding:26px 28px}}

/* Pricing pages */
.price-hero,.price-section,.price-cta{padding-inline:clamp(20px,7vw,120px)}
.price-hero{min-height:min(760px,88vh);padding-top:clamp(150px,19vw,240px);padding-bottom:clamp(70px,10vw,140px);color:#f7f5ff;background:radial-gradient(80% 120% at 100% 0%,#6a67ae 0%,transparent 60%),#0a0b14;position:relative;overflow:hidden}
.price-hero:after{content:"";position:absolute;width:min(56vw,760px);aspect-ratio:1;right:-12%;bottom:-55%;border:1px solid #ffffff26;border-radius:50%;box-shadow:0 0 0 90px #ffffff08,0 0 0 180px #ffffff06;pointer-events:none}
.price-eye{display:flex;align-items:center;gap:9px;margin:0 0 22px;font:600 11px/1 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase}.price-eye i{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 0 5px #54dc6e20}
.price-hero h1{position:relative;z-index:1;max-width:12ch;margin:0;white-space:normal;font:700 clamp(45px,7.4vw,116px)/.93 var(--font-inter),Inter,sans-serif;letter-spacing:-.065em;overflow-wrap:break-word}.price-hero>p:not(.price-eye){position:relative;z-index:1;max-width:56ch;margin:28px 0 0;color:#cbc9da;font-size:clamp(16px,1.45vw,20px);line-height:1.6}
.price-jump{position:relative;z-index:1;display:inline-flex;gap:12px;align-items:center;margin-top:34px;color:#fff;font-weight:650}.price-jump span{display:grid;place-items:center;width:34px;height:34px;border:1px solid #ffffff40;border-radius:50%;transition:transform .3s var(--o)}.price-jump:hover span{transform:translateY(5px)}
.price-section{padding-top:clamp(74px,10vw,144px);padding-bottom:clamp(80px,11vw,160px);background:var(--cream,#f3efe8);color:var(--ink)}.price-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:clamp(34px,5vw,66px)}.price-heading .price-eye{margin:0}.price-heading>span{max-width:38ch;color:#656371;font-size:14px;line-height:1.5}
.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,30px);align-items:stretch}.price-card{position:relative;display:flex;flex-direction:column;min-height:540px;padding:clamp(22px,2.5vw,38px);border:1px solid #0a0b1417;border-radius:34px 62px 40px 58px/44px 34px 62px 42px;background:linear-gradient(145deg,#fff 0%,#eeecf5 100%);box-shadow:0 24px 44px -38px #10102077;transition:transform .5s var(--o),box-shadow .5s var(--o)}.price-card:nth-child(2){border-radius:54px 34px 62px 42px/34px 58px 38px 64px}.price-card:nth-child(3){border-radius:38px 60px 44px 58px/58px 36px 62px 40px}.price-card:hover{transform:translateY(-10px) rotate(-.7deg);box-shadow:0 38px 60px -34px #10102077}.price-card--featured{color:#fff;background:linear-gradient(145deg,#5d5aa4,#2a294f 82%);border-color:#7f7cc7;transform:translateY(-22px)}.price-card--featured:hover{transform:translateY(-32px) rotate(.7deg)}.price-card-top{display:flex;justify-content:space-between;align-items:center;font:600 11px/1 Inter,sans-serif;letter-spacing:.12em;color:#888594}.price-card--featured .price-card-top{color:#d7d5f0}.price-card-top b{padding:8px 11px;border-radius:99px;background:#54dc6e;color:#152316;font-size:10px;letter-spacing:.06em}.price-card h2{margin:clamp(34px,5vw,64px) 0 10px;font:650 clamp(29px,3vw,48px)/.95 var(--font-inter),Inter,sans-serif;letter-spacing:-.055em}.price-value{margin:0;font:650 clamp(27px,3vw,44px)/1 var(--font-inter),Inter,sans-serif;letter-spacing:-.05em}.price-card>small{margin-top:7px;color:#716e80;font-size:12px}.price-card--featured>small{color:#d2d0e6}.price-card ul{display:grid;gap:13px;margin:36px 0;padding:0;list-style:none}.price-card li{display:flex;gap:10px;align-items:flex-start;font-size:14px;line-height:1.35}.price-card li i{font-style:normal;color:#438d50;font-weight:800}.price-card--featured li i{color:#54dc6e}.price-action{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:20px;border-top:1px solid #0a0b1417;font-weight:700}.price-card--featured .price-action{border-color:#ffffff2a}.price-action span,.price-cta a span{font-size:21px;transition:transform .35s var(--o)}.price-action:hover span,.price-cta a:hover span{transform:translate(4px,-4px)}
.price-cta{padding-top:clamp(76px,10vw,150px);padding-bottom:clamp(82px,11vw,164px);background:#dedbed;color:#11121d}.price-cta h2{max-width:13ch;margin:0;font:650 clamp(42px,6vw,92px)/.94 var(--font-inter),Inter,sans-serif;letter-spacing:-.06em}.price-cta>a{display:inline-flex;gap:16px;align-items:center;margin-top:34px;padding:15px 18px;border-radius:99px;background:#0a0b14;color:#fff;font-weight:700}.price-cta>a span{font-size:19px}
@media(max-width:850px){.price-grid{grid-template-columns:1fr}.price-card,.price-card--featured{min-height:auto;transform:none}.price-card--featured:hover,.price-card:hover{transform:translateY(-6px)}.price-heading{align-items:flex-start;flex-direction:column}.menu-pricing{grid-column:1;grid-row:auto}}
.wp-js .wp-board .wp-track{transition:none !important}


/* ===== WHY: smooth scroll animation (transforms only) ===== */
.wp-js .wp-board .wp-it .wp-node,
.wp-js .wp-board .wp-it .wp-txt {
    transform: none;
    translate: none;
    scale: none;
    opacity: 1;
    transition: none !important;
    will-change: transform, opacity
}

.wp-js .wp-board .wp-track {
    filter: none;
    transition: none !important
}

.wp-js .wp-board .wp-ln,
.wp-js .wp-board .wp-join {
    transition: none !important
}

/* MOBILE APP PAGE v1 */
.ma-page {
    overflow-x: clip;
    background: var(--cream);
    color: var(--ink)
}

.ma-page section {
    padding: clamp(70px, 9vw, 130px) 0;
    overflow: visible
}

.ma-page h1,
.ma-page h2,
.ma-page h3 {
    max-width: none;
    white-space: normal
}

.ma-w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: .14em;
    margin-bottom: -.14em
}

.ma-i {
    display: inline-block;
    will-change: transform
}

.ma-px {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--blue2)
}

.ma-px img {
    position: absolute;
    left: 0;
    top: -9%;
    width: 100%;
    height: 118%;
    object-fit: cover;
    display: block
}

.ma-empty {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #8b88c8, #3f3d7a)
}

.ma-h2 {
    font: 700 clamp(32px, 5vw, 78px)/.95 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.055em;
    margin: 16px 0 0;
    max-width: 13ch
}

.ma-h2.big {
    font-size: clamp(34px, 5.6vw, 92px);
    max-width: 12ch
}

.ma-white {
    color: #fff
}

/* phone */
.ma-phn {
    position: relative;
    width: 100%;
    aspect-ratio: 9/19.3;
    border-radius: 2.7em;
    border: .5em solid #0a0b14;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 3em 5em -2em rgba(10, 11, 20, .5)
}

.ma-island {
    position: absolute;
    left: 50%;
    top: .7em;
    width: 30%;
    height: 1.2em;
    border-radius: 99px;
    background: #0a0b14;
    transform: translateX(-50%);
    z-index: 4
}

.ma-scr {
    position: absolute;
    inset: 0;
    padding: 3em 1.1em 1.2em;
    display: flex;
    flex-direction: column;
    gap: .8em;
    background: #fff;
    visibility: hidden
}

.ma-scr.on {
    visibility: visible
}

.ma-hd {
    height: 1.2em;
    width: 42%;
    border-radius: .5em;
    background: #e3e1ee
}

.ma-hd.c {
    align-self: center
}

.ma-ban {
    height: 7em;
    border-radius: 1.2em;
    background: linear-gradient(135deg, #6a67ae, #3f3d7a)
}

.ma-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .7em
}

.ma-tile {
    aspect-ratio: 1;
    border-radius: 1em;
    background: linear-gradient(135deg, #d6d4ee, #bcb9e0)
}

.ma-tile.b {
    background: linear-gradient(135deg, #bcb9e0, #6a67ae)
}

.ma-tile.c {
    background: linear-gradient(135deg, #ece9f7, #8b88c8)
}

.ma-btn2 {
    margin-top: auto;
    height: 2.8em;
    border-radius: 99px;
    background: #0a0b14;
    flex: none
}

.ma-row {
    display: flex;
    align-items: center;
    gap: .7em
}

.ma-av {
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: linear-gradient(135deg, #6a67ae, #bcb9e0);
    flex: none;
    display: block
}

.ma-av.big {
    width: 6em;
    height: 6em;
    align-self: center
}

.ma-card2 {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 1.2em;
    border-radius: 1.2em;
    background: linear-gradient(135deg, #6a67ae, #3f3d7a);
    color: #fff;
    font: 700 1.3em var(--font-inter), Inter, sans-serif
}

.ma-card2 svg {
    width: 4.4em;
    height: 4.4em;
    flex: none
}

.ma-ln2 {
    height: .9em;
    border-radius: .5em;
    background: #e3e1ee
}

.ma-ln2.s {
    width: 62%
}

.ma-map {
    flex: 1;
    border-radius: 1.2em;
    background-color: #ece9f7;
    background-image: linear-gradient(rgba(106, 103, 174, .14) 1px, transparent 1px), linear-gradient(90deg, rgba(106, 103, 174, .14) 1px, transparent 1px);
    background-size: 2.2em 2.2em
}

.ma-map svg {
    width: 100%;
    height: 100%
}

.ma-sheet {
    display: grid;
    gap: .7em;
    padding: 1em;
    border-radius: 1.2em;
    background: #f4f2fa
}

.ma-bub {
    width: 68%;
    height: 3em;
    border-radius: 1em 1em 1em .2em;
    background: #ece9f7
}

.ma-bub.me {
    align-self: flex-end;
    background: #6a67ae;
    border-radius: 1em 1em .2em 1em
}

.ma-bub.s {
    width: 40%
}

.ma-kp {
    padding: 1em;
    border-radius: 1.1em;
    background: #f4f2fa
}

.ma-kp b {
    display: block;
    height: .8em;
    width: 40%;
    border-radius: .4em;
    background: #d9d7e6
}

.ma-kp svg {
    width: 100%;
    height: 3.4em;
    margin-top: .7em
}

.ma-bars {
    flex: 1;
    display: flex;
    align-items: flex-end;
    gap: .6em;
    padding: 1em;
    border-radius: 1.1em;
    background: #f4f2fa;
    min-height: 7em
}

.ma-bars i {
    flex: 1;
    border-radius: .4em .4em 0 0;
    background: linear-gradient(180deg, #6a67ae, #bcb9e0)
}

.ma-st3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .6em
}

.ma-st3 i {
    height: 3em;
    border-radius: .8em;
    background: #ece9f7
}

.ma-ep {
    display: flex;
    gap: .7em;
    align-items: center;
    padding: .8em;
    border-radius: .9em;
    background: #f4f2fa;
    font: 600 1em Inter, sans-serif
}

.ma-ep b {
    padding: .2em .6em;
    border-radius: .5em;
    background: #6a67ae;
    color: #fff;
    font-size: .85em
}

.ma-tag-api {
    position: absolute;
    left: 0;
    top: 3.2em;
    padding: .5em .8em;
    background: #0a0b14;
    color: #fff;
    font: 700 1em Inter, sans-serif;
    border-radius: 0 .5em .5em 0
}

/* hero */
.ma-page .ma-hero {
    position: relative;
    padding: clamp(110px, 10vw, 140px) 0 clamp(50px, 6vw, 90px);
    overflow: hidden;
    min-height: min(92vh, 860px);
    display: flex;
    align-items: center
}

.ma-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(10, 11, 20, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(10, 11, 20, .06) 1px, transparent 1px);
    background-size: 46px 46px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 90%);
    mask-image: linear-gradient(180deg, #000, transparent 90%)
}

.ma-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none
}

.ma-glow.g1 {
    right: -8%;
    top: -12%;
    width: 56%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(106, 103, 174, .42), transparent 68%)
}

.ma-glow.g2 {
    left: -10%;
    bottom: -18%;
    width: 40%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(63, 227, 63, .22), transparent 68%)
}

.ma-hero-in {
    position: relative;
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: clamp(30px, 4vw, 70px);
    align-items: center;
    width: 100%
}

.ma-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 20px;
    font: 600 11px Inter, sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase
}

.ma-eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    display: block
}

.ma-h1 {
    font: 700 clamp(46px, 7.2vw, 116px)/.9 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    margin: 0 0 24px
}

.ma-ln {
    display: block
}

.ma-acc {
    color: var(--blue)
}

.ma-sub {
    max-width: 27em;
    font-size: clamp(15px, 1.3vw, 19px);
    line-height: 1.55;
    color: #4b4c58;
    margin: 0
}

.ma-prog {
    width: 130px;
    height: 6px;
    border-radius: 6px;
    background: #fff;
    margin: 26px 0 22px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px var(--line)
}

.ma-prog i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--blue);
    transform-origin: left
}

.ma-purple {
    background: var(--blue) !important;
    color: #fff !important
}

.ma-stage {
    position: relative;
    aspect-ratio: 1/1.02;
    width: 100%;
    max-width: 640px;
    margin-left: auto;
    font-size: clamp(6px, .86vw, 12.5px)
}

.ma-p1 {
    position: absolute;
    left: 3%;
    top: 22%;
    width: 29%;
    transform: rotate(-7deg)
}

.ma-p3 {
    position: absolute;
    right: 0;
    top: 20%;
    width: 27%;
    transform: rotate(7deg)
}

.ma-p2 {
    position: absolute;
    left: 31%;
    top: 5%;
    width: 38%;
    z-index: 2
}

.ma-note {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: .9em;
    padding: .9em 1.3em .9em .9em;
    border-radius: 1.2em;
    background: #fff;
    box-shadow: 0 1.6em 3em -1.4em rgba(63, 61, 122, .5);
    font-size: 1.12em;
    transition: box-shadow .4s, transform .4s
}

.ma-note i {
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: grid;
    place-items: center;
    flex: none
}

.ma-note i svg {
    width: 1.4em;
    height: 1.4em
}

.ma-note b {
    display: block;
    font: 700 1em Inter, sans-serif
}

.ma-note span {
    display: block;
    font: 500 .85em Inter, sans-serif;
    color: #7a7b88
}

.ma-note.hot {
    box-shadow: 0 0 0 .2em var(--blue), 0 1.6em 3em -1.4em rgba(63, 61, 122, .6)
}

.ma-note.n1 {
    left: -3%;
    top: 14%
}

.ma-note.n2 {
    right: -3%;
    top: 46%
}

.ma-note.n3 {
    left: 4%;
    bottom: 12%
}

.ma-cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4%;
    text-align: center;
    margin: 0;
    font: 600 .9em Inter, sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #7a7b88
}

.ma-pdots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10%;
    display: flex;
    justify-content: center;
    gap: .7em
}

.ma-pdots button {
    width: .9em;
    height: .9em;
    border: 0;
    padding: 0;
    border-radius: 99px;
    background: #cfccdf;
    cursor: pointer;
    transition: width .4s var(--o), background .3s
}

.ma-pdots button.on {
    width: 2.8em;
    background: var(--blue)
}

/* what we build */
.ma-page .ma-build {
    background: #fff
}

.ma-cards {
    display: flex;
    gap: 14px;
    margin-top: clamp(30px, 4vw, 56px)
}

.ma-card {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    min-height: clamp(320px, 34vw, 430px);
    border-radius: 28px;
    padding: clamp(20px, 2.4vw, 34px);
    overflow: hidden;
    transition: flex-grow .9s var(--o);
    color: #fff;
    background: var(--blue)
}

.ma-card.and {
    background: #0a0b14
}

.ma-card.x {
    background: #e9e6f5;
    color: var(--ink)
}

.ma-card.on {
    flex-grow: 3.4
}

.ma-card-t {
    position: relative;
    z-index: 2;
    max-width: 46%
}

.ma-card small {
    font: 500 13px Inter, sans-serif;
    opacity: .7
}

.ma-card h3 {
    font: 700 clamp(26px, 3.3vw, 52px)/.95 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    margin: 10px 0 14px
}

.ma-card p,
.ma-card ul {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .5s, transform .6s var(--o)
}

.ma-card.on p,
.ma-card.on ul {
    opacity: 1;
    transform: none;
    transition-delay: .25s
}

.ma-card p {
    font-size: 14.5px;
    line-height: 1.55;
    margin: 0 0 16px;
    max-width: 22em;
    opacity: 0
}

.ma-card.on p {
    opacity: .85
}

.ma-card ul {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0
}

.ma-card li {
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid currentColor;
    font: 600 12px Inter, sans-serif
}

.ma-card-p {
    position: absolute;
    right: clamp(14px, 3vw, 48px);
    bottom: -8%;
    width: clamp(120px, 15vw, 230px);
    font-size: clamp(5px, .62vw, 9px);
    transition: transform .9s var(--o)
}

.ma-card.on .ma-card-p {
    transform: translateY(-6%) rotate(-3deg)
}

.ma-card:not(.on) .ma-card-p {
    right: 50%;
    transform: translateX(50%)
}

.ma-card:not(.on) .ma-card-t {
    max-width: 100%
}

/* expertise */
.ma-exp {
    background: var(--cream)
}

.ma-exp-grid {
    display: grid;
    grid-template-columns: .8fr 28px 1.2fr;
    gap: clamp(14px, 2.6vw, 40px);
    margin-top: clamp(30px, 4vw, 60px);
    align-items: start
}

.ma-exp-l {
    position: sticky;
    top: 110px;
    height: min(78vh, 640px);
    display: grid;
    place-items: center
}

.ma-exp-phone {
    width: min(62%, 280px);
    font-size: clamp(7px, .95vw, 13px)
}

.ma-circle {
    position: absolute;
    left: 4%;
    bottom: 10%;
    width: clamp(80px, 9vw, 130px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid var(--cream);
    box-shadow: 0 20px 40px -16px rgba(63, 61, 122, .6)
}

.ma-edots {
    position: sticky;
    top: 50vh;
    display: grid;
    gap: 10px;
    justify-items: center;
    align-self: start;
    padding-top: 20vh
}

.ma-edots i {
    width: 5px;
    height: 5px;
    border-radius: 99px;
    background: #cfccdf;
    display: block;
    transition: height .5s var(--o), background .3s
}

.ma-edots i.on {
    height: 22px;
    background: var(--blue)
}

.ma-exp-r {
    display: grid
}

.ma-ex {
    min-height: min(62vh, 520px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity .5s
}

.ma-js .ma-ex:not(.on) {
    opacity: .25
}

.ma-ex small {
    font: 600 12px Inter, sans-serif;
    color: var(--blue)
}

.ma-ex h3 {
    font: 700 clamp(34px, 5vw, 84px)/.95 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.055em;
    margin: 8px 0 12px
}

.ma-ex p {
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.5;
    color: #4b4c58;
    margin: 0 0 16px;
    max-width: 24em
}

.ma-ex ul {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap
}

.ma-ex li {
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid #bdbad4;
    font: 600 12px Inter, sans-serif;
    color: var(--blue2)
}

/* showcase */
.ma-page .ma-show {
    background: #0b0c15;
    color: #fff;
    border-radius: 48px 48px 0 0;
    margin-top: -1px;
    padding-bottom: clamp(80px, 10vw, 150px)
}

.ma-note-s {
    margin: 12px 0 0;
    font: 600 11px Inter, sans-serif;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #a9a7cf
}

.ma-show-stage {
    position: relative;
    height: clamp(420px, 52vw, 720px);
    margin-top: clamp(30px, 4vw, 60px);
    font-size: clamp(6px, .9vw, 13px)
}

.ma-sp {
    position: absolute;
    bottom: 0;
    box-shadow: 0 0 6em -2em rgba(106, 103, 174, .55)
}

.ma-sp.sp1 {
    left: 12%;
    width: 19%;
    bottom: 6%
}

.ma-sp.sp2 {
    left: 36%;
    width: 23%
}

.ma-sp.sp3 {
    left: 66%;
    width: 19%;
    bottom: 8%;
    left: auto;
    right: 2%;
    display: none
}

.ma-sp.sp3 {
    display: block;
    left: 62%;
    right: auto
}

.ma-sc {
    position: absolute;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .7)
}

.ma-sc.sc1 {
    right: 0;
    top: 6%;
    width: 24%;
    aspect-ratio: 4/3
}

.ma-sc.sc2 {
    right: 6%;
    bottom: 2%;
    width: 26%;
    aspect-ratio: 4/3
}

.ma-show .ma-px {
    height: 100%
}

/* process */
.ma-proc {
    background: var(--cream)
}

.ma-proc-box {
    position: relative;
    margin-top: clamp(40px, 5vw, 80px);
    aspect-ratio: 760/290;
    max-width: 1000px
}

.ma-proc-svg {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: calc(100% * 260/290)
}

.ma-trav {
    position: absolute;
    left: 0;
    top: 0;
    width: 22px;
    height: 34px;
    margin: -17px 0 0 -11px;
    border-radius: 7px;
    border: 3px solid #0a0b14;
    background: linear-gradient(135deg, #bcb9e0, #6a67ae);
    box-shadow: 0 10px 24px -8px rgba(63, 61, 122, .7);
    opacity: 0;
    z-index: 3;
    pointer-events: none
}

.ma-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0 0 auto 0;
    height: calc(100% * 260/290)
}

.ma-step {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    width: 0;
    height: 0
}

.ma-node {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: clamp(24px, 2.6vw, 34px);
    height: clamp(24px, 2.6vw, 34px);
    border-radius: 50%;
    background: #fff;
    border: 2px solid #dcd8ec;
    color: var(--ink);
    font: 700 13px Inter, sans-serif;
    z-index: 2;
    transition: background .4s, color .4s, border-color .4s, box-shadow .4s
}

.ma-step.on .ma-node {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    box-shadow: 0 0 0 7px rgba(106, 103, 174, .2)
}

.ma-step-t {
    position: absolute;
    left: 0;
    bottom: 22px;
    transform: translateX(-50%);
    width: clamp(130px, 16vw, 190px);
    text-align: center;
    opacity: .4;
    transition: opacity .5s
}

.ma-step.below .ma-step-t {
    bottom: auto;
    top: 22px
}

.ma-step.on .ma-step-t {
    opacity: 1
}

.ma-step h3 {
    font: 700 clamp(17px, 1.9vw, 26px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    margin: 0 0 4px
}

.ma-step p {
    font-size: clamp(11px, .95vw, 13px);
    line-height: 1.35;
    color: #4b4c58;
    margin: 0
}

/* tech */
.ma-page .ma-tech {
    background: linear-gradient(135deg, #1c1d33, #0f1020);
    color: #fff;
    border-radius: 0
}

.ma-field {
    position: relative;
    height: clamp(420px, 46vw, 560px);
    margin-top: clamp(30px, 4vw, 56px)
}

.ma-chip {
    position: absolute;
    padding: clamp(10px, 1.2vw, 16px) clamp(14px, 1.8vw, 24px);
    border-radius: 16px;
    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(255, 255, 255, .14);
    backdrop-filter: blur(8px);
    transform: rotate(var(--r, 0deg))
}

.ma-chip b {
    display: block;
    font: 700 clamp(18px, 2.6vw, 38px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    white-space: nowrap
}

.ma-chip span {
    font: 500 11px Inter, sans-serif;
    color: #b9b7d6
}

/* why */
.ma-page .ma-why {
    background: #fff
}

.ma-why-in {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: start
}

.ma-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0)
}

.ma-big {
    display: flex;
    align-items: flex-start;
    line-height: .8;
    margin-top: 10px
}

.ma-big b {
    font: 800 clamp(130px, 24vw, 340px)/.8 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.07em;
    color: var(--blue)
}

.ma-big sup {
    font: 800 clamp(70px, 12vw, 170px)/1 var(--font-inter), Inter, sans-serif;
    color: var(--blue);
    margin-top: .05em
}

.ma-big-l {
    font: 700 clamp(17px, 1.6vw, 22px)/1.2 var(--font-inter), Inter, sans-serif;
    margin: 14px 0 0;
    max-width: 10em
}

.ma-why-ph {
    margin-top: clamp(24px, 3vw, 40px);
    aspect-ratio: 16/10;
    border-radius: 28px;
    overflow: hidden;
    max-width: 520px
}

.ma-why-r ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink)
}

.ma-why-r li {
    display: flex;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--ink)
}

.ma-why-r li:last-child {
    border-bottom: 1px solid var(--line)
}

.ma-why-r small {
    font: 600 12px Inter, sans-serif;
    color: var(--blue);
    padding-top: 12px
}

.ma-why-r h3 {
    font: 700 clamp(24px, 3vw, 46px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em;
    margin: 0 0 8px
}

.ma-why-r p {
    margin: 0;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.5;
    color: #4b4c58;
    max-width: 26em
}

.ma-why-n {
    margin: 22px 0 0 48px;
    font-size: 14px;
    color: #4b4c58;
    max-width: 26em;
    line-height: 1.5
}

/* faq */
.ma-faq {
    background: var(--cream)
}

.ma-faq-in {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: clamp(30px, 5vw, 90px);
    align-items: start
}

.ma-faq-list {
    border-top: 1px solid var(--line)
}

.ma-faq-list details {
    border-bottom: 1px solid var(--line)
}

.ma-faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    font: 600 clamp(16px, 1.5vw, 20px)/1.25 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.ma-faq-list summary::-webkit-details-marker {
    display: none
}

.ma-faq-list summary i {
    flex: none;
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #e4e1f2;
    transition: background .3s, transform .5s var(--o)
}

.ma-faq-list summary i::before,
.ma-faq-list summary i::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    margin: -1px 0 0 -6px;
    background: var(--blue);
    transition: background .3s
}

.ma-faq-list summary i::after {
    transform: rotate(90deg)
}

.ma-faq-list details[open] summary i {
    background: var(--blue);
    transform: rotate(45deg)
}

.ma-faq-list details[open] summary i::before,
.ma-faq-list details[open] summary i::after {
    background: #fff
}

.ma-faq-list details p {
    margin: 0 0 22px;
    max-width: 34em;
    font-size: 15px;
    line-height: 1.55;
    color: #4b4c58
}

/* cta */
.ma-page .ma-ctaw {
    background: var(--cream);
    padding: 0 clamp(12px, 2vw, 28px) clamp(30px, 4vw, 60px)
}

.ma-cta {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr .75fr;
    align-items: end;
    gap: 20px;
    background: var(--blue);
    color: #fff;
    border-radius: 40px;
    padding: clamp(44px, 6vw, 90px) clamp(24px, 6vw, 100px) 0;
    overflow: hidden;
    min-height: clamp(420px, 42vw, 560px)
}

.ma-cta-t {
    padding-bottom: clamp(44px, 6vw, 90px);
    align-self: center
}

.ma-cta-h {
    font: 700 clamp(40px, 7vw, 116px)/.9 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    margin: 20px 0 22px;
    max-width: 9ch
}

.ma-cta-p {
    font-size: clamp(15px, 1.3vw, 19px);
    line-height: 1.5;
    color: #ecebf7;
    max-width: 24em;
    margin: 0 0 26px
}

.ma-cta-ph {
    width: min(100%, 300px);
    justify-self: center;
    margin-bottom: -18%;
    font-size: clamp(6px, .9vw, 12px);
    transform: rotate(7deg)
}

@media(max-width:1000px) {

    .ma-hero-in,
    .ma-why-in,
    .ma-faq-in {
        grid-template-columns: minmax(0, 1fr)
    }

    .ma-stage {
        margin: 20px auto 40px;
        max-width: 560px
    }

    .ma-cta {
        grid-template-columns: minmax(0, 1fr)
    }

    .ma-cta-ph {
        margin-bottom: -26%
    }
}

@media(max-width:900px) {
    .ma-cards {
        display: grid
    }

    .ma-card,
    .ma-card.on {
        min-height: 300px;
        flex: none
    }

    .ma-card p,
    .ma-card ul {
        opacity: 1;
        transform: none
    }

    .ma-card p {
        opacity: .85
    }

    .ma-card-t {
        max-width: 56%
    }

    .ma-card:not(.on) .ma-card-p {
        right: clamp(14px, 3vw, 48px);
        transform: none
    }

    .ma-card-p {
        width: clamp(120px, 28vw, 200px);
        font-size: clamp(5px, 1.3vw, 9px)
    }

    .ma-exp-grid {
        grid-template-columns: minmax(0, 1fr)
    }

    .ma-exp-l {
        position: relative;
        top: auto;
        height: auto;
        padding: 10px 0 30px
    }

    .ma-edots {
        display: none
    }

    .ma-ex {
        min-height: 0;
        padding: 34px 0;
        opacity: 1 !important
    }

    .ma-proc-box {
        aspect-ratio: auto;
        max-width: none
    }

    .ma-proc-svg,
    .ma-trav {
        display: none
    }

    .ma-steps {
        position: relative;
        height: auto;
        display: grid;
        gap: 22px;
        padding-left: 44px
    }

    .ma-steps::before {
        content: "";
        position: absolute;
        left: 16px;
        top: 6px;
        bottom: 6px;
        width: 2px;
        background: #dcd8ec
    }

    .ma-step {
        position: relative;
        left: auto;
        top: auto;
        transform: none;
        width: auto;
        height: auto
    }

    .ma-node {
        left: -44px;
        top: 0;
        transform: none
    }

    .ma-step-t {
        position: static;
        transform: none;
        width: auto;
        text-align: left;
        opacity: 1
    }

    .ma-step.below .ma-step-t {
        top: auto
    }

    .ma-field {
        height: auto;
        display: flex;
        flex-wrap: wrap;
        gap: 12px
    }

    .ma-chip {
        position: relative;
        left: auto !important;
        top: auto !important;
        transform: none
    }

    .ma-show-stage {
        height: clamp(380px, 86vw, 520px)
    }

    .ma-sc {
        display: none
    }

    .ma-sp.sp1 {
        left: 2%;
        width: 30%
    }

    .ma-sp.sp2 {
        left: 34%;
        width: 32%
    }

    .ma-sp.sp3 {
        left: 68%;
        width: 30%
    }
}

@media(max-width:600px) {
    .ma-note.n1 {
        left: 0
    }

    .ma-note.n2 {
        right: 0
    }

    .ma-note {
        font-size: 1em
    }

    .ma-big b {
        font-size: clamp(120px, 40vw, 200px)
    }

    .ma-why-n {
        margin-left: 0
    }

    .ma-cta-h {
        max-width: none
    }
}

/* DOMAIN HOSTING PAGE */
.dh {
    --k: #0a0b14;
    --p: #6a67ae;
    --p2: #8b88c8;
    --p3: #bcb9e0;
    --p4: #3f3d7a;
    --c: #f3efe8;
    --g: #3fe33f;
    position: relative;
    background: var(--c);
    color: var(--k);
    overflow-x: clip;
    font-family: var(--font-inter), Inter, sans-serif
}

.dh *,
.dh *:before,
.dh *:after {
    box-sizing: border-box
}

.dh h1,
.dh h2,
.dh h3,
.dh p,
.dh ul,
.dh ol,
.dh figure {
    margin: 0
}

.dh ul,
.dh ol {
    padding: 0;
    list-style: none
}

.dh h1,
.dh h2,
.dh h3 {
    font-family: var(--font-inter), Inter, sans-serif;
    font-weight: 700;
    letter-spacing: -.045em;
    max-width: none
}

.dh img {
    display: block
}

.dh a {
    color: inherit
}

.dh-in {
    padding: 0 clamp(20px, 8vw, 120px)
}

.dh-sec {
    padding: clamp(72px, 10vw, 150px) 0
}

.dh-m {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: .06em .02em .16em 0;
    margin: 0 .2em -.16em 0
}

.dh-w {
    display: inline-block;
    will-change: transform
}

.dh-em {
    color: var(--p)
}

.dh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 22px;
    font: 600 12px/1 Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--p)
}

.dh-eyebrow i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--g);
    box-shadow: 0 0 0 4px rgba(63, 227, 63, .18)
}

.dh-h2 {
    font-size: clamp(34px, 4.6vw, 72px);
    line-height: 1.02
}

.dh-lede {
    margin-top: 22px !important;
    max-width: 52ch;
    color: #5a5864;
    font: 400 clamp(16px, 1.3vw, 19px)/1.6 Inter, sans-serif
}

.dh-head-c {
    max-width: 860px
}

.dh [data-in] {
    opacity: 0;
    animation: dhShow .01s 3.4s forwards
}

@keyframes dhShow {
    to {
        opacity: 1
    }
}

.dh-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 58px;
    padding: 0 28px;
    border-radius: 99px;
    font: 600 16px/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: background .4s, color .4s, border-color .4s
}

.dh-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .5s var(--o)
}

.dh-btn:hover svg {
    transform: translate(3px, -3px)
}

.dh-btn.g:hover svg {
    transform: translateY(3px)
}

.dh-btn.p {
    background: var(--p);
    color: #fff
}

.dh-btn.p:hover {
    background: var(--k)
}

.dh-btn.g {
    border: 1px solid rgba(10, 11, 20, .22);
    color: var(--k)
}

.dh-btn.g:hover {
    border-color: var(--p);
    color: var(--p)
}

.dh-btn.w {
    background: var(--c);
    color: var(--k)
}

.dh-btn.w:hover {
    background: var(--p);
    color: #fff
}

/* hero */
.dh-hero {
    position: relative;
    padding: clamp(118px, 15vh, 176px) 0 clamp(64px, 8vw, 110px);
    overflow: hidden
}

.dh-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none
}

.dh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px)
}

.dh-orb.a {
    width: 46vmax;
    height: 46vmax;
    right: -14vmax;
    top: -12vmax;
    background: radial-gradient(circle, #bcb9e0, transparent 70%);
    opacity: .55
}

.dh-orb.b {
    width: 30vmax;
    height: 30vmax;
    left: -10vmax;
    bottom: -14vmax;
    background: radial-gradient(circle, #d6d4ee, transparent 70%);
    opacity: .7
}

.dh-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(10, 11, 20, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(10, 11, 20, .05) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(70% 60% at 70% 40%, #000, transparent);
    mask-image: radial-gradient(70% 60% at 70% 40%, #000, transparent)
}

.dh-hero-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center
}

.dh-h1 {
    font-size: clamp(40px, 5.8vw, 96px);
    line-height: .98
}

.dh-lead {
    margin-top: 26px !important;
    max-width: 46ch;
    color: #4a4855;
    font: 400 clamp(16px, 1.35vw, 20px)/1.6 Inter, sans-serif
}

.dh-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px
}

.dh-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 34px !important;
    color: #6b6877;
    font: 500 13px/1 Inter, sans-serif
}

.dh-trust li {
    position: relative;
    padding-left: 16px
}

.dh-trust li:before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    background: var(--p)
}

.dh-stage {
    position: relative;
    width: min(100%, 600px);
    margin-left: auto;
    aspect-ratio: 15/16
}

.dh-photo {
    position: absolute;
    inset: 0 0 11% 16%;
    border-radius: 36px;
    overflow: hidden;
    background: linear-gradient(160deg, var(--p4), #15152b)
}

.dh-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover
}

.dh-photo-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(200deg, rgba(106, 103, 174, .28), rgba(10, 11, 20, .55))
}

.dh-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none
}

.dh-path {
    stroke: var(--p3);
    stroke-width: 2;
    stroke-dasharray: 4 8;
    stroke-linecap: round
}

.dh-pkt {
    fill: var(--g);
    filter: drop-shadow(0 0 6px var(--g))
}

.dh-browser {
    position: absolute;
    left: 0;
    top: 7%;
    width: 60%;
    min-height: 30%;
    aspect-ratio: 1.9;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 22px;
    background: rgba(255, 255, 255, .9);
    backdrop-filter: blur(14px);
    box-shadow: 0 30px 70px rgba(10, 11, 20, .2), 0 0 0 1px rgba(10, 11, 20, .06)
}

.dh-bar {
    display: flex;
    align-items: center;
    gap: 7px
}

.dh-bar>i {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #d9d6e6
}

.dh-url {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 8px;
    min-width: 0;
    height: 34px;
    margin-left: 8px;
    padding: 0 12px;
    border-radius: 99px;
    background: #f1eef8;
    color: var(--k);
    font: 600 clamp(11px, 1.2vw, 15px)/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    overflow: hidden
}

.dh-url svg {
    flex: none;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--p);
    stroke-width: 2;
    stroke-linecap: round
}

.dh-url>span {
    display: inline-flex;
    align-items: flex-end;
    white-space: nowrap
}

.dh-typed {
    white-space: pre
}

.dh-ext {
    display: inline-block;
    height: 1.3em;
    min-width: 7ch;
    overflow: hidden;
    color: var(--p)
}

.dh-ext-in {
    display: flex;
    flex-direction: column
}

.dh-ext-in span {
    display: block;
    height: 1.3em;
    line-height: 1.3em
}

.dh-page {
    flex: 1;
    display: grid;
    gap: 8px;
    align-content: center
}

.dh-sk {
    display: block;
    height: 10px;
    border-radius: 6px;
    background: linear-gradient(90deg, #e7e3f3, #f4f1fb)
}

.dh-sk.w1 {
    width: 78%
}

.dh-sk.w2 {
    width: 56%
}

.dh-sk.w3 {
    width: 68%
}

.dh-load {
    display: block;
    height: 6px;
    border-radius: 6px;
    background: #ece9f7;
    overflow: hidden
}

.dh-load i {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--p), var(--g));
    transform-origin: 0 50%
}

.dh-live {
    position: absolute;
    right: 12px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 11px;
    border-radius: 99px;
    background: var(--k);
    color: #fff;
    font: 600 10px/1 Inter, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase
}

.dh-live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--g);
    box-shadow: 0 0 10px var(--g)
}

.dh-rack {
    position: absolute;
    right: 3%;
    bottom: 2%;
    width: 38%;
    aspect-ratio: 228/270;
    filter: drop-shadow(0 30px 40px rgba(10, 11, 20, .35))
}

.dh-rack svg {
    width: 100%;
    height: 100%;
    display: block
}

.dh-rack-body {
    fill: #14152a;
    stroke: #2a2b4a;
    stroke-width: 2
}

.dh-unit-r {
    fill: #1d1e3a;
    stroke: #34365c
}

.dh-led.g {
    fill: var(--g)
}

.dh-led.p {
    fill: var(--p2)
}

.dh-vent {
    stroke: #3b3d68;
    stroke-width: 2;
    stroke-linecap: round;
    fill: none
}

.dh-unit {
    transform-box: fill-box
}

.dh-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 99px;
    background: rgba(255, 255, 255, .86);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 32px rgba(10, 11, 20, .14);
    font: 600 13px/1 Inter, sans-serif;
    color: var(--k)
}

.dh-chip i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--p)
}

.dh-chip.c1 {
    right: 0;
    top: 9%
}

.dh-chip.c2 {
    left: 3%;
    top: 57%
}

.dh-chip.c3 {
    right: -1%;
    top: 44%
}

.dh-chip.c4 {
    left: 6%;
    bottom: 6%
}

/* marquee */
.dh-marq {
    background: var(--k);
    color: #f3efe8;
    overflow: hidden;
    padding: 22px 0
}

.dh-marq-t {
    display: flex;
    width: max-content;
    will-change: transform
}

.dh-marq-set {
    display: flex;
    flex: none
}

.dh-marq-set span {
    display: inline-flex;
    align-items: center;
    gap: clamp(22px, 3vw, 46px);
    padding-right: clamp(22px, 3vw, 46px);
    font: 600 clamp(26px, 3.6vw, 52px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em;
    white-space: nowrap
}

.dh-marq-set i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--p2);
    transform: rotate(45deg)
}

/* dark sections */
.dh-dark,
.dh-vps {
    background: var(--k);
    color: #f3efe8;
    position: relative;
    overflow: hidden
}

.dh-dark .dh-em,
.dh-vps .dh-em,
.dh-cta .dh-em {
    color: var(--p2)
}

.dh-dark .dh-eyebrow,
.dh-vps .dh-eyebrow,
.dh-cta .dh-eyebrow {
    color: var(--p3)
}

.dh-dark .dh-lede,
.dh-vps .dh-lede,
.dh-cta .dh-lede {
    color: #b9b7c6
}

.dh-dark:before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(50% 40% at 90% 0%, rgba(106, 103, 174, .4), transparent 70%), radial-gradient(35% 30% at 0% 100%, rgba(139, 136, 200, .16), transparent 70%)
}

.dh-dark>.dh-in {
    position: relative
}

.dh-stack-head {
    max-width: 880px
}

.dh-stack-body {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 100px);
    align-items: center;
    margin-top: clamp(40px, 6vw, 80px)
}

.dh-fig {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background: linear-gradient(160deg, var(--p4), #15152b)
}

.dh-fig img {
    position: absolute;
    left: 0;
    top: -9%;
    width: 100%;
    height: 118%;
    object-fit: cover
}

.dh-fig-a {
    aspect-ratio: 4/5
}

.dh-fig-tags {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px
}

.dh-fig-tags span {
    padding: 9px 14px;
    border-radius: 99px;
    background: rgba(10, 11, 20, .55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, .18);
    color: #fff;
    font: 600 12px/1 Inter, sans-serif;
    letter-spacing: .06em
}

.dh-pillar {
    position: relative;
    display: grid;
    grid-template-columns: 34px 44px 1fr;
    gap: 18px;
    align-items: center;
    padding: clamp(22px, 2.4vw, 32px) 0
}

.dh-pillar h3 {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.05
}

.dh-pillar p {
    margin-top: 8px;
    max-width: 44ch;
    color: #b9b7c6;
    font: 400 15px/1.55 Inter, sans-serif
}

.dh-pn {
    font: 500 12px/1 ui-monospace, Menlo, Consolas, monospace;
    color: var(--p2)
}

.dh-pi {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: var(--p3);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round
}

.dh-pi path,
.dh-pi circle {
    stroke-dasharray: 1
}

.dh-pline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: rgba(255, 255, 255, .18);
    transform-origin: 0 50%
}

/* services panels */
.dh-services {
    background: var(--c)
}

.dh-services .dh-head-c {
    margin-bottom: clamp(36px, 5vw, 64px)
}

.dh-panels {
    display: flex;
    gap: 12px;
    height: clamp(460px, 64vh, 620px)
}

.dh-panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 26px;
    color: #fff;
    cursor: pointer;
    background: linear-gradient(160deg, var(--p4), #15152b);
    outline: none
}

.dh-panel:focus-visible {
    box-shadow: 0 0 0 3px var(--p)
}

.dh-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.16);
    transition: transform 1.4s var(--o)
}

.dh-panel.is-on img {
    transform: scale(1.02)
}

.dh-panel-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 11, 20, .1) 15%, rgba(10, 11, 20, .86)), linear-gradient(90deg, rgba(106, 103, 174, .38), transparent)
}

.dh-panel-n {
    position: absolute;
    left: 22px;
    top: 20px;
    font: 500 12px/1 ui-monospace, Menlo, Consolas, monospace;
    letter-spacing: .1em;
    color: var(--p3)
}

.dh-panel-v {
    position: absolute;
    left: 22px;
    bottom: 22px;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font: 600 clamp(17px, 1.5vw, 22px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em;
    white-space: nowrap;
    transition: opacity .35s
}

.dh-panel.is-on .dh-panel-v {
    opacity: 0
}

.dh-panel-b {
    position: absolute;
    left: clamp(20px, 2.4vw, 34px);
    right: clamp(20px, 2.4vw, 34px);
    bottom: clamp(20px, 2.4vw, 32px);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .35s, transform .5s var(--o);
    pointer-events: none
}

.dh-panel.is-on .dh-panel-b {
    opacity: 1;
    transform: none;
    transition: opacity .6s .3s, transform .8s .3s var(--o)
}

.dh-panel-b h3 {
    font-size: clamp(24px, 2.5vw, 38px);
    line-height: 1.04
}

.dh-panel-b p {
    margin-top: 12px;
    max-width: 44ch;
    color: #dedcea;
    font: 400 15px/1.55 Inter, sans-serif
}

/* vps */
.dh-vps {
    background: linear-gradient(160deg, var(--p4), var(--k) 62%)
}

.dh-vps-in {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center
}

.dh-vps-fig {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background-size: cover;
    background-position: center;
    border: 1px solid rgba(255, 255, 255, .14)
}

.dh-vps-shade {
    position: absolute;
    inset: 0;
    background: rgba(10, 11, 20, .82)
}

.dh-vps-fig svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto
}

.dh-vl {
    fill: #f3efe8;
    font: 600 15px var(--font-inter), Inter, sans-serif;
    letter-spacing: .02em
}

.dh-vl.me {
    fill: #fff
}

.dh-vc {
    fill: #b9b7c6;
    font: 500 12px Inter, sans-serif
}

.dh-box {
    fill: rgba(255, 255, 255, .04);
    stroke: rgba(255, 255, 255, .28);
    stroke-width: 1.5
}

.dh-sh {
    fill: rgba(188, 185, 224, .28);
    stroke: rgba(188, 185, 224, .55);
    transform-box: fill-box;
    transform-origin: center
}

.dh-slice {
    fill: rgba(188, 185, 224, .16);
    stroke: rgba(188, 185, 224, .45);
    transform-box: fill-box;
    transform-origin: center
}

.dh-slice.me {
    fill: var(--p);
    stroke: var(--p3);
    filter: drop-shadow(0 0 18px rgba(139, 136, 200, .8))
}

.dh-arrow {
    fill: none;
    stroke: var(--g);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1
}

.dh-bens {
    margin-top: 30px !important;
    display: grid;
    gap: 0
}

.dh-bens li {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid rgba(255, 255, 255, .16);
    font: 600 clamp(18px, 1.7vw, 24px)/1.2 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.dh-bens li:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, .16)
}

.dh-bens b {
    font: 500 12px/1 ui-monospace, Menlo, Consolas, monospace;
    color: var(--p3)
}

/* built for / network */
.dh-built {
    background: var(--c)
}

.dh-net {
    position: relative;
    aspect-ratio: 16/8.6;
    margin-top: clamp(32px, 5vw, 64px)
}

.dh-net-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible
}

.dh-net-lines line {
    stroke: var(--p3);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    transition: stroke .3s, stroke-width .3s
}

.dh-net-lines line.on {
    stroke: var(--p);
    stroke-width: 2.5
}

.dh-core {
    position: absolute;
    left: 50%;
    top: 50%;
    width: clamp(120px, 14vw, 190px);
    aspect-ratio: 1;
    margin: calc(clamp(120px, 14vw, 190px)/-2) 0 0 calc(clamp(120px, 14vw, 190px)/-2);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--p);
    color: #fff;
    text-align: center;
    font: 600 clamp(13px, 1.3vw, 17px)/1.15 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.01em;
    box-shadow: 0 20px 60px rgba(106, 103, 174, .45)
}

.dh-core i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--p2);
    opacity: 0;
    animation: dhRing 3.2s ease-out infinite
}

.dh-core i+i {
    animation-delay: 1.6s
}

@keyframes dhRing {
    0% {
        transform: scale(1);
        opacity: .7
    }

    100% {
        transform: scale(2.1);
        opacity: 0
    }
}

.dh-nodepos {
    position: absolute;
    transform: translate(-50%, -50%)
}

.dh-node {
    display: block;
    padding: 12px 18px;
    border: 1px solid rgba(10, 11, 20, .14);
    border-radius: 99px;
    background: #fff;
    color: var(--k);
    font: 600 clamp(12px, 1.15vw, 15px)/1.15 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.01em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(10, 11, 20, .06);
    transition: background .3s, color .3s, border-color .3s
}

.dh-node b {
    font: inherit
}

.dh-node span {
    display: none
}

.dh-node:hover,
.dh-node.on,
.dh-node:focus-visible {
    background: var(--p);
    border-color: var(--p);
    color: #fff;
    outline: none
}

.dh-net-cap {
    position: absolute;
    left: 50%;
    bottom: -6px;
    transform: translateX(-50%);
    width: min(560px, 90%);
    text-align: center;
    color: #5a5864;
    font: 500 15px/1.5 Inter, sans-serif
}

/* journey */
.dh-journey {
    background: #ebe6dc
}

.dh-jhead {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: end
}

.dh-fig-b {
    aspect-ratio: 16/10
}

.dh-track {
    position: relative;
    max-width: 1100px;
    margin: clamp(48px, 7vw, 96px) auto 0
}

.dh-rail {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    margin-left: -1px;
    background: rgba(10, 11, 20, .14)
}

.dh-rail-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--p), var(--p2));
    transform-origin: 50% 0
}

.dh-packet {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 3;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: var(--g);
    box-shadow: 0 0 0 6px rgba(63, 227, 63, .22), 0 0 24px rgba(63, 227, 63, .8)
}

.dh-step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: clamp(28px, 5vw, 64px)
}

.dh-step:last-child {
    margin-bottom: clamp(32px, 5vw, 56px)
}

.dh-dot {
    position: absolute;
    left: 50%;
    top: 30px;
    z-index: 2;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: #ebe6dc;
    border: 2px solid rgba(10, 11, 20, .28);
    transition: background .4s, border-color .4s, box-shadow .4s
}

.dh-card {
    grid-column: 1;
    padding-right: clamp(36px, 5vw, 76px);
    text-align: right;
    opacity: .4;
    transition: opacity .5s
}

.dh-step:nth-child(even) .dh-card {
    grid-column: 2;
    padding-right: 0;
    padding-left: clamp(36px, 5vw, 76px);
    text-align: left
}

.dh-step.on .dh-card {
    opacity: 1
}

.dh-step.on .dh-dot {
    background: var(--p);
    border-color: var(--p);
    box-shadow: 0 0 0 8px rgba(106, 103, 174, .2)
}

.dh-sn {
    display: block;
    margin-bottom: 8px;
    color: transparent;
    -webkit-text-stroke: 1px rgba(10, 11, 20, .3);
    font: 700 clamp(36px, 4vw, 56px)/1 var(--font-inter), Inter, sans-serif
}

.dh-card h3 {
    font-size: clamp(22px, 2.2vw, 32px);
    line-height: 1.08
}

.dh-card p {
    margin-top: 10px;
    color: #5a5864;
    font: 400 15px/1.55 Inter, sans-serif;
    max-width: 40ch;
    display: inline-block
}

.dh-live-b {
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    margin: 0 auto;
    padding: 16px 26px;
    border-radius: 99px;
    background: var(--k);
    color: #fff;
    font: 500 clamp(13px, 1.3vw, 16px)/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    opacity: .35;
    transition: opacity .6s, box-shadow .6s
}

.dh-live-b i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #777;
    transition: background .4s, box-shadow .4s
}

.dh-live-b em {
    font-style: normal;
    color: var(--g)
}

.dh-live-b.on {
    opacity: 1;
    box-shadow: 0 0 0 8px rgba(63, 227, 63, .16)
}

.dh-live-b.on i {
    background: var(--g);
    box-shadow: 0 0 12px var(--g)
}

/* why */
.dh-why {
    background: var(--c)
}

.dh-why-in {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 100px);
    align-items: center
}

.dh-fig-c {
    aspect-ratio: 4/5
}

.dh-badge {
    position: absolute;
    left: 18px;
    bottom: 18px;
    display: flex;
    align-items: baseline;
    gap: 2px;
    padding: 16px 22px;
    border-radius: 20px;
    background: rgba(10, 11, 20, .62);
    backdrop-filter: blur(12px);
    color: #fff
}

.dh-badge b {
    font: 700 clamp(40px, 4vw, 60px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em
}

.dh-badge span {
    margin-left: 12px;
    max-width: 10ch;
    font: 500 13px/1.3 Inter, sans-serif;
    color: #dedcea
}

.dh-whys {
    margin-top: 34px !important
}

.dh-whys li {
    padding: 24px 0;
    border-top: 1px solid rgba(10, 11, 20, .14)
}

.dh-whys li:last-child {
    border-bottom: 1px solid rgba(10, 11, 20, .14)
}

.dh-whys h3 {
    font-size: clamp(20px, 1.9vw, 28px);
    line-height: 1.1
}

.dh-whys p {
    margin-top: 8px;
    max-width: 48ch;
    color: #5a5864;
    font: 400 15px/1.55 Inter, sans-serif
}

/* faq */
.dh-faq {
    background: #ebe6dc
}

.dh-faq-in {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 100px);
    align-items: start
}

.dh-faq-head {
    position: sticky;
    top: 120px
}

.dh-qi {
    border-top: 1px solid rgba(10, 11, 20, .16)
}

.dh-qi:last-child {
    border-bottom: 1px solid rgba(10, 11, 20, .16)
}

.dh-q {
    display: grid;
    grid-template-columns: 34px 1fr 28px;
    gap: 14px;
    align-items: center;
    width: 100%;
    padding: 24px 0;
    border: 0;
    background: transparent;
    color: var(--k);
    text-align: left;
    cursor: pointer;
    font: 600 clamp(17px, 1.6vw, 22px)/1.25 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em
}

.dh-qn {
    font: 500 12px/1 ui-monospace, Menlo, Consolas, monospace;
    color: var(--p);
    letter-spacing: .04em
}

.dh-plus {
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(10, 11, 20, .25);
    transition: background .3s, border-color .3s, transform .5s var(--o)
}

.dh-plus:before,
.dh-plus:after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.5px;
    margin: -.75px 0 0 -5.5px;
    background: currentColor
}

.dh-plus:after {
    transform: rotate(90deg);
    transition: transform .5s var(--o)
}

.dh-q[aria-expanded="true"] .dh-plus {
    background: var(--p);
    border-color: var(--p);
    color: #fff;
    transform: rotate(180deg)
}

.dh-q[aria-expanded="true"] .dh-plus:after {
    transform: rotate(0)
}

.dh-a {
    overflow: hidden
}

.dh-a p {
    padding: 0 42px 26px 48px;
    max-width: 64ch;
    color: #4a4855;
    font: 400 16px/1.65 Inter, sans-serif
}

.dh-a a {
    color: var(--p);
    text-decoration: underline;
    text-underline-offset: 3px
}

/* cta */
.dh-cta {
    position: relative;
    overflow: hidden;
    background: var(--k);
    color: #f3efe8;
    padding: clamp(90px, 12vw, 170px) 0
}

.dh-cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: .55
}

.dh-cta-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 11, 20, .9), rgba(10, 11, 20, .62) 50%, rgba(10, 11, 20, .92)), radial-gradient(50% 50% at 80% 20%, rgba(106, 103, 174, .5), transparent 70%)
}

.dh-ring {
    position: absolute;
    right: 8%;
    top: 22%;
    width: min(36vw, 420px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(188, 185, 224, .4);
    animation: dhRing 5s ease-out infinite;
    pointer-events: none
}

.dh-ring.r2 {
    animation-delay: 1.6s
}

.dh-ring.r3 {
    animation-delay: 3.2s
}

.dh-cta-in {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    text-align: center
}

.dh-cta-in .dh-h2 {
    font-size: clamp(38px, 5.6vw, 92px)
}

.dh-cta-in .dh-lede {
    margin: 22px auto 0 !important
}

.dh-cta-btns {
    margin-top: 34px;
    display: flex;
    justify-content: center
}

.dh-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: clamp(44px, 6vw, 80px);
    text-align: left
}

.dh-tile {
    display: block;
    padding: 20px 22px;
    border-radius: 20px;
    background: rgba(255, 255, 255, .07);
    border: 1px solid rgba(255, 255, 255, .16);
    backdrop-filter: blur(10px);
    text-decoration: none;
    color: #fff;
    transition: background .35s, border-color .35s
}

a.dh-tile:hover {
    background: rgba(106, 103, 174, .45);
    border-color: var(--p3)
}

.dh-tile small {
    display: block;
    margin-bottom: 10px;
    color: var(--p3);
    font: 600 11px/1 Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase
}

.dh-tile b {
    display: block;
    font: 600 clamp(16px, 1.5vw, 20px)/1.3 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.01em
}

/* tablet */
@media(max-width:1100px) {
    .dh-pillar {
        grid-template-columns: 30px 40px 1fr
    }

    .dh-faq-head {
        position: static
    }
}

@media(max-width:1000px) {

    .dh-hero-in,
    .dh-stack-body,
    .dh-vps-in,
    .dh-jhead,
    .dh-why-in,
    .dh-faq-in {
        grid-template-columns: minmax(0, 1fr)
    }

    .dh-stage {
        margin: 20px auto 0
    }

    .dh-fig-a,
    .dh-fig-c {
        aspect-ratio: 16/11
    }

    .dh-tiles {
        grid-template-columns: 1fr
    }

    .dh-ring {
        display: none
    }
}

@media(max-width:900px) {
    .dh-panels {
        flex-direction: column;
        height: 760px
    }

    .dh-panel-v {
        writing-mode: horizontal-tb;
        transform: none;
        left: 22px;
        top: 44px;
        bottom: auto
    }

    .dh-net {
        aspect-ratio: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px
    }

    .dh-net-lines,
    .dh-core {
        display: none
    }

    .dh-nodepos {
        position: static;
        transform: none
    }

    .dh-node {
        width: 100%;
        height: 100%;
        padding: 16px 18px;
        border-radius: 20px;
        white-space: normal;
        text-align: left
    }

    .dh-node b {
        display: block;
        margin-bottom: 6px
    }

    .dh-node span {
        display: block;
        font: 400 12px/1.45 Inter, sans-serif;
        opacity: .75
    }

    .dh-net-cap {
        display: none
    }

    .dh-rail,
    .dh-packet {
        left: 18px
    }

    .dh-dot {
        left: 18px
    }

    .dh-step {
        grid-template-columns: 1fr
    }

    .dh-card,
    .dh-step:nth-child(even) .dh-card {
        grid-column: 1;
        padding: 0 0 0 52px;
        text-align: left
    }

    .dh-live-b {
        margin: 0 0 0 0
    }
}

@media(max-width:560px) {
    .dh-net {
        grid-template-columns: 1fr
    }

    .dh-a p {
        padding: 0 8px 22px 48px
    }

    .dh-chip {
        font-size: 12px;
        padding: 8px 12px
    }

    .dh-btn {
        height: 54px;
        padding: 0 22px
    }

    .dh-cta-row {
        flex-direction: column;
        align-items: stretch
    }

    .dh-cta-row .dh-btn {
        justify-content: center
    }
}

@media(prefers-reduced-motion:reduce) {
    .dh [data-in] {
        opacity: 1;
        animation: none
    }

    .dh-core i,
    .dh-ring {
        animation: none
    }
}

/* ===== DOMAIN HOSTING FIXES ===== */
.dh {
    overflow-x: clip
}

.dh .dh-h1,
.dh .dh-h2,
.dh h3 {
    white-space: normal;
    text-wrap: balance;
    overflow-wrap: break-word
}

.dh p {
    text-wrap: pretty
}

.dh .dh-hero-in {
    gap: clamp(40px, 6vw, 96px)
}

.dh .dh-hero-copy {
    position: relative;
    z-index: 3;
    min-width: 0
}

.dh .dh-stage {
    position: relative;
    z-index: 1;
    min-width: 0
}

.dh .dh-h1 {
    font-size: clamp(36px, 4.5vw, 72px);
    line-height: 1.04;
    letter-spacing: -.04em;
    max-width: 13ch
}

.dh .dh-lead {
    max-width: 44ch;
    line-height: 1.65
}

.dh .dh-h2 {
    line-height: 1.06
}

.dh section p {
    max-width: 60ch
}

@media (max-width:1000px) {
    .dh .dh-h1 {
        font-size: clamp(34px, 8.5vw, 60px);
        max-width: 16ch
    }

    .dh .dh-stage {
        width: min(100%, 520px);
        margin: 28px auto 0
    }
}

@media (max-width:560px) {
    .dh .dh-hero {
        padding-top: 110px
    }

    .dh .dh-h1 {
        font-size: clamp(32px, 10vw, 44px)
    }

    .dh .dh-stage {
        width: 100%
    }
}

/* ===== HOW WE WORK: stage cards ===== */
.proc.psec {
    padding: clamp(48px, 6vw, 84px) 0
}

.psec .wrap {
    max-width: 1320px;
    padding: 0 clamp(20px, 4vw, 64px)
}

.psec .lab {
    margin-bottom: 16px
}

.psec h2 {
    max-width: 16ch;
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.05
}

.ps-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-top: clamp(28px, 3.5vw, 48px)
}

.ps-rail {
    position: absolute;
    left: 23px;
    right: 0;
    top: 22px;
    height: 2px;
    background: var(--line)
}

.ps-rail i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left
}

.ps-st {
    position: relative;
    padding-top: 68px;
    display: flex
}

.ps-n {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    box-shadow: 0 0 0 7px #6a67ae22
}

.ps-n svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round
}

.ps-st:last-child .ps-n {
    background: var(--green);
    color: var(--ink);
    box-shadow: 0 0 0 7px #3fe33f2b
}

.ps-cd {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 230px;
    padding: 56px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 26px 26px 26px 56px;
    background: var(--bg);
    color: var(--fg);
    transition: transform .6s var(--o), box-shadow .5s
}

.ps-st:nth-child(even) .ps-cd {
    border-radius: 26px 56px 26px 26px
}

.ps-cd:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 46px -26px #3f3d7a99
}

.ps-art {
    position: absolute;
    z-index: -1;
    right: -16px;
    bottom: -16px;
    width: 158px;
    height: 158px;
    opacity: .13;
    transition: transform .9s var(--o), opacity .5s
}

.ps-art svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round
}

.ps-cd:hover .ps-art {
    transform: rotate(-10deg) scale(1.1);
    opacity: .2
}

.ps-ok {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    opacity: .55
}

.ps-ok svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round
}

.ps-cd h3 {
    margin: auto 0 0;
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.05;
    letter-spacing: -.04em;
    color: inherit;
    opacity: 1;
    transform: none
}

.ps-cd p {
    margin: 0;
    max-width: none;
    font-size: 13.5px;
    line-height: 1.5;
    color: inherit;
    opacity: .82;
    transform: none
}

.ps-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px
}

.ps-tags span {
    padding: 6px 12px;
    border-radius: 99px;
    background: var(--cb);
    border: 1px solid var(--cl);
    font-size: 12px;
    font-weight: 500
}

.pc1 {
    --bg: #fff;
    --fg: var(--ink);
    --cb: var(--cream);
    --cl: var(--line)
}

.pc2 {
    --bg: #ecebf8;
    --fg: var(--ink);
    --cb: #fff;
    --cl: #6a67ae33
}

.pc3 {
    --bg: linear-gradient(160deg, #8b88c8, #6a67ae);
    --fg: #fff;
    --cb: #ffffff22;
    --cl: #ffffff3d;
    border-color: transparent
}

.pc4 {
    --bg: linear-gradient(160deg, #5a58a1, #3f3d7a);
    --fg: #fff;
    --cb: #ffffff1a;
    --cl: #ffffff33;
    border-color: transparent
}

.pc5 {
    --bg: radial-gradient(120% 80% at 100% 0%, #6a67ae, transparent 60%), linear-gradient(160deg, #2c2a5e, #0a0b14);
    --fg: #fff;
    --cb: #ffffff18;
    --cl: #ffffff30;
    border-color: transparent
}

.ps-js .ps-rail i {
    transform: scaleX(0);
    transition: transform 2s cubic-bezier(.5, 0, .2, 1)
}

.ps-js .ps-n {
    opacity: 0;
    scale: .6
}

.ps-js .ps-cd {
    opacity: 0;
    translate: 0 24px
}

.ps-js .ps-steps.in .ps-rail i {
    transform: scaleX(1)
}

.ps-js .ps-steps.in .ps-n {
    opacity: 1;
    scale: 1;
    transition: opacity .4s, scale .7s cubic-bezier(.34, 1.56, .64, 1);
    transition-delay: calc(var(--i)*.35s + .1s)
}

.ps-js .ps-steps.in .ps-cd {
    opacity: 1;
    translate: 0 0;
    transition: opacity .7s, translate .9s var(--o), transform .6s var(--o), box-shadow .5s;
    transition-delay: calc(var(--i)*.35s + .3s), calc(var(--i)*.35s + .3s), 0s, 0s
}

@media(max-width:1000px) {
    .ps-steps {
        grid-template-columns: 1fr;
        gap: 16px
    }

    .ps-rail {
        left: 22px;
        right: auto;
        top: 23px;
        bottom: 23px;
        width: 2px;
        height: auto
    }

    .ps-rail i {
        transform-origin: top
    }

    .ps-js .ps-rail i {
        transform: scaleY(0)
    }

    .ps-js .ps-steps.in .ps-rail i {
        transform: scaleY(1)
    }

    .ps-st {
        padding: 0 0 0 68px
    }
}

@media(prefers-reduced-motion:reduce) {

    .ps-js .ps-n,
    .ps-js .ps-cd {
        opacity: 1;
        scale: 1;
        translate: none
    }

    .ps-js .ps-rail i {
        transform: none
    }

    .ps-cd {
        transition: none
    }
}

/* ===== HOW WE WORK: scroll-linked ===== */
.ps-js .ps-n,
.ps-js .ps-cd,
.ps-js .ps-rail i {
    opacity: unset;
    scale: none;
    translate: none;
    transition: none
}

.ps-js .ps-steps.in .ps-n,
.ps-js .ps-steps.in .ps-cd {
    transition: none
}

.ps-art svg {
    opacity: 1
}

/* ===== BLOG ===== */
.blog-page{background:var(--cream);color:var(--ink)}
.blog-hero{padding:clamp(150px,18vw,250px) 0 42px;background:radial-gradient(80% 95% at 95% 10%,#b8b4e344,transparent 60%);overflow:visible}
.blog-hero .wrap{max-width:1500px}.blog-hero .lab{margin-bottom:clamp(44px,7vw,96px)}
.blog-hero-row{display:grid;grid-template-columns:1.35fr .65fr;gap:48px;align-items:end}.blog-hero h1{max-width:9ch;font:800 clamp(62px,10vw,156px)/.83 var(--font-inter),Inter,sans-serif;letter-spacing:-.075em}.blog-hero h1 em{display:block;font-weight:500;color:var(--blue);font-style:italic}.blog-hero-row>p{max-width:30ch;margin-bottom:9px;font-size:clamp(17px,1.5vw,21px);line-height:1.42;color:#4e4c5b}
.blog-rule{height:1px;margin-top:clamp(52px,7vw,100px);background:var(--line)}.blog-topics{display:flex;gap:10px;flex-wrap:wrap;padding-top:20px}.blog-topics button{border:1px solid var(--line);border-radius:99px;padding:10px 17px;background:transparent;color:#464451;font-size:13px;transition:.3s var(--o)}.blog-topics button:hover,.blog-topics button.active{border-color:var(--ink);background:var(--ink);color:#fff}
.blog-main{max-width:1500px;padding-top:clamp(64px,9vw,128px);padding-bottom:clamp(84px,12vw,170px)}.blog-kicker,.blog-category{font:600 11px Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}.blog-kicker{margin-bottom:18px}
.blog-featured{display:grid;grid-template-columns:1.02fr .98fr;min-height:530px;background:#e3def4;border-radius:32px;overflow:hidden}.blog-featured-copy{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(32px,5vw,76px)}.blog-featured h2{max-width:12ch;margin-top:20px;font-size:clamp(38px,4.3vw,68px);line-height:.93}.blog-excerpt{max-width:45ch;margin-top:22px;color:#5b586b;font-size:15px;line-height:1.55}.blog-meta{display:flex;align-items:center;gap:7px;margin-top:auto;padding-top:30px;color:#696575;font-size:12px}.blog-meta i{width:3px;height:3px;border-radius:50%;background:#8b87a0}.blog-meta svg{margin-left:4px}.blog-link{display:inline-flex;align-items:center;gap:8px;margin-top:24px;padding:12px 0;border-bottom:1px solid currentColor;font:700 14px var(--font-inter),Inter,sans-serif}.blog-link svg{transition:transform .4s var(--o)}.blog-link:hover svg{transform:translate(3px,-3px)}
.blog-art{position:relative;min-height:260px;overflow:hidden;background:#6a67ae}.blog-art.is-featured{min-height:530px}.blog-art-violet{background:linear-gradient(145deg,#2c2a5e,#6a67ae 55%,#938ed0)}.blog-art-lime{background:linear-gradient(145deg,#c4e797,#83b95a)}.blog-art-coral{background:linear-gradient(145deg,#f5b29f,#e17765)}.blog-art-ink{background:linear-gradient(145deg,#191a2d,#363765)}.blog-art-orb{position:absolute;width:68%;aspect-ratio:1;border-radius:50%;right:-12%;top:-13%;background:#d1caff;opacity:.82;filter:blur(1px)}.blog-art-lime .blog-art-orb{background:#f3ffd1}.blog-art-coral .blog-art-orb{background:#ffe0d8}.blog-art-ink .blog-art-orb{background:#7f83e6}.blog-art-grid{position:absolute;inset:0;background:linear-gradient(#ffffff19 1px,transparent 1px),linear-gradient(90deg,#ffffff19 1px,transparent 1px);background-size:34px 34px;mask-image:linear-gradient(120deg,#0008,transparent 70%)}.blog-art-window{position:absolute;left:14%;bottom:12%;width:56%;height:44%;padding:15px;border:1px solid #ffffff75;border-radius:11px;background:#ffffff1c;backdrop-filter:blur(5px);box-shadow:18px 20px 45px #17112a35}.blog-art-window b{display:block;height:8px;margin-bottom:9px;border-radius:99px;background:#ffffffa6}.blog-art-window b:nth-child(2){width:73%}.blog-art-window b:nth-child(3){width:38%}.blog-art-line{position:absolute;display:block;height:13px;border-radius:99px;background:#fff;transform:rotate(-31deg);box-shadow:0 8px 15px #15112d22}.blog-art-line.one{width:31%;right:7%;bottom:27%}.blog-art-line.two{width:18%;right:20%;bottom:42%}.blog-art-line.three{width:12%;right:13%;bottom:51%}.blog-art-spark{position:absolute;right:13%;top:20%;width:46px;height:46px;color:#fff}
.blog-list-head{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:clamp(90px,12vw,160px);margin-bottom:34px}.blog-list-head h2{font-size:clamp(38px,5vw,72px);max-width:none}.blog-search{display:flex;align-items:center;gap:10px;width:min(100%,280px);padding:12px 0;border-bottom:1px solid var(--ink);color:#5a5767}.blog-search input{width:100%;border:0;outline:0;background:transparent;font:14px Inter,sans-serif}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.blog-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:22px;overflow:hidden;background:#f8f5ef;transition:transform .5s var(--o),box-shadow .5s}.blog-card:hover{transform:translateY(-8px);box-shadow:0 26px 40px -28px #37305c66}.blog-card-copy{display:flex;flex-direction:column;flex:1;padding:25px}.blog-card h3{margin-top:14px;font-size:clamp(25px,2.3vw,36px);line-height:.98;letter-spacing:-.045em}.blog-card .blog-excerpt{margin-top:14px;font-size:13.5px}.blog-card-bottom{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-top:auto}.blog-card-bottom .blog-meta{padding-top:28px}.blog-card-bottom a{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--ink);color:#fff;transition:transform .4s var(--o),background .3s}.blog-card-bottom a:hover{transform:rotate(45deg);background:var(--blue)}
.blog-newsletter{padding:clamp(65px,9vw,125px) 0;background:var(--ink);color:#fff}.blog-newsletter-in{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:end;max-width:1500px}.blog-newsletter h2{max-width:11ch;font-size:clamp(42px,5vw,76px)}.blog-signup label{display:block;margin-bottom:10px;color:#bcb9cf;font-size:12px}.blog-signup>div{display:flex;border-bottom:1px solid #ffffff80}.blog-signup input{flex:1;min-width:0;padding:15px 0;border:0;outline:0;background:transparent;color:#fff;font:16px Inter,sans-serif}.blog-signup input::placeholder{color:#bcb9cf}.blog-signup button{display:inline-flex;align-items:center;gap:7px;border:0;background:transparent;color:var(--green);font-weight:700}.blog-signup button svg{transition:transform .4s var(--o)}.blog-signup button:hover svg{transform:translate(3px,-3px)}
@media(max-width:800px){.blog-hero{padding-top:140px}.blog-hero-row,.blog-newsletter-in,.blog-featured{grid-template-columns:1fr}.blog-hero-row{gap:28px}.blog-featured{min-height:0}.blog-art.is-featured{min-height:330px}.blog-featured-copy{min-height:430px}.blog-grid{grid-template-columns:1fr}.blog-list-head{align-items:flex-start;flex-direction:column}.blog-search{width:100%}.blog-newsletter-in{gap:38px}.blog-newsletter h2{max-width:12ch}}
@media(max-width:500px){.blog-hero{padding-bottom:24px}.blog-hero h1{font-size:60px}.blog-topics{flex-wrap:nowrap;overflow:auto;padding-bottom:4px}.blog-topics button{white-space:nowrap}.blog-featured{border-radius:20px}.blog-art.is-featured{min-height:260px}.blog-featured-copy{padding:30px 24px;min-height:0}.blog-card-copy{padding:22px}.blog-art{min-height:210px}.blog-signup>div{align-items:center}.blog-signup button{font-size:0}.blog-signup button svg{width:22px;height:22px}.blog-newsletter{padding:70px 0}}

/* ===== BLOG ARTICLE ===== */
.article-page{padding-top:80px;background:var(--cream)}.article-hero{padding:clamp(70px,10vw,140px) 0 clamp(58px,8vw,106px);background:radial-gradient(85% 100% at 100% 0,#c4bee94d,transparent 64%)}.article-hero .wrap,.article-body.wrap{max-width:1120px}.article-back{display:inline-flex;align-items:center;gap:8px;margin-bottom:clamp(52px,8vw,110px);font:600 13px Inter,sans-serif;color:#504d61}.article-back svg{transition:transform .35s var(--o)}.article-back:hover svg{transform:translateX(-4px)}.article-hero h1{max-width:13ch;margin-top:20px;white-space:normal;font:800 clamp(48px,7vw,108px)/.88 var(--font-inter),Inter,sans-serif;letter-spacing:-.07em}.article-dek{max-width:52ch;margin-top:30px;font-size:clamp(18px,2vw,24px);line-height:1.4;color:#4e4c5b}.article-meta{display:flex;flex-wrap:wrap;align-items:center;gap:9px;margin-top:35px;color:#656171;font-size:13px}.article-meta i{width:3px;height:3px;border-radius:50%;background:#8c879b}.article-body{display:grid;grid-template-columns:190px minmax(0,1fr);gap:clamp(42px,8vw,120px);padding-top:clamp(70px,10vw,140px);padding-bottom:clamp(90px,13vw,180px)}.article-aside{position:sticky;top:100px;align-self:start;display:flex;flex-direction:column;gap:10px;padding-top:8px;font-size:13px}.article-aside span{margin-bottom:7px;font-weight:700}.article-aside a{color:#696575;transition:color .25s}.article-aside a:hover{color:var(--blue)}.article-body article{max-width:660px}.article-body article>p{margin:0 0 24px;color:#494756;font-size:17px;line-height:1.72}.article-body .article-lead{font:500 clamp(23px,2.5vw,32px)/1.32 var(--font-inter),Inter,sans-serif;letter-spacing:-.025em;color:var(--ink)}.article-body h2{max-width:15ch;margin:58px 0 20px;font-size:clamp(34px,4.2vw,58px);line-height:.94}.article-callout{display:flex;gap:24px;margin:42px 0;padding:28px;border-radius:18px;background:#ded9f2}.article-callout span{font:800 34px/.9 var(--font-inter),Inter,sans-serif;color:var(--blue)}.article-callout p{max-width:28ch;font:700 22px/1.16 var(--font-inter),Inter,sans-serif;letter-spacing:-.025em}.article-checks{display:grid;gap:18px;margin:34px 0 8px}.article-checks li{display:flex;gap:14px;padding:19px 0;border-top:1px solid var(--line)}.article-checks svg{flex:0 0 auto;margin-top:3px;color:var(--blue)}.article-checks strong{font:700 20px var(--font-inter),Inter,sans-serif;letter-spacing:-.02em}.article-checks p{margin-top:5px;color:#5b5867;font-size:14px;line-height:1.55}.article-next{display:flex;justify-content:space-between;gap:28px;align-items:end;margin-top:72px;padding:34px;border-radius:22px;background:var(--ink);color:#fff}.article-next h2{max-width:10ch;margin:12px 0 0;font-size:clamp(30px,3.3vw,46px);white-space:normal}.article-next a{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;color:var(--green);font-weight:700}.article-next a svg{transition:transform .35s var(--o)}.article-next a:hover svg{transform:translate(3px,-3px)}
@media(max-width:760px){.article-body{grid-template-columns:1fr}.article-aside{position:static;display:none}.article-next{align-items:flex-start;flex-direction:column}.article-hero h1{font-size:52px}.article-body article>p{font-size:16px}}

/* ===== ABOUT ===== */
.about-page{background:var(--cream)}.about-hero{padding:clamp(150px,18vw,250px) 0 58px;background:radial-gradient(65% 95% at 97% 3%,#c4bee966,transparent 64%);overflow:hidden}.about-hero .wrap,.about-intro .wrap,.about-approach .wrap,.about-closing .wrap{max-width:1500px}.about-hero .lab{margin-bottom:clamp(42px,7vw,100px)}.about-hero-grid{display:grid;grid-template-columns:1fr minmax(280px,.46fr);gap:50px;align-items:end}.about-hero h1{max-width:10ch;white-space:normal;font:800 clamp(60px,10vw,155px)/.83 var(--font-inter),Inter,sans-serif;letter-spacing:-.075em}.about-hero h1 em{display:block;color:var(--blue);font-weight:500;font-style:italic}.about-hero-grid>div:first-child>p{max-width:33ch;margin-top:28px;color:#4f4d5c;font-size:clamp(17px,1.55vw,22px);line-height:1.42}.about-orbit{position:relative;justify-self:end;width:min(30vw,410px);aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle at 36% 30%,#c8c3f0,#7671b5 58%,#3f3d7a);box-shadow:inset 20px 20px 60px #fff3,0 30px 60px -35px #3f3d7a}.about-orbit b{position:relative;z-index:2;color:#fff;font:800 clamp(50px,8vw,108px)/1 var(--font-inter),Inter,sans-serif;letter-spacing:-.1em}.about-orbit-ring{position:absolute;inset:-12%;border:1px solid #6a67ae66;border-radius:50%;transform:rotate(-23deg) scaleY(.46)}.about-orbit-dot{position:absolute;z-index:3;width:13px;height:13px;border-radius:50%;background:var(--green);box-shadow:0 0 0 7px #3fe33f30}.about-orbit-dot.one{left:6%;top:47%}.about-orbit-dot.two{right:12%;top:8%;width:8px;height:8px;background:#fff}.about-scroll{display:flex;align-items:center;gap:12px;margin-top:clamp(58px,9vw,130px);color:#5c596b;font-size:12px}.about-scroll i{display:block;width:54px;height:1px;background:var(--ink)}
.about-intro{padding:clamp(86px,12vw,180px) 0}.about-intro-grid{display:grid;grid-template-columns:.5fr 1.5fr;gap:40px}.about-intro h2,.about-approach h2,.about-closing h2{max-width:12ch;font-size:clamp(43px,5.5vw,84px)}.about-large{max-width:38ch;margin-top:30px;color:#4e4b5a;font-size:clamp(18px,1.8vw,25px);line-height:1.42}.about-text-link{display:inline-flex;align-items:center;gap:8px;margin-top:34px;padding-bottom:9px;border-bottom:1px solid var(--ink);font:700 15px var(--font-inter),Inter,sans-serif}.about-text-link svg,.about-closing a svg{transition:transform .35s var(--o)}.about-text-link:hover svg,.about-closing a:hover svg{transform:translate(3px,-3px)}
.about-stats{padding:0;background:var(--ink);color:#fff}.about-stat-grid{display:grid;grid-template-columns:repeat(4,1fr)}.about-stat-grid>div{min-height:260px;padding:clamp(30px,4vw,58px);display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid #ffffff26}.about-stat-grid>div:last-child{border:0}.about-stat-grid strong{font:800 clamp(72px,10vw,150px)/.8 var(--font-inter),Inter,sans-serif;letter-spacing:-.08em;color:var(--green)}.about-stat-grid strong em{font-style:normal}.about-stat-grid span{max-width:15ch;color:#d2d0df;font-size:15px}
.about-approach{padding:clamp(90px,12vw,180px) 0}.about-approach-heading{display:flex;justify-content:space-between;gap:50px;align-items:end;margin-top:36px}.about-approach-heading>p{max-width:30ch;color:#565362;font-size:17px;line-height:1.5}.about-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:clamp(48px,7vw,96px)}.about-principles article{min-height:345px;display:flex;flex-direction:column;align-items:flex-start;padding:28px;border-radius:24px;background:#e5e0f4;transition:transform .45s var(--o),box-shadow .45s}.about-principles article:nth-child(2){background:#d6d1ed}.about-principles article:nth-child(3){background:#c6c0e6}.about-principles article:hover{transform:translateY(-8px);box-shadow:0 28px 40px -28px #403b7288}.about-principles article>span{color:#706ba5;font:600 12px Inter,sans-serif}.about-principles svg{width:36px;height:36px;margin:auto 0 18px;color:#4d498a}.about-principles h3{font-size:clamp(26px,2.5vw,39px);line-height:.95;letter-spacing:-.045em}.about-principles p{margin-top:15px;color:#57536a;font-size:14px;line-height:1.55}
.about-closing{padding:0 0 clamp(86px,12vw,170px)}.about-closing .wrap{display:flex;justify-content:space-between;gap:48px;align-items:end;padding-top:clamp(60px,9vw,120px);border-top:1px solid var(--line)}.about-closing>div>p:not(.blog-category){max-width:36ch;margin-top:25px;color:#585563;font-size:17px;line-height:1.5}.about-closing a{display:inline-flex;align-items:center;gap:9px;flex:0 0 auto;padding:15px 21px;border-radius:99px;background:var(--ink);color:#fff;font:700 14px var(--font-inter),Inter,sans-serif}
@media(max-width:800px){.about-hero{padding-top:145px}.about-hero-grid,.about-intro-grid{grid-template-columns:1fr}.about-orbit{justify-self:start;width:min(65vw,330px)}.about-scroll{margin-top:54px}.about-stat-grid,.about-principles{grid-template-columns:1fr}.about-stat-grid>div{min-height:175px;border-right:0;border-bottom:1px solid #ffffff26}.about-stat-grid>div:last-child{border-bottom:0}.about-approach-heading,.about-closing .wrap{align-items:flex-start;flex-direction:column}.about-principles article{min-height:250px}.about-intro-grid>.blog-category{margin-bottom:0}}
@media(max-width:500px){.about-hero h1{font-size:62px}.about-orbit{width:260px}.about-hero-grid{gap:36px}.about-intro h2,.about-approach h2,.about-closing h2{font-size:46px}.about-stat-grid>div{min-height:150px}.about-stat-grid strong{font-size:85px}}

/* ===== OUR TEAM ===== */
.team-page{background:var(--cream)}.team-hero{padding:clamp(150px,18vw,250px) 0 clamp(80px,11vw,155px);background:radial-gradient(70% 100% at 100% 0,#c5c0ed55,transparent 62%)}.team-hero .wrap,.team-group .wrap,.team-cta .wrap{max-width:1500px}.team-hero .lab{margin-bottom:clamp(44px,7vw,96px)}.team-hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.team-hero h1{max-width:10ch;white-space:normal;font:800 clamp(60px,10vw,150px)/.83 var(--font-inter),Inter,sans-serif;letter-spacing:-.075em}.team-hero h1 em{color:var(--blue);font-style:italic;font-weight:500}.team-hero-grid>div:first-child>p{max-width:35ch;margin-top:28px;color:#514e5e;font-size:clamp(17px,1.6vw,22px);line-height:1.42}.team-symbol{justify-self:end;width:min(29vw,390px);aspect-ratio:1;display:flex;flex-direction:column;justify-content:space-between;padding:30px;border-radius:50% 50% 12px 50%;background:linear-gradient(145deg,#706cba,#3f3d7a);color:#fff;box-shadow:0 30px 60px -35px #3f3d7a}.team-symbol svg{width:clamp(58px,8vw,110px);height:auto;color:var(--green)}.team-symbol span{font:700 clamp(22px,3vw,42px)/.95 var(--font-inter),Inter,sans-serif;letter-spacing:-.04em}
.team-group{padding:clamp(80px,11vw,160px) 0}.team-group-alt{background:#e9e4f4}.team-heading{display:flex;justify-content:space-between;gap:50px;align-items:end;margin-bottom:clamp(44px,7vw,92px)}.team-heading h2{max-width:13ch;margin-top:15px;font-size:clamp(43px,5.5vw,84px)}.team-heading>p{max-width:30ch;color:#575361;font-size:17px;line-height:1.5}.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.team-card{position:relative;display:flex;flex-direction:column;min-height:370px;padding:18px;border-radius:22px;overflow:hidden;background:#fff;transition:transform .45s var(--o),box-shadow .45s}.team-card:hover{transform:translateY(-8px);box-shadow:0 25px 38px -28px #37315c88}.team-avatar{position:relative;display:grid;place-items:center;flex:1;min-height:190px;border-radius:16px 16px 10px 16px;overflow:hidden}.team-avatar::before,.team-avatar::after{content:"";position:absolute;border-radius:50%}.team-avatar::before{width:65%;aspect-ratio:1;right:-10%;top:-12%;background:#fff5}.team-avatar::after{width:52%;aspect-ratio:1;left:16%;bottom:-18%;background:#00000012}.team-avatar span{position:relative;z-index:2;font:800 clamp(45px,5vw,76px)/1 var(--font-inter),Inter,sans-serif;letter-spacing:-.09em;color:#fff}.team-avatar i{position:absolute;z-index:2;width:11px;height:11px;border-radius:50%;background:var(--green);right:18px;bottom:18px;box-shadow:0 0 0 6px #3fe33f35}.team-violet .team-avatar{background:linear-gradient(145deg,#918bce,#5a57a2)}.team-ink .team-avatar{background:linear-gradient(145deg,#484870,#18192d)}.team-lime .team-avatar{background:linear-gradient(145deg,#a8d679,#679d53)}.team-coral .team-avatar{background:linear-gradient(145deg,#eea08d,#bc6556)}.team-card-meta{padding:19px 4px 3px}.team-card-meta small{color:#7872ae;font:600 10px Inter,sans-serif;letter-spacing:.12em}.team-card h3{margin-top:10px;font-size:clamp(22px,2vw,31px);line-height:.95;letter-spacing:-.045em}.team-card p{min-height:2.8em;margin-top:8px;color:#5b5766;font-size:12px;line-height:1.42}.management-grid .team-card{min-height:410px}
.team-cta{padding:clamp(80px,11vw,160px) 0;background:var(--ink);color:#fff}.team-cta .wrap{display:flex;justify-content:space-between;align-items:end;gap:48px}.team-cta h2{max-width:10ch;margin-top:16px;font-size:clamp(43px,5.4vw,82px)}.team-cta a{display:inline-flex;align-items:center;gap:9px;flex:0 0 auto;padding:16px 22px;border-radius:99px;background:var(--green);color:var(--ink);font:700 14px var(--font-inter),Inter,sans-serif}.team-cta a svg{transition:transform .35s var(--o)}.team-cta a:hover svg{transform:translate(3px,-3px)}
@media(max-width:1000px){.team-grid{grid-template-columns:repeat(2,1fr)}.team-hero-grid{grid-template-columns:1fr}.team-symbol{justify-self:start;width:min(65vw,350px)}}
@media(max-width:700px){.team-hero{padding-top:145px}.team-hero h1{font-size:62px}.team-heading,.team-cta .wrap{align-items:flex-start;flex-direction:column}.team-heading>p{font-size:16px}.team-grid{grid-template-columns:1fr}.team-card,.management-grid .team-card{min-height:330px}.team-card p{min-height:auto}.team-symbol{width:270px}}

