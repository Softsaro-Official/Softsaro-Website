@import "tailwindcss/theme.css" layer(theme);
@import "tailwindcss/utilities.css" layer(utilities);

:root {
    --cream: #f3efe8;
    --cream2: #ebe6dc;
    --ink: #0a0b14;
    --blue: #6a67ae;
    --blue2: #3f3d7a;
    --green: #3fe33f;
    --line: #0a0b1424;
    --e: cubic-bezier(.7, 0, .2, 1);
    --o: cubic-bezier(.16, 1, .3, 1)
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0
}

html {
    scroll-behavior: smooth
}

section[id] {
    scroll-margin-top: 60px
}

body {
    font: 400 16px/1.55 var(--font-inter), Inter, system-ui, sans-serif;
    letter-spacing: -0.01em;
    background: var(--cream);
    color: var(--ink);
    overflow-x: hidden
}

a {
    color: inherit;
    text-decoration: none
}

ul {
    list-style: none
}

button {
    font: inherit;
    cursor: pointer
}

h1,
h2,
h3,
h4,
.logo,
.btn,
.big,
.mega {
    font-family: var(--font-inter), Inter, sans-serif
}

.wrap {
    max-width: 1760px;
    margin: auto;
    padding: 0 clamp(20px, 8vw, 120px)
}

h2 {
    font-size: clamp(38px, 5.6vw, 92px);
    line-height: .95;
    letter-spacing: -.055em;
    font-weight: 800;
    max-width: 15ch
}

h2 b,
h1 b,
.mega b {
    color: var(--blue);
    font-weight: 800
}

section {
    position: relative;
    padding: clamp(80px, 11vw, 150px) 0;
    overflow: hidden
}

.lab {
    display: flex;
    align-items: center;
    gap: 12px;
    font: 500 12px 'Inter', sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 26px
}

.lab i {
    width: 48px;
    height: 1px;
    background: var(--ink)
}

.gn {
    color: #1fb81f
}

.lab.w {
    color: #fff
}

.lab.w i {
    background: #fff
}

.lab.w .gn {
    color: var(--green)
}

.bgfx {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none
}

.blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    opacity: .28
}

.b1 {
    width: 560px;
    height: 560px;
    background: #8b88c8;
    right: -140px;
    top: -60px;
    animation: drift 18s ease-in-out infinite
}

.b2 {
    width: 420px;
    height: 420px;
    background: #c6ff9c;
    left: -160px;
    top: 40vh;
    animation: drift 22s ease-in-out infinite reverse
}

.arc {
    position: absolute;
    width: 760px;
    right: -200px;
    top: 30px;
    animation: spin 90s linear infinite
}

@keyframes drift {
    50% {
        transform: translate(-60px, 70px) scale(1.12)
    }
}

@keyframes spin {
    to {
        transform: rotate(360deg)
    }
}

/* buttons */
.btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 30px;
    border-radius: 99px;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -.01em;
    color: #fff;
    background: var(--blue);
    transition: transform .3s
}

.btn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: translateY(102%);
    border-radius: 50% 50% 0 0/100% 100% 0 0;
    transition: transform .55s var(--e), border-radius .55s var(--e)
}

.btn:hover::before {
    transform: none;
    border-radius: 0
}

.btn.dark {
    background: var(--ink)
}

.btn.dark::before {
    background: var(--blue)
}

.btn.sm {
    padding: 11px 20px;
    font-size: 14px
}

.btn.white {
    background: #fff;
    color: var(--ink)
}

.btn.white::before {
    background: var(--ink)
}

.btn.white:hover {
    color: #fff
}

.btn.ghostw {
    background: transparent;
    border: 1px solid #ffffff66
}

.btn.ghostw::before {
    background: #fff
}

.btn.ghostw:hover {
    color: var(--blue)
}

.btn .ar {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    transition: transform .5s var(--e)
}

.btn:hover .ar {
    transform: rotate(45deg)
}

.roll {
    display: block;
    position: relative;
    overflow: hidden;
    line-height: 1.25
}

.roll>span {
    display: block;
    transition: transform .55s var(--e)
}

.roll>span+span {
    position: absolute;
    left: 0;
    top: 100%
}

.btn:hover .roll>span,
.tlink:hover .roll>span,
.menu a:hover .roll>span,
.fgrid a:hover .roll>span {
    transform: translateY(-100%)
}

.tlink {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 17px var(--font-inter), Inter, sans-serif;
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ink);
    position: relative
}

.tlink svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    transition: transform .4s var(--o)
}

.tlink:hover svg {
    transform: translateY(4px)
}

.tlink:hover {
    border-color: var(--blue);
    color: var(--blue)
}

/* nav */
.nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(20px, 8vw, 120px);
    border-bottom: 1px solid var(--line);
    transition: transform .5s var(--o), background .3s
}

.nav.s {
    background: #f3efe8d9;
    backdrop-filter: blur(16px)
}

.nav.hide {
    transform: translateY(-100%)
}

/* Focused menu overlay */
.menu-nav {
    background: #f3efe8e6;
    border-bottom: 0;
    backdrop-filter: blur(14px);
    isolation: isolate
}

.menu-brand {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    font: 800 22px/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em
}

.menu-brand svg {
    width: 31px;
    height: 28px
}

.menu-brand svg path:first-child,
.menu-brand svg path:nth-child(2) {
    fill: var(--blue)
}

.menu-brand svg path:last-child {
    fill: var(--blue2)
}

.menu-trigger {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 13px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 700 13px/1 Inter, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase
}

.menu-trigger>i {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    position: relative;
    display: block;
    transition: background .35s var(--o), border-color .35s var(--o)
}

.menu-trigger b {
    position: absolute;
    left: 12px;
    width: 17px;
    height: 1.5px;
    background: currentColor;
    transition: transform .45s var(--o), top .45s var(--o)
}

.menu-trigger b:first-child {
    top: 16px
}

.menu-trigger b:last-child {
    top: 23px
}

.menu-trigger:hover>i {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff
}

.menu-shell.is-open .menu-trigger b:first-child {
    top: 20px;
    transform: rotate(45deg)
}

.menu-shell.is-open .menu-trigger b:last-child {
    top: 20px;
    transform: rotate(-45deg)
}

.menu-panel {
    position: fixed;
    z-index: 59;
    inset: 0;
    background: linear-gradient(130deg, #f5f1eb 0%, #eeebe6 50%, #d9d7e7 100%);
    padding: 104px clamp(20px, 8vw, 120px) 38px;
    clip-path: inset(0 0 100% 0 round 0 0 28px 28px);
    pointer-events: none
}

.menu-shell.is-open .menu-panel {
    pointer-events: auto
}

.menu-panel:before {
    content: "";
    position: absolute;
    right: -9vw;
    bottom: -18vw;
    width: 48vw;
    height: 48vw;
    border-radius: 50%;
    background: radial-gradient(circle, #8b88c86b 0%, #8b88c800 68%);
    pointer-events: none
}

.menu-panel-head {
    position: relative;
    display: flex;
    justify-content: space-between;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
    color: #666473;
    font: 500 10px/1 Inter, sans-serif;
    letter-spacing: .13em;
    text-transform: uppercase
}

.menu-content {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, .32fr);
    gap: clamp(32px, 9vw, 160px);
    height: calc(100% - 35px);
    align-items: end
}

.menu-links {
    align-self: center;
    max-width: 850px
}

.menu-links>a,
.services-toggle {
    width: 100%;
    display: grid;
    grid-template-columns: 46px 1fr auto;
    align-items: center;
    padding: clamp(9px, 1vw, 13px) 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 600 clamp(34px, 5.2vw, 76px)/.97 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    text-align: left
}

.menu-links span:first-child,
.services-toggle>span {
    font: 500 11px/1 Inter, sans-serif;
    letter-spacing: .06em;
    color: #777481
}

.menu-links em,
.services-toggle em {
    font: 400 25px/1 Inter, sans-serif;
    font-style: normal;
    opacity: .5;
    transition: transform .4s var(--o), opacity .3s
}

.menu-links>a:hover,
.services-toggle:hover {
    color: var(--blue)
}

.menu-links>a:hover em {
    transform: translate(4px, -4px);
    opacity: 1
}

.services-toggle.active em {
    transform: rotate(45deg);
    opacity: 1
}

.menu-services {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .55s var(--o);
    overflow: hidden
}

.menu-services.expanded {
    grid-template-rows: 1fr
}

.menu-services>div {
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(18px, 5vw, 80px);
    padding-left: 46px
}

.menu-services a {
    display: flex;
    gap: 11px;
    align-items: center;
    padding: 10px 0 5px;
    color: #56535f;
    font: 500 clamp(14px, 1.25vw, 18px)/1.2 Inter, sans-serif;
    transition: color .25s
}

.menu-services a:hover {
    color: var(--blue)
}

.menu-services small {
    font: 500 10px/1 Inter, sans-serif;
    color: #918e9b
}

.menu-services b {
    margin-left: auto;
    font-weight: 400;
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: .35s var(--o)
}

.menu-services a:hover b {
    opacity: 1;
    transform: none
}

.menu-meta {
    align-self: end;
    padding-bottom: clamp(8px, 2vw, 30px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: #5a5864;
    font-size: 13px;
    line-height: 1.55
}

.menu-meta p {
    font: 500 clamp(17px, 1.55vw, 22px)/1.15 var(--font-inter), Inter, sans-serif;
    color: var(--ink)
}

.menu-meta p a {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 4px
}

.menu-meta>a {
    font-weight: 600
}

.menu-meta>span {
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase
}

/* Reference-inspired large navigation composition */
@media(min-width:701px) {
    .menu-panel {
        background: radial-gradient(circle at 50% 72%, #aaa8d8 0 9%, transparent 27%), linear-gradient(125deg, #f5f2ed 0%, #eeece9 58%, #d9d9eb 100%)
    }

    .menu-content {
        display: grid;
        min-height: calc(100vh - 142px);
        height: auto;
        align-content: center
    }

    .menu-links {
        max-width: calc(100% - clamp(190px, 31vw, 590px));
        margin-left: clamp(190px, 31vw, 590px);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        align-items: center;
        gap: clamp(28px, 5vw, 92px) clamp(35px, 8vw, 150px)
    }

    .menu-links>a {
        display: flex;
        width: auto;
        gap: 0;
        padding: 0;
        border: 0;
        font-size: clamp(42px, 4.1vw, 78px);
        line-height: 1;
        white-space: nowrap;
        color: #070914;
        transition: color .35s var(--o), transform .55s var(--o), letter-spacing .45s var(--o)
    }

    .menu-links>a:hover {
        transform: translateX(12px);
        letter-spacing: -.045em
    }

    .menu-home {
        grid-column: 1;
        grid-row: 1;
        color: #6a67ae !important
    }

    .menu-about {
        grid-column: 2;
        grid-row: 1
    }

    .menu-services-link {
        grid-column: 3;
        grid-row: 1
    }

    .menu-portfolio {
        grid-column: 1;
        grid-row: 2
    }

    .menu-blogs {
        grid-column: 2;
        grid-row: 2
    }

    .menu-contact {
        grid-column: 3;
        grid-row: 3
    }

    .menu-pricing {
        grid-column: 3;
        grid-row: 2
    }

    .menu-links span:first-child,
    .menu-links em {
        display: none
    }

    .menu-meta {
        position: absolute;
        right: 0;
        bottom: clamp(10px, 6vh, 80px);
        text-align: right
    }

    .menu-meta p {
        font-size: 18px
    }

    .menu-panel:after {
        content: "";
        position: absolute;
        z-index: -1;
        left: 36%;
        bottom: -24%;
        width: 28vw;
        height: 28vw;
        border-radius: 50%;
        background: #6a67ae;
        filter: blur(20px);
        opacity: .42
    }
}

body.menu-is-open {
    overflow: hidden
}

/* Chess artwork menu background */
.menu-panel {
    background: linear-gradient(180deg, rgba(248, 246, 253, .82) 0%, rgba(248, 246, 253, .2) 62%, rgba(248, 246, 253, .38) 100%), url('/softsaro-menu-bg.png') center/cover no-repeat;
    background-color: #f8f6fd
}

.menu-panel:before {
    background: radial-gradient(circle, #6a67ae18 0%, #6a67ae00 68%)
}

.menu-shell.is-open .menu-nav {
    background: transparent;
    border-color: #0a0b1424;
    color: var(--ink);
    backdrop-filter: none
}

.menu-shell.is-open .menu-brand,
.menu-shell.is-open .menu-trigger {
    color: var(--ink)
}

.menu-shell.is-open .menu-trigger>i {
    border-color: var(--line)
}

.menu-shell.is-open .menu-brand svg path:first-child,
.menu-shell.is-open .menu-brand svg path:nth-child(2) {
    fill: #6a67ae
}

.menu-shell.is-open .menu-brand svg path:last-child {
    fill: #3f3d7a
}

@media(max-width:700px) {
    .menu-brand {
        font-size: 19px
    }

    .menu-brand svg {
        width: 28px;
        height: 25px
    }

    .menu-trigger {
        gap: 8px;
        font-size: 11px
    }

    .menu-trigger>i {
        width: 38px;
        height: 38px
    }

    .menu-trigger b {
        left: 10px
    }

    .menu-trigger b:first-child {
        top: 14px
    }

    .menu-trigger b:last-child {
        top: 21px
    }

    .menu-shell.is-open .menu-trigger b:first-child,
    .menu-shell.is-open .menu-trigger b:last-child {
        top: 18px
    }

    .menu-panel {
        padding: 91px 20px 22px;
        overflow-y: auto
    }

    .menu-panel-head {
        font-size: 9px
    }

    .menu-panel-head span:last-child {
        display: none
    }

    .menu-content {
        display: flex;
        min-height: calc(100% - 31px);
        height: auto;
        flex-direction: column;
        align-items: stretch;
        gap: 28px
    }

    .menu-links {
        width: 100%;
        margin: auto 0
    }

    .menu-links>a,
    .services-toggle {
        grid-template-columns: 32px 1fr auto;
        font-size: clamp(32px, 10.2vw, 56px);
        padding: 9px 0
    }

    .menu-links em,
    .services-toggle em {
        font-size: 21px
    }

    .menu-services>div {
        grid-template-columns: 1fr;
        padding-left: 32px;
        padding-bottom: 8px
    }

    .menu-services a {
        padding: 7px 0 3px;
        font-size: 15px
    }

    .menu-meta {
        width: 100%;
        padding: 14px 0 0;
        border-top: 1px solid var(--line);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px 18px
    }

    .menu-meta p {
        grid-row: span 2;
        font-size: 17px
    }

    .menu-meta>span {
        font-size: 9px;
        align-self: end
    }
}

@media(min-width:701px) {
    .menu-panel {
        background: linear-gradient(180deg, rgba(248, 246, 253, .85) 0%, rgba(248, 246, 253, .15) 58%, rgba(248, 246, 253, .32) 100%), url('/softsaro-menu-bg.png') center/cover no-repeat;
        background-color: #f8f6fd
    }

    .menu-panel:after {
        display: none
    }

    .menu-links>a {
        color: #0a0b14;
        text-shadow: 0 1px 18px #f8f6fd
    }

    .menu-home {
        color: #6a67ae !important
    }

    .menu-links>a:hover {
        color: #6a67ae
    }
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 25px;
    letter-spacing: -.04em
}

.logo svg {
    width: 34px
}

.logo.inv {
    color: #fff
}

.menu {
    display: flex;
    gap: 40px;
    align-items: center
}

.menu>a,
.dd>a {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 500;
    font-size: 15.5px;
    padding: 26px 0;
    position: relative
}

.menu svg {
    width: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    transition: transform .3s
}

.dd:hover svg {
    transform: rotate(180deg)
}

.dd {
    position: relative
}

.ddm {
    position: absolute;
    top: 70px;
    left: -20px;
    min-width: 240px;
    background: #fff;
    border-radius: 16px;
    padding: 10px;
    box-shadow: 0 30px 60px -20px #0a0b1440;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: .35s var(--o)
}

.dd:hover .ddm {
    opacity: 1;
    visibility: visible;
    transform: none
}

.ddm a {
    display: block;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 15px
}

.ddm a:hover {
    background: var(--cream);
    color: var(--blue)
}

.burger {
    display: none;
    width: 40px;
    height: 40px;
    background: none;
    border: 0;
    position: relative;
    z-index: 70
}

.burger b {
    position: absolute;
    left: 8px;
    right: 8px;
    height: 2px;
    background: var(--ink);
    transition: .4s var(--o)
}

.burger b:first-child {
    top: 15px
}

.burger b:last-child {
    top: 23px
}

/* hero */
.hero {
    position: relative;
    padding: 76px 0 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: visible
}

.hero>.wrap {
    flex: 1;
    display: flex;
    align-items: center;
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 20px clamp(20px, 8vw, 120px) 0
}

.hero-copy {
    position: relative;
    z-index: 3;
    padding: clamp(30px, 4vw, 60px) 0 40px
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 500 12.5px Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: 26px
}

.gdot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 0 0 #3fe33f99;
    animation: ping 2s infinite
}

@keyframes ping {
    70% {
        box-shadow: 0 0 0 10px #3fe33f00
    }
}

h1 {
    white-space: nowrap;
    font-size: clamp(40px, 6.75vw, 122px);
    line-height: .9;
    letter-spacing: -.062em;
    font-weight: 800
}

.ln {
    display: block;
    overflow: hidden;
    padding: .04em 0 .1em;
    margin-bottom: -.1em
}

.ln em {
    display: block;
    font-style: normal
}

.sub {
    font: 400 clamp(18px, 1.7vw, 24px)/1.4 Inter, sans-serif;
    color: #4a4b55;
    margin: 30px 0 36px
}

.cta-row {
    display: flex;
    align-items: center;
    gap: 34px;
    flex-wrap: wrap
}

.hero-vis {
    position: absolute;
    right: max(1vw, calc((100vw - 1700px)/2));
    top: 50px;
    width: min(50vw, 800px);
    aspect-ratio: 700/620;
    z-index: 2;
    pointer-events: none
}

.layer,
.fl {
    position: absolute;
    inset: 0
}

.ribbon {
    width: 100%;
    height: 100%;
    overflow: visible
}

.glass {
    position: absolute;
    left: 12%;
    top: 20%;
    width: 62%;
    height: 48%;
    border-radius: 20px;
    background: linear-gradient(145deg, #ffffffd9, #ece9f7a6);
    backdrop-filter: blur(14px);
    border: 1px solid #fff;
    box-shadow: 0 40px 60px -20px #3f3d7aaa, inset 0 0 30px #fff;
    transform: perspective(900px) rotateZ(-9deg) rotateY(-16deg) rotateX(6deg);
    overflow: hidden
}

.gbar {
    height: 24px;
    background: #1a1d2b;
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 0 12px
}

.gbar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff5f57
}

.gbar i:nth-child(2) {
    background: #febc2e
}

.gbar i:nth-child(3) {
    background: #28c840
}

.gbody {
    display: grid;
    grid-template-columns: 1fr .9fr;
    gap: 6%;
    padding: 7%;
    height: calc(100% - 24px)
}

.gt h4 {
    font-size: clamp(14px, 1.9vw, 26px);
    line-height: 1;
    letter-spacing: -.04em;
    font-weight: 800;
    font-style: italic
}

.gt p {
    font-size: clamp(9px, .9vw, 13px);
    color: #555a70;
    margin: 8px 0 14px;
    font-style: italic
}

.gbtn {
    display: inline-block;
    background: var(--ink);
    color: #fff;
    font-size: clamp(8px, .8vw, 12px);
    padding: 6px 12px;
    border-radius: 99px
}

.mtn {
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover
}

.tile {
    pointer-events: none
}

.tile .fl {
    inset: auto;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: linear-gradient(145deg, #ffffffb0, #bcb9e080);
    backdrop-filter: blur(10px);
    border: 1px solid #ffffffd0;
    box-shadow: 0 20px 40px -12px #6a67ae66
}

.tile svg {
    width: 46%;
    fill: none;
    stroke: var(--blue);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round
}

.tile svg.fillsvg {
    fill: var(--ink);
    stroke: none
}

.t-code .fl {
    left: 6%;
    top: 17%;
    width: 11%;
    aspect-ratio: 1;
    background: linear-gradient(145deg, #4b4f63, #1a1d2b);
    border-color: #ffffff40
}

.t-code svg {
    stroke: #fff
}

.t-chart .fl {
    right: 6%;
    top: 24%;
    width: 15%;
    aspect-ratio: 1
}

.t-star .fl {
    left: 30%;
    top: 63%;
    width: 9%;
    aspect-ratio: 1
}

.spark {
    position: absolute;
    width: 30px;
    height: 30px;
    fill: var(--blue);
    animation: tw 3s ease-in-out infinite
}

.s1 {
    right: 1%;
    top: 20%
}

@keyframes tw {
    50% {
        transform: scale(.55) rotate(40deg);
        opacity: .6
    }
}

.pills {
    position: absolute;
    right: 0;
    top: 55%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    z-index: 4
}

.pills li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 18px 9px 12px;
    border-radius: 99px;
    background: #ffffffb0;
    backdrop-filter: blur(8px);
    border: 1px solid #0a0b1412;
    font: 500 15px var(--font-inter), Inter, sans-serif;
    letter-spacing: .02em;
    text-transform: uppercase
}

.pills i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--blue)
}

.pills i.g {
    background: var(--green)
}

.pills li:nth-child(2) {
    margin-left: 6px
}

.clients {
    width: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    max-width: none;
    padding: 0 clamp(20px, 8vw, 120px);
    background: #f3efe8cc;
    position: relative;
    z-index: 3
}

.clients>p {
    font: 500 13px/1.5 Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #555;
    padding: 22px 30px 22px 0;
    white-space: nowrap
}

/* services */
.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 6vw, 100px);
    align-items: start
}

.what h2 {
    font-size: clamp(40px, 5vw, 78px)
}

.rows {
    border-top: 1px solid var(--line);
    margin-top: 8px
}

.rows a {
    position: relative;
    display: grid;
    grid-template-columns: 60px 1fr 30px;
    align-items: center;
    padding: 17px 0;
    border-bottom: 1px solid var(--line);
    font-size: clamp(18px, 1.6vw, 22px)
}

.rows a:after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .6s var(--o)
}

.rows a:hover:after {
    transform: scaleX(1)
}

.rows small {
    font: 400 18px Inter, sans-serif;
    color: #555
}

.rows span {
    transition: transform .5s var(--o), color .3s;
    font-weight: 500
}

.rows a:hover span {
    transform: translateX(12px);
    color: var(--blue)
}

.rows svg {
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform .5s var(--o)
}

.rows a:hover svg {
    transform: translateX(6px) rotate(-45deg);
    color: var(--blue)
}

.mask b {
    color: var(--blue)
}

/* work */
.work {
    background: var(--blue);
    color: #fff;
    border-radius: 0
}

.work .wh {
    max-width: 14ch
}

.work .spark {
    position: absolute;
    right: 6%;
    top: 70px;
    width: 56px;
    height: 56px;
    fill: #fff;
    background: none
}

.pgrid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(18px, 2.4vw, 34px);
    margin-top: 70px
}

.pc {
    grid-column: span 6;
    display: block
}

.pc:nth-child(4n+1),
.pc:nth-child(4n+4) {
    grid-column: span 7
}

.pc:nth-child(4n+2),
.pc:nth-child(4n+3) {
    grid-column: span 5
}

.pimg {
    position: relative;
    aspect-ratio: 16/11;
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(135deg, #7d7abb, #3f3d7a);
    border: 1px solid #ffffff30
}

.pc:nth-child(n+2):nth-child(-n+3) .pimg {
    aspect-ratio: 1/1.05
}

.pimg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 1.3s var(--o)
}

.pc:hover img {
    transform: scale(1.07)
}

.pimg:before {
    content: attr(data-n);
    position: absolute;
    z-index: 2;
    left: 20px;
    top: 16px;
    font: 600 14px var(--font-inter), Inter, sans-serif;
    background: var(--ink);
    padding: 6px 12px;
    border-radius: 99px
}

.go {
    position: absolute;
    right: 18px;
    bottom: 18px;
    z-index: 2;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: #fff;
    color: var(--blue);
    display: grid;
    place-items: center;
    transform: scale(0);
    transition: transform .6s var(--o)
}

.go svg {
    width: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2
}

.pc:hover .go {
    transform: scale(1)
}

.pm {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    align-items: baseline;
    padding-top: 18px
}

.pm h3 {
    font-size: clamp(22px, 2.4vw, 34px);
    letter-spacing: -.04em;
    font-weight: 700
}

.pm small {
    font: 500 12px Inter, sans-serif;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #d6d4ee;
    white-space: nowrap
}

.pc p {
    color: #e4e2f4;
    max-width: 46ch;
    margin-top: 6px;
    font-size: 15px
}

.pnote {
    margin-top: 70px;
    color: #bcb9e0;
    font-size: 14px
}

/* Featured work deck */
.work-showcase {
    margin-top: clamp(40px, 6vw, 78px);
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #fff;
    box-shadow: none;
    overflow: visible
}

.showcase-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 3px clamp(18px, 2.4vw, 30px);
    font: 600 11px/1 Inter, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase
}

.showcase-bar>span {
    display: flex;
    gap: 6px
}

.showcase-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ff605c
}

.showcase-bar i:nth-child(2) {
    background: #ffbd44
}

.showcase-bar i:nth-child(3) {
    background: #00ca4e
}

.showcase-bar b {
    font: 600 11px/1 Inter, sans-serif;
    letter-spacing: .1em
}

.showcase-bar a {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-weight: 700
}

.showcase-bar .ar {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2
}

.project-deck {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 26px);
    align-items: end
}

.deck-card {
    grid-column: span 3;
    display: block;
    min-width: 0
}

.deck-card.is-featured {
    grid-column: span 5;
    grid-row: span 2;
    align-self: center
}

.deck-card .pimg {
    aspect-ratio: 1/1.06;
    border: 0;
    border-radius: clamp(18px, 2vw, 28px);
    box-shadow: 0 18px 34px -25px #17162d88;
    background: #d7d3e8
}

.deck-card.is-featured .pimg {
    aspect-ratio: 1.04/1.16;
    background: #1d1c3c
}

.deck-card .pimg:before {
    background: #ffffffdd;
    color: var(--ink);
    font-size: 11px;
    backdrop-filter: blur(8px)
}

.deck-card .go {
    width: 46px;
    height: 46px;
    right: 13px;
    bottom: 13px
}

.deck-card .go svg {
    width: 18px
}

.deck-card .pm {
    padding: 13px 3px 0;
    display: block
}

.deck-card .pm h3 {
    font-size: clamp(16px, 1.45vw, 22px);
    line-height: 1.05
}

.deck-card .pm small {
    display: block;
    margin-top: 7px;
    color: #e1def4;
    font-size: 10px;
    white-space: normal
}

.deck-card p {
    display: none
}

.deck-card.is-featured .pm {
    padding-top: 17px
}

.deck-card.is-featured .pm h3 {
    font-size: clamp(25px, 2.4vw, 38px)
}

.deck-card.is-featured p {
    display: block;
    margin: 8px 3px 0;
    color: #e2dff2;
    font-size: 14px;
    line-height: 1.55
}

.work .pnote {
    margin-top: 24px;
    color: #d8d5ee
}

@media(max-width:900px) {
    .project-deck {
        grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .deck-card,
    .deck-card.is-featured {
        grid-column: span 1;
        grid-row: auto
    }

    .deck-card.is-featured {
        grid-column: span 2
    }

    .deck-card.is-featured .pimg {
        aspect-ratio: 16/10
    }

    .showcase-bar b {
        display: none
    }
}

@media(max-width:520px) {
    .work-showcase {
        padding: 13px;
        border-radius: 20px
    }

    .project-deck {
        gap: 13px
    }

    .deck-card .pimg {
        border-radius: 16px
    }

    .deck-card .pm h3 {
        font-size: 15px
    }

    .deck-card.is-featured .pm h3 {
        font-size: 25px
    }

    .showcase-bar {
        padding-bottom: 16px
    }

    .showcase-bar a {
        font-size: 10px
    }
}

/* Editorial project-board arrangement */
@media(min-width:901px) {
    .work .wh {
        max-width: 9ch;
        font-size: clamp(42px, 4.1vw, 74px)
    }

    .work-showcase {
        max-width: 1240px;
        margin: clamp(34px, 4vw, 56px) auto 0;
        padding: clamp(18px, 2.2vw, 30px);
        border-radius: 28px;
        background: #f4f2fb
    }

    .project-deck {
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: auto auto auto;
        gap: clamp(16px, 2vw, 28px);
        align-items: start
    }

    .deck-card,
    .deck-card.is-featured {
        grid-row: auto;
        align-self: auto
    }

    .deck-card.is-featured {
        grid-column: 1 / span 5;
        grid-row: 1 / span 2;
        margin-top: clamp(38px, 6vw, 92px)
    }

    .deck-card:nth-child(2) {
        grid-column: 6 / span 7;
        grid-row: 1
    }

    .deck-card:nth-child(3) {
        grid-column: 6 / span 7;
        grid-row: 2
    }

    .deck-card:nth-child(4) {
        grid-column: 1 / span 5;
        grid-row: 3
    }

    .deck-card.is-featured .pimg {
        aspect-ratio: 1.1/1
    }

    .deck-card:nth-child(2) .pimg,
    .deck-card:nth-child(3) .pimg {
        aspect-ratio: 16/8
    }

    .deck-card:nth-child(4) .pimg {
        aspect-ratio: 1.1/1
    }

    .deck-card:nth-child(2) .pm,
    .deck-card:nth-child(3) .pm {
        padding-top: 10px
    }

    .deck-card:nth-child(2) .pm h3,
    .deck-card:nth-child(3) .pm h3 {
        font-size: clamp(18px, 1.6vw, 25px)
    }
}

/* Horizontal product shelf */
.showcase-tabs {
    display: grid;
    grid-template-columns: auto auto auto 1fr auto;
    align-items: center;
    gap: clamp(15px, 2.5vw, 40px);
    padding: 0 clamp(4px, 1vw, 15px) clamp(26px, 3.5vw, 48px);
    font: 500 12px/1 Inter, sans-serif;
    color: #8b8995
}

.showcase-tabs span:first-child,
.showcase-tabs strong {
    color: var(--ink);
    font-weight: 700
}

.showcase-tabs strong {
    justify-self: start;
    font: 700 clamp(18px, 2vw, 28px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em
}

.showcase-tabs em {
    font-style: normal;
    font-size: 15px
}

.project-deck {
    display: flex !important;
    align-items: flex-end;
    gap: clamp(12px, 1.7vw, 24px) !important;
    min-height: clamp(320px, 31vw, 500px)
}

.deck-card,
.deck-card.is-featured,
.deck-card:nth-child(n) {
    display: block !important;
    flex: 1 1 0;
    min-width: 0;
    margin: 0 !important;
    grid-column: auto !important;
    grid-row: auto !important;
    align-self: flex-end !important
}

.deck-card.is-featured {
    order: 2;
    flex: 1.62 1 0
}

.deck-card:nth-child(2) {
    order: 1
}

.deck-card:nth-child(3) {
    order: 3
}

.deck-card:nth-child(4) {
    order: 4
}

.deck-card .pimg,
.deck-card.is-featured .pimg,
.deck-card:nth-child(n) .pimg {
    aspect-ratio: 1/1.22;
    border-radius: clamp(17px, 2vw, 28px)
}

.deck-card.is-featured .pimg {
    aspect-ratio: 1/1.34
}

.deck-card .pm {
    padding-top: 12px
}

.deck-card .pm h3 {
    font-size: clamp(14px, 1.35vw, 20px)
}

.deck-card.is-featured .pm h3 {
    font-size: clamp(21px, 2vw, 32px)
}

.deck-card.is-featured p {
    font-size: 13px
}

.deck-card .pimg:before {
    left: 12px;
    top: 12px
}

.deck-card .go {
    transform: scale(1);
    width: 38px;
    height: 38px;
    right: 10px;
    bottom: 10px
}

.deck-card .go svg {
    width: 16px
}

@media(max-width:900px) {
    .showcase-tabs {
        grid-template-columns: auto auto 1fr;
        gap: 15px
    }

    .showcase-tabs span:nth-child(3),
    .showcase-tabs em {
        display: none
    }

    .showcase-tabs strong {
        grid-column: 1/-1
    }

    .project-deck {
        display: grid !important;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        min-height: 0
    }

    .deck-card,
    .deck-card.is-featured,
    .deck-card:nth-child(n) {
        grid-column: auto !important;
        order: initial
    }

    .deck-card.is-featured {
        grid-column: span 2 !important
    }

    .deck-card .pimg,
    .deck-card.is-featured .pimg {
        aspect-ratio: 1/1.08
    }
}

.project-deck .deck-card {
    flex: 1 1 0
}

.project-deck .deck-card.is-featured {
    flex: 1.6 1 0
}

.project-deck .deck-card .pimg,
.project-deck .deck-card:nth-child(2) .pimg,
.project-deck .deck-card:nth-child(3) .pimg,
.project-deck .deck-card:nth-child(4) .pimg {
    aspect-ratio: .95/1;
    object-position: center
}

.project-deck .deck-card.is-featured .pimg {
    aspect-ratio: .92/1
}

.project-deck .deck-card.is-featured .pimg img {
    object-position: center
}

.project-deck .deck-card:nth-child(2) .pm,
.project-deck .deck-card:nth-child(3) .pm {
    padding-top: 12px
}

.project-deck .deck-card:nth-child(2) .pm h3,
.project-deck .deck-card:nth-child(3) .pm h3 {
    font-size: clamp(14px, 1.35vw, 20px)
}

.project-deck .deck-more {
    order: 0
}

.project-deck .deck-more .pimg {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(14px, 1.8vw, 24px);
    background: linear-gradient(145deg, #a9a5de, #5b57a9);
    color: #fff
}

.project-deck .deck-more .pimg:before {
    display: none
}

.project-deck .deck-more .pimg>span {
    font: 400 clamp(34px, 4vw, 58px)/.8 Inter, sans-serif
}

.project-deck .deck-more .pimg>b {
    font: 700 clamp(17px, 1.6vw, 25px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.04em
}

.work {
    background: var(--cream);
    color: #0a0b14
}

.work .lab.w,
.work .wh,
.work .pnote {
    color: #0a0b14
}

.work-showcase .deck-card .pm h3 {
    color: #0a0b14;
    text-shadow: none
}

.work-showcase .deck-card .pm small {
    color: #353542
}

.work-showcase .deck-card.is-featured p {
    color: #262631
}

.work-showcase .deck-more .pm h3,
.work-showcase .deck-more .pm small {
    color: #0a0b14
}

.work-showcase .showcase-bar,
.work-showcase .showcase-bar b,
.work-showcase .showcase-bar a {
    color: #0a0b14
}

.work-showcase {
    background: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important
}

.project-deck .deck-card .pimg {
    border-radius: 30% 25% 22% 27% / 15% 14% 12% 13%
}

.project-deck .deck-card:nth-child(2) .pimg {
    border-radius: 24% 31% 25% 22% / 14% 17% 12% 11%
}

.project-deck .deck-card:nth-child(3) .pimg {
    border-radius: 32% 23% 24% 29% / 16% 13% 12% 15%
}

.project-deck .deck-card:nth-child(4) .pimg {
    border-radius: 26% 30% 20% 28% / 14% 16% 11% 14%
}

.project-deck .deck-card.is-featured .pimg {
    border-radius: 28% 25% 23% 26% / 14% 14% 12% 13%
}

.project-deck .card {
    position: relative;
    overflow: visible
}

.project-deck .card .pimg {
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(145deg, #bfddff, #698dcc)
}

.project-deck .card-1 .pimg {
    background: linear-gradient(145deg, #204b7e, #70b8ff)
}

.project-deck .card-2 .pimg {
    background: linear-gradient(145deg, #ffd5bd, #f37f55)
}

.project-deck .card-3 .pimg {
    background: linear-gradient(145deg, #25223f, #7770b6)
}

.project-deck .card-4 .pimg {
    background: linear-gradient(145deg, #d4c6ff, #8e78cf)
}

.project-deck .card .pimg img {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 8% 7% 6%;
    transform: none !important
}

.project-deck .card .go {
    top: 13px;
    right: 13px;
    bottom: auto;
    z-index: 4;
    background: #ffffffed;
    box-shadow: 0 8px 18px #0a0b1433
}

.project-deck .card .pm {
    padding-right: 52px
}

.project-deck .card .pm h3 {
    overflow-wrap: anywhere
}

.project-deck .card .pm small {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis
}

.project-deck .card-3 .pm small {
    white-space: normal
}

.project-deck .card.is-featured::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: 16%;
    right: 16%;
    bottom: 34px;
    height: 22px;
    border-radius: 50%;
    background: #201c4a66;
    filter: blur(15px)
}

.project-deck .card .pimg {
    --card-gradient: linear-gradient(145deg, #bfddff, #698dcc);
    overflow: visible;
    background: none !important;
    isolation: isolate
}

.project-deck .card-1 .pimg {
    --card-gradient: linear-gradient(145deg, #204b7e, #70b8ff)
}

.project-deck .card-2 .pimg {
    --card-gradient: linear-gradient(145deg, #ffd5bd, #f37f55)
}

.project-deck .card-3 .pimg {
    --card-gradient: linear-gradient(145deg, #25223f, #7770b6)
}

.project-deck .card-4 .pimg {
    --card-gradient: linear-gradient(145deg, #d4c6ff, #8e78cf)
}

.project-deck .card .pimg::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: var(--card-gradient);
    pointer-events: none
}

.project-deck .card .pimg img {
    top: -28px;
    left: 50%;
    inset: auto;
    width: 110%;
    height: auto;
    max-height: none;
    padding: 0;
    transform: translateX(-50%) rotate(-3deg) !important;
    transform-origin: 50% 50%;
    object-fit: contain;
    mix-blend-mode: multiply;
    filter: drop-shadow(0 16px 14px rgba(10, 11, 20, .24));
    z-index: 2
}

.project-deck .card .pimg:before {
    z-index: 3
}

.project-deck .card .go {
    z-index: 4
}

.project-deck .card.is-featured::after {
    left: 12%;
    right: 12%;
    bottom: -16px;
    height: 22px;
    background: rgba(0, 0, 0, .28);
    filter: blur(14px);
    z-index: -1
}

.project-deck .card .pm small {
    white-space: nowrap;
    overflow: visible;
    text-overflow: clip
}

.project-deck .card-3 .pm small {
    white-space: nowrap
}

.project-deck .card.is-featured .pm h3 {
    font-size: clamp(26px, 2.2vw, 34px);
    white-space: nowrap
}

.project-deck .deck-more .pimg>span {
    font-size: clamp(44px, 4.8vw, 70px);
    font-weight: 800;
    line-height: .7
}

/* about */
.about .big {
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.3;
    letter-spacing: -.02em;
    font-weight: 500;
    color: #2a2b36;
    padding-top: 10px
}

.about .two {
    margin-bottom: 70px
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--ink)
}

.stats div {
    padding: 28px 20px 10px 0
}

.stats div+div {
    border-left: 1px solid var(--line);
    padding-left: 26px
}

.stats b {
    display: block;
    font: 800 clamp(52px, 7vw, 110px)/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.06em;
    color: var(--blue)
}

.stats small {
    display: block;
    color: #555;
    max-width: 20ch;
    margin-top: 8px
}

/* why */
.why {
    background: var(--ink);
    color: #fff
}

.why h2 {
    max-width: 18ch;
    font-size: clamp(36px, 5vw, 80px)
}

.wgrid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 70px;
    border-top: 1px solid #ffffff26
}

.wi {
    padding: 34px 30px 40px 0;
    border-bottom: 1px solid #ffffff26;
    position: relative;
    transition: background .5s
}

.wi:not(:nth-child(3n+1)) {
    padding-left: 30px;
    border-left: 1px solid #ffffff26
}

.wi:hover {
    background: #ffffff0a
}

.wi small {
    font: 500 13px Inter, sans-serif;
    color: var(--green);
    letter-spacing: .08em
}

.wi h3 {
    font-size: clamp(22px, 2vw, 28px);
    letter-spacing: -.035em;
    line-height: 1.1;
    margin: 44px 0 12px
}

.wi p {
    color: #a5a8bc;
    font-size: 15px
}

/* process */
.steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    margin-top: 80px
}

.pline {
    position: absolute;
    top: 22px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line)
}

.pline i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left
}

.sp {
    position: relative;
    padding-top: 62px
}

.sp b {
    position: absolute;
    left: 0;
    top: 0;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--cream);
    border: 2px solid var(--line);
    font: 700 14px var(--font-inter), Inter, sans-serif;
    transition: .5s
}

.sp.on b {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    box-shadow: 0 0 0 7px #6a67ae22
}

.sp h3 {
    font-size: 32px;
    letter-spacing: -.05em;
    margin-bottom: 8px
}

.sp p {
    color: #4a4b55;
    font-size: 15px
}

.sp em {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
    font-style: normal
}

.sp em span {
    font-size: 12px;
    padding: 5px 12px;
    border-radius: 99px;
    border: 1px solid var(--line)
}

/* tech */
.tech {
    background: var(--cream2)
}

.trows {
    margin-top: 60px;
    border-top: 1px solid var(--ink)
}

.tr1 {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 30px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--line)
}

.tr1 h3 {
    font: 500 13px Inter, sans-serif;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #555
}

.tr1 div {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 22px;
    font: 800 clamp(30px, 4.6vw, 72px)/1.02 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em
}

.tr1 span {
    transition: color .3s, transform .5s var(--o);
    cursor: default
}

.tr1 span:hover {
    color: var(--blue);
    transform: translateY(-4px)
}

.tr1 span:not(:last-child):after {
    content: "/";
    color: #0a0b1433;
    margin-left: 22px
}

/* testimonials */
.thead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px
}

.tnav {
    display: flex;
    gap: 10px;
    padding-bottom: 10px
}

.tnav button {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: none;
    display: grid;
    place-items: center;
    transition: .35s
}

.tnav button:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff
}

.tnav svg {
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8
}

.tr {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 60px calc(-1*clamp(20px, 8vw, 120px)) 0;
    padding: 6px clamp(20px, 8vw, 120px) 26px;
    scrollbar-width: none;
    cursor: grab
}

.tr::-webkit-scrollbar {
    display: none
}

.tq {
    flex: 0 0 min(440px, 84vw);
    scroll-snap-align: start;
    background: #fff;
    border-radius: 26px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 340px;
    transition: transform .5s var(--o), background .4s, color .4s
}

.tq:hover {
    background: var(--blue);
    color: #fff;
    transform: translateY(-8px)
}

.tq:before {
    content: "“";
    font: 800 90px/.7 var(--font-inter), Inter, sans-serif;
    color: var(--blue);
    height: 44px;
    transition: color .4s
}

.tq:hover:before {
    color: var(--green)
}

.tq p {
    font: 500 21px/1.35 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.02em;
    margin: 10px 0 28px
}

.tw {
    display: flex;
    gap: 14px;
    align-items: center
}

.tw i {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
    font: 700 16px var(--font-inter), Inter, sans-serif;
    font-style: normal
}

.tw b {
    display: block;
    line-height: 1.2
}

.tw small {
    opacity: .65
}

/* final + footer */
.final {
    background: var(--blue);
    color: #fff;
    text-align: left;
    padding: clamp(100px, 14vw, 200px) 0
}

.mega {
    font-size: clamp(52px, 11vw, 190px);
    line-height: .88;
    letter-spacing: -.066em;
    max-width: none;
    font-weight: 800
}

.final .mega b {
    color: var(--green)
}

.fsub {
    font-size: clamp(18px, 1.8vw, 24px);
    color: #e4e2f4;
    max-width: 36ch;
    margin: 36px 0 40px
}

.final .spark {
    position: absolute;
    fill: #fff
}

.s3 {
    right: 12%;
    top: 18%;
    width: 64px !important;
    height: 64px !important
}

.s4 {
    right: 24%;
    bottom: 16%;
    width: 28px !important;
    height: 28px !important
}

.final .wrap {
    position: relative
}

.foot {
    background: var(--ink);
    color: #fff;
    padding-top: 90px;
    overflow: hidden
}

.fgrid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px
}

.fgrid p {
    color: #9fa2b6;
    max-width: 36ch;
    margin-top: 20px;
    font-size: 15px
}

.fgrid h4 {
    font: 500 12px Inter, sans-serif;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 18px
}

.fgrid a:not(.logo) {
    display: block;
    color: #c9cbd9;
    padding: 5px 0;
    font-size: 15px;
    transition: .35s var(--o)
}

.fgrid a:not(.logo):hover {
    color: #fff;
    transform: translateX(6px)
}

.copy {
    display: flex;
    justify-content: space-between;
    margin-top: 70px;
    padding-top: 24px;
    border-top: 1px solid #ffffff1f;
    color: #8a8da3;
    font-size: 14px
}

.giant {
    font: 800 21vw/.78 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.07em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px #ffffff26;
    margin-top: 30px;
    transform: translateY(14%);
    user-select: none;
    white-space: nowrap
}

[data-r],
[data-h] {
    will-change: transform
}

@media(max-width:1000px) {
    .nav {
        padding: 0 20px
    }

    .menu {
        position: fixed;
        inset: 0;
        background: var(--cream);
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 0 30px;
        gap: 0;
        transform: translateY(-100%);
        transition: transform .6s var(--e)
    }

    .nav.open .menu {
        transform: none
    }

    .menu>a,
    .dd>a {
        font: 700 40px var(--font-inter), Inter, sans-serif;
        letter-spacing: -.04em;
        padding: 12px 0
    }

    .dd .ddm,
    .menu svg {
        display: none
    }

    .nav>.btn {
        display: none
    }

    .burger {
        display: block
    }

    .nav.open .burger b:first-child {
        top: 19px;
        transform: rotate(45deg)
    }

    .nav.open .burger b:last-child {
        top: 19px;
        transform: rotate(-45deg)
    }

    .hero>.wrap {
        flex-direction: column;
        align-items: stretch
    }

    .hero-vis {
        position: relative;
        right: auto;
        top: auto;
        width: 100%;
        max-width: 620px;
        margin: 0 auto -20px
    }

    .hero-copy {
        padding-bottom: 10px;
        max-width: none
    }

    .two {
        grid-template-columns: 1fr
    }

    .pgrid .pc,
    .pc:nth-child(n) {
        grid-column: span 12
    }

    .wgrid {
        grid-template-columns: 1fr 1fr
    }

    .wi:nth-child(n) {
        padding-left: 0;
        border-left: 0
    }

    .wi:nth-child(even) {
        padding-left: 24px;
        border-left: 1px solid #ffffff26
    }

    .steps {
        grid-template-columns: 1fr;
        gap: 34px
    }

    .pline {
        left: 22px;
        right: auto;
        width: 2px;
        height: 100%;
        top: 0
    }

    .pline i {
        transform-origin: top
    }

    .sp {
        padding: 2px 0 0 72px
    }

    .tr1 {
        grid-template-columns: 1fr;
        gap: 8px
    }

    .fgrid {
        grid-template-columns: 1fr 1fr
    }

    .stats {
        grid-template-columns: 1fr 1fr
    }

    .stats div:nth-child(3) {
        border-left: 0;
        padding-left: 0
    }

    .clients {
        flex-direction: column;
        align-items: flex-start;
        padding-bottom: 6px
    }

    .mq {
        width: 100%;
        flex: none
    }
}

@media(max-width:600px) {

    .wgrid,
    .fgrid {
        grid-template-columns: 1fr
    }

    .wi:nth-child(n) {
        padding-left: 0;
        border-left: 0
    }

    .pills {
        top: 60%
    }

    .pills li {
        font-size: 12px;
        padding: 6px 12px 6px 8px
    }

    .thead {
        flex-direction: column;
        align-items: flex-start
    }

    .stats b {
        font-size: 56px
    }

    .copy {
        flex-direction: column;
        gap: 8px
    }

    .spark.s1 {
        display: none
    }
}

@media(prefers-reduced-motion:reduce) {
    * {
        animation: none !important;
        transition-duration: .01ms !important
    }
}

/* motion layer */
html.lenis,
html.lenis body {
    height: auto
}

.lenis.lenis-smooth {
    scroll-behavior: auto !important
}

.lenis.lenis-stopped {
    overflow: hidden
}

.sw {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: .1em .1em .16em;
    margin: -.1em -.1em -.16em;
    white-space: nowrap
}

.si {
    display: inline-block;
    will-change: transform
}

.ln .sw,
.giant .sw {
    overflow: visible;
    padding: 0;
    margin: 0
}

.cur,
.cur-dot,
.pv {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 200
}

html.has-cursor .cur,
html.has-cursor .cur-dot,
html.has-cursor .pv {
    display: block
}

html.has-cursor,
html.has-cursor * {
    cursor: none !important
}

.cur,
.cur-dot {
    opacity: 0
}

.cur {
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px
}

.cur i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    transition: transform .5s var(--o), background .3s, border-color .3s
}

.cur span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font: 600 10px/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: .05em;
    color: #fff;
    opacity: 0;
    transition: opacity .3s
}

.cur[data-s=link] i {
    transform: scale(1.6);
    background: #6a67ae1f
}

.cur[data-s=open] i,
.cur[data-s=drag] i {
    transform: scale(2.4);
    background: var(--blue);
    border-color: var(--blue)
}

.cur[data-s=open] span,
.cur[data-s=drag] span {
    opacity: 1
}

.cur[data-s=view] i {
    transform: scale(0)
}

.cur.down i {
    transform: scale(.7) !important
}

.cur.inv i {
    border-color: #fff
}

.cur.inv[data-s=link] i {
    background: #ffffff26
}

.cur.inv[data-s=open] i,
.cur.inv[data-s=drag] i {
    background: #fff
}

.cur.inv[data-s=open] span,
.cur.inv[data-s=drag] span {
    color: var(--blue)
}

.cur-dot {
    width: 7px;
    height: 7px;
    margin: -3.5px 0 0 -3.5px;
    border-radius: 50%;
    background: var(--blue)
}

.cur-dot.inv {
    background: #fff
}

.cur-dot[data-s=open],
.cur-dot[data-s=drag],
.cur-dot[data-s=view] {
    opacity: 0 !important
}

.pv {
    z-index: 150
}

.pv-in {
    position: relative;
    width: 150px;
    height: 150px;
    margin: -75px 0 0 -75px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid #fff;
    box-shadow: 0 20px 50px -10px #3f3d7aaa
}

.pv i {
    position: absolute;
    inset: 0;
    background: var(--blue) center/cover
}

.pv span {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font: 600 14px var(--font-inter), Inter, sans-serif;
    background: #0a0b1440
}

.shp {
    position: absolute;
    z-index: 1;
    pointer-events: none
}

.shp i {
    position: absolute;
    inset: 0;
    display: block
}

.rg {
    border-radius: 50%
}

.rg::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1.5px dashed #6a67ae77;
    border-radius: 50%;
    animation: spin 40s linear infinite
}

.sa {
    width: 150px;
    height: 150px;
    left: 46%;
    top: 20%
}

.sb {
    width: 18px;
    height: 18px;
    left: 41%;
    top: 76%
}

.sb i {
    background: var(--green);
    border-radius: 50%
}

.sc {
    width: 64px;
    height: 64px;
    right: 7%;
    bottom: 24%
}

.sc i {
    border: 1.5px solid #0a0b1433;
    border-radius: 16px;
    transform: rotate(18deg)
}

.sind {
    position: absolute;
    left: clamp(14px, 2.2vw, 36px);
    bottom: 150px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font: 500 11px Inter, sans-serif;
    letter-spacing: .2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    color: #555
}

.sind i {
    display: block;
    width: 1px;
    height: 64px;
    background: #0a0b1433;
    position: relative;
    overflow: hidden
}

.sind i::after {
    content: "";
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: var(--blue);
    animation: drop 2s var(--e) infinite
}

@keyframes drop {
    to {
        top: 100%
    }
}

.mq {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent)
}

.tk {
    display: flex;
    width: max-content;
    align-items: center
}

.tk span {
    display: flex;
    align-items: center;
    padding: 26px 0;
    font: 500 18px var(--font-inter), Inter, sans-serif;
    white-space: nowrap;
    cursor: default;
    transition: color .3s, transform .5s var(--o)
}

.tk span::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0a0b1433;
    margin: 0 32px
}

.tk span:hover {
    color: var(--blue);
    transform: scale(1.1)
}

.rows a {
    isolation: isolate;
    padding: 17px 14px;
    margin: 0 -14px
}

.rows a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform .6s var(--e)
}

.rows a:hover::before {
    transform: scaleY(1)
}

.rows a:hover {
    color: #fff
}

.rows a:hover small {
    color: var(--green)
}

.rows a:hover span {
    color: #fff
}

.rows a:hover svg {
    color: var(--green)
}

.rows small,
.rows a {
    transition: color .4s
}

.wi>* {
    position: relative
}

.wi::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(320px circle at var(--x, 50%) var(--y, 50%), #6a67ae55, transparent 70%);
    opacity: 0;
    transition: opacity .4s;
    pointer-events: none
}

.wi:hover::before {
    opacity: 1
}

.sp h3,
.sp p,
.sp em {
    opacity: .32;
    transform: translateY(10px);
    transition: opacity .6s var(--o), transform .8s var(--o)
}

.sp.on h3,
.sp.on p,
.sp.on em {
    opacity: 1;
    transform: none
}

.sp.on p {
    transition-delay: .08s
}

.sp.on em {
    transition-delay: .16s
}

.tprog {
    height: 2px;
    background: var(--line);
    margin-top: 10px;
    border-radius: 2px;
    overflow: hidden
}

.tprog i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left;
    transform: scaleX(.12);
    transition: transform .3s
}

.tq p {
    transform: translateX(calc(var(--px, 0)*22px))
}

.fa {
    width: 520px;
    height: 520px;
    right: -140px;
    top: -120px
}

.fa .rg::before {
    border-color: #ffffff55
}

.fb {
    width: 300px;
    height: 300px;
    left: -90px;
    bottom: -80px
}

.fb .rg::before {
    border: 1.5px solid #ffffff33;
    animation-direction: reverse
}

@media(max-width:1000px) {

    .sind,
    .sa,
    .sc {
        display: none
    }

    .fa {
        width: 320px;
        height: 320px
    }
}

/* ===== FINAL UI POLISH (appended; overrides only type scale & rhythm) ===== */
h1 {
    font-size: clamp(38px, 5.4vw, 92px);
    line-height: .96;
    letter-spacing: -.05em
}

h2,
.what h2,
.why h2 {
    font-size: clamp(32px, 4.2vw, 64px);
    line-height: 1.02;
    letter-spacing: -.045em;
    max-width: 20ch
}

.why h2 {
    max-width: 24ch
}

.mega {
    font-size: clamp(44px, 8.2vw, 136px);
    line-height: .96;
    letter-spacing: -.05em
}

.sub {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    max-width: 40ch
}

.about .big {
    font-size: clamp(17px, 1.5vw, 22px);
    line-height: 1.5;
    letter-spacing: -.01em
}

.rows a {
    font-size: clamp(18px, 1.5vw, 21px)
}

.pm h3 {
    font-size: clamp(20px, 1.9vw, 27px);
    letter-spacing: -.03em
}

.pc p {
    max-width: 40ch
}

.pc p,
.wi p,
.sp p {
    font-size: 14.5px;
    line-height: 1.6
}

.wi h3 {
    font-size: clamp(19px, 1.6vw, 23px)
}

.sp h3 {
    font-size: clamp(22px, 2vw, 26px)
}

.stats b {
    font-size: clamp(44px, 5.2vw, 76px)
}

.tq p {
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.6
}

.fsub {
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    max-width: 44ch
}

.fgrid p {
    font-size: 14px;
    line-height: 1.6
}

.fgrid a:not(.logo) {
    font-size: 14px
}

/* ===== MOTION PLUS ===== */
.stats {
    position: relative
}

.jline {
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 3px;
    pointer-events: none
}

.jline i {
    display: block;
    height: 100%;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left
}

.svp {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 90;
    width: 190px;
    padding: 18px 20px;
    border-radius: 20px;
    background: var(--blue);
    color: #fff;
    border: 1px solid #ffffff40;
    box-shadow: 0 24px 50px -18px #6a67ae99;
    pointer-events: none;
    will-change: transform
}

.svp b {
    display: block;
    font: 800 44px/1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.05em
}

.svp span {
    display: block;
    margin-top: 8px;
    font-size: 14px;
    line-height: 1.3;
    opacity: .9
}

/* ===== SERVICES SHOWCASE ===== */
.svx-head {
    margin-bottom: clamp(28px, 4vw, 56px)
}

.svx-track {
    position: relative
}

.svx-stage {
    display: grid;
    grid-template-columns: minmax(0, .78fr) minmax(0, 1.35fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start
}

@media(min-width:900px) and (min-height:720px) {
    .svx-track {
        min-height: 250vh
    }

    .svx-stage {
        position: sticky;
        top: 100px
    }
}

@media(max-width:899px) {
    .svx-stage {
        grid-template-columns: minmax(0, 1fr)
    }
}

.svx-nav {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line)
}

.svx-nav li {
    border-bottom: 1px solid var(--line)
}

.svx-item {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: clamp(12px, 1.6vw, 20px) 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer
}

.svx-item:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px
}

.svx-item small {
    min-width: 30px;
    font: 500 13px Inter, sans-serif;
    letter-spacing: .08em;
    color: #9a98a8;
    transition: color .4s
}

.svx-item span {
    flex: 1;
    min-width: 0;
    font: 600 clamp(24px, 3vw, 44px)/1.08 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.035em;
    color: #a9a7b6;
    transition: color .5s var(--o)
}

.svx-arrow {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: grid;
    place-items: center;
    opacity: 0
}

.svx-nav li:first-child .svx-arrow {
    opacity: 1
}

.svx-arrow svg {
    width: 16px;
    height: 16px
}

.svx-nav li.on small {
    color: var(--blue)
}

.svx-nav li.on .svx-item span {
    color: var(--ink)
}

.svx-nav li .svx-show {
    margin: 4px 0 20px
}

.svx-show {
    min-width: 0;
    border-radius: 26px;
    background: #fff;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -40px #3f3d7a66
}

.svx-img {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: linear-gradient(135deg, #7d7abb, #3f3d7a)
}

.svx-pic {
    position: absolute;
    inset: 0;
    clip-path: inset(100% 0 0 0)
}

.svx-pic:first-child {
    clip-path: inset(0)
}

.svx-pic img,
.svx-pic svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top
}

.svx-cap {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 3;
    padding: 7px 13px;
    border-radius: 99px;
    background: #0a0b14aa;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font: 500 12px Inter, sans-serif;
    pointer-events: none
}

.svx-infos {
    display: grid;
    padding: clamp(20px, 2.4vw, 30px)
}

.svx-in {
    grid-area: 1/1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    visibility: hidden;
    opacity: 0
}

.svx-in:first-child {
    visibility: visible;
    opacity: 1
}

@media(max-width:1180px) {
    .svx-in {
        grid-template-columns: minmax(0, 1fr)
    }
}

.svx-in h3 {
    margin: 0 0 10px;
    font: 700 clamp(24px, 2.4vw, 32px)/1.1 var(--font-inter), Inter, sans-serif;
    letter-spacing: -.03em
}

.svx-in p {
    margin: 0 0 18px;
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a55;
    max-width: 46ch
}

.svx-in .lk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
    color: var(--blue)
}

.svx-in .lk svg {
    width: 16px;
    height: 16px;
    transition: transform .4s var(--o)
}

.svx-in .lk:hover svg {
    transform: translate(3px, -3px)
}

.svx-in h4 {
    margin: 0 0 12px;
    font: 500 11px Inter, sans-serif;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #8a8896
}

.svx-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px
}

.svx-tags span {
    padding: 8px 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    background: #f4f2fa;
    font: 500 13px Inter, sans-serif;
    color: var(--ink)
}

