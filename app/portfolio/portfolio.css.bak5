/* Portfolio page - prefixed .pf */
.pf{--p:#6a67ae;--p2:#3f3d7a;--pl:#bcb9e0;--ink:#12121f;--cream:#f7f5f1;--grey:#6b6a78;--line:#12121f1a;background:var(--cream);color:var(--ink);overflow-x:clip;font:400 16px/1.6 Inter,system-ui,sans-serif}
.pf *{box-sizing:border-box}.pf p{margin:0}.pf a{color:inherit;text-decoration:none}.pf ul{list-style:none;margin:0;padding:0}
.pf h1,.pf h2,.pf h3{font-family:'Inter Tight',Inter,sans-serif;font-weight:700;letter-spacing:-.04em;white-space:normal;max-width:none;margin:0}
.pf-wrap{max-width:1280px;margin:0 auto;padding:0 clamp(20px,5vw,56px)}
.pf-sec{padding:clamp(64px,8vw,120px) 0}
.pf-eye{display:inline-flex;align-items:center;gap:10px;font:600 12px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--p);margin-bottom:14px}.pf-eye::before{content:"";width:24px;height:1px;background:currentColor}
.pf-w{display:inline-block;overflow:hidden;vertical-align:top;padding:.08em .08em .16em;margin:-.08em -.08em -.16em;white-space:nowrap}.pf-i{display:inline-block;will-change:transform}
/* hero */
.pf-hero{position:relative;overflow:hidden;padding:calc(76px + clamp(48px,7vw,100px)) 0 clamp(56px,7vw,100px);background:linear-gradient(180deg,#e9f1ee 0%,#f3efe9 55%,var(--cream) 100%)}
.pf-bg{position:absolute;inset:0;pointer-events:none}.pf-bg::before{content:"";position:absolute;inset:0;background-image:radial-gradient(#12121f14 1px,transparent 1.2px);background-size:26px 26px;-webkit-mask-image:radial-gradient(70% 80% at 50% 30%,#000,transparent);mask-image:radial-gradient(70% 80% at 50% 30%,#000,transparent)}
.pf-glow{position:absolute;left:0;top:0;width:520px;height:520px;border-radius:50%;background:radial-gradient(circle,#6a67ae38,transparent 65%)}
.pf-shape{position:absolute;display:block;border-radius:50%}.pf-shape.s1{width:180px;height:180px;right:9%;top:22%;border:1.5px dashed #6a67ae55}.pf-shape.s2{width:90px;height:90px;left:7%;bottom:18%;background:linear-gradient(135deg,#bcb9e0,#6a67ae66)}.pf-shape.s3{width:46px;height:46px;right:24%;bottom:14%;border-radius:14px;background:#3fe33f55;transform:rotate(18deg)}
.pf-layer{position:absolute;inset:0}
.pf-hero-in{position:relative;text-align:center;display:flex;flex-direction:column;align-items:center}
.pf-pill{display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:99px;background:#fff;box-shadow:0 0 0 1px var(--line);font:600 12px/1 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;margin-bottom:26px}.pf-pill i{width:7px;height:7px;border-radius:50%;background:var(--p)}
.pf-h1{font-size:clamp(38px,6.6vw,96px);line-height:.98;max-width:14ch}.pf-h1 em{font-style:normal;color:var(--p)}
.pf-sub{max-width:52ch;margin-top:22px;color:var(--grey);font-size:clamp(16px,1.4vw,19px)}
.pf-stats{display:flex;flex-wrap:wrap;justify-content:center;gap:12px 40px;margin-top:38px}.pf-stats li{text-align:center}.pf-stats b{display:block;font:700 clamp(26px,3vw,40px)/1 'Inter Tight',sans-serif;letter-spacing:-.04em}.pf-stats span{font-size:13px;color:var(--grey)}
/* heads */
.pf-head{display:grid;gap:6px;margin-bottom:clamp(28px,4vw,52px)}.pf-head h2{font-size:clamp(28px,3.6vw,52px);line-height:1.05}.pf-head p:last-child{color:var(--grey);max-width:52ch}
/* featured */
.pf-fgrid{display:grid;grid-template-columns:repeat(12,1fr);gap:clamp(18px,2.4vw,32px)}
.pf-feat{display:flex;flex-direction:column;gap:18px;background:#fff;border-radius:28px;padding:14px 14px 26px;box-shadow:0 30px 60px -44px #3f3d7a88,0 0 0 1px var(--line);transition:box-shadow .5s}
.pf-feat:hover{box-shadow:0 40px 80px -40px #3f3d7a99,0 0 0 1px #6a67ae55}
.pf-feat.f0{grid-column:span 7}.pf-feat.f1{grid-column:span 5}.pf-feat.f2{grid-column:span 5}.pf-feat.f3{grid-column:span 7}
.pf-fimg{position:relative;aspect-ratio:16/10;border-radius:20px;overflow:hidden;background:#e7e3f1}.pf-fimg>*:first-child{position:absolute;inset:-9% 0;width:100%;height:118%}
.pf-img{object-fit:cover;object-position:top;display:block;transition:transform 1s cubic-bezier(.16,1,.3,1)}.pf-feat:hover .pf-img{transform:scale(1.05)}
.pf-chip{position:absolute;left:14px;top:14px;padding:7px 14px;border-radius:99px;background:#ffffffe6;backdrop-filter:blur(8px);font:600 11px/1 Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;z-index:2}
.pf-go{position:absolute;right:14px;top:14px;z-index:2;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--p);color:#fff;transform:scale(.6);opacity:0;transition:transform .5s cubic-bezier(.16,1,.3,1),opacity .3s}.pf-go svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2}
.pf-feat:hover .pf-go,.pf-card:hover .pf-go,.pf-card:focus-visible .pf-go{transform:none;opacity:1}
.pf-ft{padding:4px 12px 0}.pf-ft small{font:600 11px/1 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--p)}.pf-ft h3{font-size:clamp(22px,2.2vw,32px);margin:10px 0 8px}.pf-ft p{color:var(--grey);max-width:46ch}
.pf-link{display:inline-flex;align-items:center;gap:8px;margin-top:16px;font:600 14px 'Inter Tight',sans-serif;color:var(--p)}.pf-link svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;transition:transform .4s}.pf-feat:hover .pf-link svg{transform:translate(4px,-4px)}
/* covers (shown when a project has no screenshot yet) */
.pf-cover{position:relative;width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;gap:4px;padding:clamp(14px,1.6vw,22px);color:#fff;overflow:hidden;background:linear-gradient(135deg,var(--c1),var(--c2))}
.pf-cover::before{content:"";position:absolute;inset:0;background-image:linear-gradient(#ffffff14 1px,transparent 1px),linear-gradient(90deg,#ffffff14 1px,transparent 1px);background-size:34px 34px}
.pf-cover b{position:absolute;right:-2%;top:2%;font:800 clamp(90px,11vw,170px)/.8 'Inter Tight',sans-serif;letter-spacing:-.08em;color:#ffffff22}.pf-cover span{position:relative;font:700 clamp(18px,1.8vw,26px)/1.1 'Inter Tight',sans-serif;letter-spacing:-.03em}.pf-cover i{position:relative;font:500 11px/1 Inter,sans-serif;font-style:normal;letter-spacing:.1em;text-transform:uppercase;opacity:.8}
.c-web{--c1:#6a67ae;--c2:#3f3d7a}.c-app{--c1:#4f72bd;--c2:#27407d}.c-graphics{--c1:#8d65b8;--c2:#4d3277}.c-seo{--c1:#4f87a3;--c2:#254c63}.c-dm{--c1:#7d62a6;--c2:#3b2d5c}
/* filters */
.pf-filters{position:relative;display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.pf-ind{position:absolute;left:0;top:0;border-radius:99px;background:var(--p);z-index:0;pointer-events:none;box-shadow:0 12px 24px -12px #6a67aeaa}
.pf-filters button{position:relative;z-index:1;border:0;background:#fff;box-shadow:inset 0 0 0 1px var(--line);border-radius:99px;padding:11px 20px;cursor:pointer;font:600 14px 'Inter Tight',Inter,sans-serif;color:var(--ink);transition:color .35s,background .3s}
.pf-filters button.on{color:#fff;background:transparent;box-shadow:none}.pf-filters sup{margin-left:6px;font-size:10px;opacity:.6}.pf-filters button:not(.on):hover{box-shadow:inset 0 0 0 1px var(--p);color:var(--p)}
.pf-filters button:focus-visible,.pf-card:focus-visible,.pf-btn:focus-visible{outline:2px solid var(--p);outline-offset:3px}
.pf-count{font-size:13px;color:var(--grey);margin-bottom:22px}
/* directory grid: mixed sizes */
.pf-grid{--u:clamp(70px,6.6vw,100px);display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:var(--u);grid-auto-flow:dense;gap:clamp(12px,1.4vw,20px)}
.pf-card{position:relative;grid-row:span 3;border-radius:22px;overflow:hidden;background:#e7e3f1;box-shadow:0 0 0 1px var(--line);cursor:pointer;isolation:isolate;transition:box-shadow .5s,transform .5s cubic-bezier(.16,1,.3,1)}
.pf-card.wide{grid-column:span 2}.pf-card.tall{grid-row:span 5}
.pf-card:hover{box-shadow:0 30px 60px -36px #3f3d7acc,0 0 0 1px #6a67ae66}
.pf-card .pf-img,.pf-card .pf-cover{position:absolute;inset:0;width:100%;height:100%;transition:transform 1s cubic-bezier(.16,1,.3,1)}.pf-card:hover .pf-img,.pf-card:hover .pf-cover{transform:scale(1.06)}
.pf-ov{position:absolute;inset:auto 0 0 0;z-index:2;padding:46px 18px 16px;background:linear-gradient(transparent,#0e0e1ccc);color:#fff;display:grid;gap:2px;transform:translateY(calc(100% - 82px));transition:transform .55s cubic-bezier(.16,1,.3,1)}
.pf-ov small{font:600 10.5px/1 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--pl)}.pf-ov h3{font-size:17px;letter-spacing:-.02em;margin-top:4px}.pf-ov p{font-size:13px;color:#ffffffcc;max-height:0;opacity:0;transition:opacity .4s .05s,max-height .5s;overflow:hidden}
.pf-card:hover .pf-ov,.pf-card:focus-visible .pf-ov{transform:none}.pf-card:hover .pf-ov p,.pf-card:focus-visible .pf-ov p{max-height:60px;opacity:1;margin-top:6px}
.pf-card .pf-cover span,.pf-card .pf-cover i{opacity:0}.pf-card .pf-cover{justify-content:flex-start}
.pf-more{display:flex;justify-content:center;margin-top:36px}
.pf-btn{display:inline-flex;align-items:center;gap:12px;height:52px;padding:0 26px;border:0;border-radius:99px;background:var(--p);color:#fff;font:600 15px 'Inter Tight',Inter,sans-serif;cursor:pointer;transition:background .3s}.pf-btn:hover{background:var(--p2)}.pf-btn span{font-weight:500;opacity:.7;font-size:13px}.pf-btn svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2}
.pf-btn--ghost{background:transparent;box-shadow:inset 0 0 0 1px #ffffff40}.pf-btn--ghost:hover{background:#ffffff14}
/* cta */
.pf-cta-sec{background:#0e0e1c;color:#f4f0e8;padding:clamp(72px,9vw,130px) 0;position:relative;overflow:hidden}.pf-cta-sec::before{content:"";position:absolute;right:-10%;top:-30%;width:60vw;height:60vw;border-radius:50%;background:radial-gradient(circle,#6a67ae44,transparent 65%)}
.pf-cta{position:relative;display:grid;gap:14px;justify-items:start}.pf-cta h2{font-size:clamp(34px,5.4vw,78px);line-height:1}.pf-cta p:not(.pf-eye){color:#b4b2c4;max-width:48ch}.pf-cta .pf-eye{color:var(--pl)}.pf-cta-b{display:flex;flex-wrap:wrap;gap:12px;margin-top:14px}
/* responsive */
@media(max-width:1100px){.pf-grid{grid-template-columns:repeat(3,1fr)}.pf-feat.f0,.pf-feat.f3{grid-column:span 7}.pf-feat.f1,.pf-feat.f2{grid-column:span 5}}
@media(max-width:860px){.pf-fgrid{grid-template-columns:1fr}.pf-feat.f0,.pf-feat.f1,.pf-feat.f2,.pf-feat.f3{grid-column:auto}.pf-grid{grid-template-columns:repeat(2,1fr);--u:clamp(64px,13vw,100px)}}
@media(max-width:560px){.pf-grid{grid-template-columns:1fr;--u:62px}.pf-card.wide{grid-column:auto}.pf-card.tall{grid-row:span 4}.pf-filters{flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px;scrollbar-width:none}.pf-filters button{flex:none}.pf-shape.s1{display:none}}
@media(hover:none){.pf-ov{transform:none}.pf-ov p{max-height:60px;opacity:1;margin-top:6px}.pf-go{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){.pf *{animation:none!important;transition-duration:.01ms!important}}
/* pf-fx1 */
.pf-h1 em{font-family:var(--pf-serif),'Inter Tight',Georgia,serif;font-style:italic;font-weight:400;font-size:1.06em;letter-spacing:-.02em}
.pf-card .pf-img{object-position:center}
.pf-bgblur{display:none;position:absolute;inset:0;background-size:cover;background-position:center;filter:blur(26px) saturate(1.25);transform:scale(1.15)}
.pf-card.wide .pf-bgblur,.pf-card.tall .pf-bgblur{display:block}
.pf-card.wide .pf-img,.pf-card.tall .pf-img{object-fit:contain}
.pf-ov h3{position:relative;width:fit-content}
.pf-ov h3::after{content:"";position:absolute;left:0;bottom:-3px;height:1px;width:100%;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform .6s cubic-bezier(.16,1,.3,1) .1s}
.pf-card:hover .pf-ov h3::after,.pf-card:focus-visible .pf-ov h3::after{transform:scaleX(1)}
.pf-ov small,.pf-ov h3{transition:transform .6s cubic-bezier(.16,1,.3,1)}
.pf-card:hover .pf-ov small{transform:translateY(-2px)}
.pf-card:hover .pf-ov h3{transform:translateX(3px)}
.pf-count b{display:inline-block;font-weight:600;color:var(--ink)}