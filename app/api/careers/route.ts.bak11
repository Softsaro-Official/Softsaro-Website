import { NextResponse } from "next/server";

export const runtime = "nodejs";
const MAX = 5 * 1024 * 1024;
const EXT = ["pdf", "doc", "docx"];

const fail = (error: string, status: number) => NextResponse.json({ ok: false, error }, { status });

function validMagic(ext: string, b: Uint8Array) {
  if (ext === "pdf") return b[0] === 0x25 && b[1] === 0x50 && b[2] === 0x44 && b[3] === 0x46;
  if (ext === "docx") return b[0] === 0x50 && b[1] === 0x4b;
  return b[0] === 0xd0 && b[1] === 0xcf && b[2] === 0x11 && b[3] === 0xe0;
}
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));

export async function POST(req: Request) {
  let fd: FormData;
  try { fd = await req.formData(); } catch { return fail("Invalid form data.", 400); }
  if (String(fd.get("company") || "")) return NextResponse.json({ ok: true }); // honeypot

  const g = (k: string) => String(fd.get(k) || "").trim();
  const name = g("name"), email = g("email"), phone = g("phone"), role = g("role"), intro = g("intro");
  const linkedin = g("linkedin"), portfolio = g("portfolio");
  if (name.length < 2 || !/^\S+@\S+\.\S+$/.test(email) || !phone || !role || intro.length < 20) return fail("Please complete all required fields.", 400);

  const cv = fd.get("cv");
  if (!(cv instanceof File) || cv.size === 0) return fail("Please attach your CV.", 400);
  const ext = (cv.name.split(".").pop() || "").toLowerCase();
  if (!EXT.includes(ext)) return fail("CV must be a PDF, DOC or DOCX file.", 400);
  if (cv.size > MAX) return fail("CV must be 5 MB or smaller.", 400);
  const buf = new Uint8Array(await cv.arrayBuffer());
  if (!validMagic(ext, buf)) return fail("That file does not look like a valid CV document.", 400);

  const key = process.env.RESEND_API_KEY;
  if (!key) return fail("Online applications are not configured yet.", 503);

  const html = `<h2>New job application</h2><p><b>Role:</b> ${esc(role)}</p><p><b>Name:</b> ${esc(name)}<br><b>Email:</b> ${esc(email)}<br><b>Phone:</b> ${esc(phone)}<br><b>LinkedIn:</b> ${esc(linkedin || "-")}<br><b>Portfolio:</b> ${esc(portfolio || "-")}</p><p>${esc(intro).replace(/\n/g, "<br>")}</p>`;
  try {
    const r = await fetch("https://api.resend.com/emails", {
      method: "POST",
      headers: { Authorization: `Bearer ${key}`, "Content-Type": "application/json" },
      body: JSON.stringify({
        from: process.env.CAREERS_FROM || "Softsaro Careers <onboarding@resend.dev>",
        to: [process.env.CAREERS_TO || "info@softsaro.com"],
        reply_to: email,
        subject: `Job application: ${role} - ${name}`,
        html,
        attachments: [{ filename: cv.name.replace(/[^\w.\- ]/g, "_"), content: Buffer.from(buf).toString("base64") }],
      }),
    });
    if (!r.ok) return fail("The email service rejected the request.", 502);
  } catch {
    return fail("Could not reach the email service.", 502);
  }
  return NextResponse.json({ ok: true });
}